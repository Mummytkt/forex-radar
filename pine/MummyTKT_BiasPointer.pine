//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// MummyTKT's Bias Pointer v6 — TradingView Edition
//
// Apply to a 4H chart for each instrument.
// Create ONE alert per instrument: condition = "Any alert() function call"
//                                   webhook  = https://forex-radar.fly.dev/api/tv-webhook
//
// Event types:
//   BREAKOUT         — Daily candle closed beyond an external, internal or inner
//                      internal high/low (level_type says which)
//   RETEST           — H4 entered a reaction source zone
//   RETEST_CANCELLED — H4 moved away from zone without H4 confirmation
//   CONFIRMED        — H4 closed beyond an H4 A/V level during a daily retest (Origin)
//   INVALIDATED      — no longer sent: a break the other way is a new BREAKOUT
//   H4_CONTINUATION  — H4 continuation event after Origin has fired
//                      cont_type: breakout_cont | breaker_origin | breaker_cont | oc_cont
//   PRICE_UPDATE     — Current H4 close price, powers dashboard price-level alerts
//
// v5 change: added PRICE_UPDATE event — fires at every realtime H4 close.
// 2026-10-16: every completed post-breakout daily OC is watched (not just the
//             latest) until an opposing breakout; a daily-zone reaction stays
//             valid on later candles — any later H4 close beyond the H4 A/V
//             confirms it — and only fails on an H4 close back through the zone.
//            Backend uses it to check subscriber price-level alerts.
// 2026-10-16 (b): daily candles read with lookahead_on (history no longer a day
//             late after a paste); pip sizes match the server's table; every
//             webhook carries "timeframe"; PRICE_UPDATE carries a chart snapshot
//             (stage + all levels); "moved away first" can't be inherited from
//             the previous breakout; External/Internal is judged against the
//             CURRENT reaction's start (also after a failed reaction restarts).
// 2026-10-18: daily bias comes from market structure — external, internal and
//             inner internal highs/lows (wick levels, body-close breaks, no
//             tolerance). The most recent break on any layer is the breakout;
//             its level is the breaker and the rest of that range is the
//             inside-range zone. D.A/D.V are wick levels and only the one in line
//             with the bias is shown (D.V for buys, D.A for sells).
// ─────────────────────────────────────────────────────────────────────────────

indicator("MummyTKT Bias Pointer", overlay=true, max_bars_back=2000, max_lines_count=100, max_labels_count=100)

// ── Inputs ────────────────────────────────────────────────────────────────────
string wh_secret       = input.string("", "Webhook Secret",
     tooltip="Paste your TV_WEBHOOK_SECRET value here")
int    tol_pips        = input.int(5, "Tolerance Pips", minval=1, maxval=20,
     tooltip="Half-width of the reaction zone band in pips")
bool   show_daily_lbls = input.bool(true,  "Show Daily labels (D.A / D.V / D.OC)",
     tooltip="Toggle right-edge labels for Daily A-shape, V-shape and OC levels",
     group="Labels")
bool   show_h4_lbls    = input.bool(true,  "Show H4 labels (H4.A / H4.V / H4.OC / H4.BK)",
     tooltip="Toggle right-edge labels for H4 formation and breaker levels",
     group="Labels")
bool   show_lvl_lines  = input.bool(false, "Show level lines (extend right)",
     tooltip="Draw a horizontal line from each level's origin extending to the right",
     group="Labels")
color  daily_line_col  = input.color(color.new(color.gray, 20), "Daily line color",
     tooltip="Color for D.A / D.V / D.OC lines",
     group="Labels")
color  h4_line_col     = input.color(color.new(color.gray, 40), "H4 line color",
     tooltip="Color for H4.A / H4.V / H4.OC / H4.BK lines",
     group="Labels")
string daily_lbl_max_tf = input.string("Daily", "Daily labels visible on",
     options=["Monthly", "Weekly", "Daily", "4H", "1H", "30m", "15m", "5m"],
     tooltip="Daily level labels appear on this timeframe and all lower timeframes. E.g. choose Weekly to also see them on the weekly chart.",
     group="Labels")
string h4_lbl_max_tf    = input.string("4H",    "H4 labels visible on",
     options=["Monthly", "Weekly", "Daily", "4H", "1H", "30m", "15m", "5m"],
     tooltip="H4 level labels appear on this timeframe and all lower timeframes. E.g. choose Daily to also see them on the daily chart.",
     group="Labels")
color  bull_lbl_col     = input.color(color.new(color.green, 60), "Bullish state label color",
     tooltip="Background color of the state label when direction is bullish (BREAKOUT / awaiting retest)",
     group="Labels")
color  bear_lbl_col     = input.color(color.new(color.red,   60), "Bearish state label color",
     tooltip="Background color of the state label when direction is bearish (BREAKOUT / awaiting retest)",
     group="Labels")

// ── Daily structure levels (external / internal / inner internal) ───────────
const string GS1 = "External levels"
const string GS2 = "Internal levels"
const string GS3 = "Inner internal levels"
bool   show_ext = input.bool(true, "Show external", group = GS1)
color  c_eh  = input.color(#E0E0E0, "External high", group = GS1, inline = "eh")
string s_eh  = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], group = GS1, inline = "eh")
color  c_el  = input.color(#E0E0E0, "External low ", group = GS1, inline = "el")
string s_el  = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], group = GS1, inline = "el")
int    w_ext = input.int(2, "Line width", minval = 1, maxval = 4, group = GS1)
bool   show_int = input.bool(true, "Show internal", group = GS2)
color  c_ih  = input.color(#9E9E9E, "Internal high", group = GS2, inline = "ih")
string s_ih  = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], group = GS2, inline = "ih")
color  c_il  = input.color(#9E9E9E, "Internal low ", group = GS2, inline = "il")
string s_il  = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], group = GS2, inline = "il")
int    w_int = input.int(1, "Line width", minval = 1, maxval = 4, group = GS2)
bool   show_inn = input.bool(true, "Show inner internal", group = GS3)
color  c_nh  = input.color(#FFB74D, "Inner internal high", group = GS3, inline = "nh")
string s_nh  = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], group = GS3, inline = "nh")
color  c_nl  = input.color(#FFB74D, "Inner internal low ", group = GS3, inline = "nl")
string s_nl  = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], group = GS3, inline = "nl")
int    w_inn = input.int(1, "Line width", minval = 1, maxval = 4, group = GS3)

f_style(string st) =>
    st == "Dashed" ? line.style_dashed : st == "Dotted" ? line.style_dotted : line.style_solid

// ── Timeframe visibility helpers ──────────────────────────────────────────────
f_tf_str(opt) =>
    switch opt
        "Monthly" => "M"
        "Weekly"  => "W"
        "Daily"   => "D"
        "4H"      => "240"
        "1H"      => "60"
        "30m"     => "30"
        "15m"     => "15"
        =>           "5"

bool show_daily_on_tf = timeframe.in_seconds() <= timeframe.in_seconds(f_tf_str(daily_lbl_max_tf))
bool show_h4_on_tf    = timeframe.in_seconds() <= timeframe.in_seconds(f_tf_str(h4_lbl_max_tf))

// Pip size per market — must match pip_size_for() in config.py on the server.
// mintick × 10 is only right for forex; indices/crypto/oil use the server's table.
f_pip(string t) =>
    switch t
        "XAUUSD"  => 0.10
        "XAGUSD"  => 0.01
        "BTCUSD"  => 10.0
        "ETHUSD"  => 1.0
        "SOLUSD"  => 0.05
        "BNBUSD"  => 0.10
        "XRPUSD"  => 0.0002
        "ADAUSD"  => 0.00005
        "DOGEUSD" => 0.00002
        "LTCUSD"  => 0.02
        "WTIUSD"  => 0.05
        "US30"    => 10.0
        "NAS100"  => 5.0
        "SPX500"  => 2.0
        "UK100"   => 3.0
        "GER40"   => 5.0
        "JPN225"  => 10.0
        => str.endswith(t, "JPY") ? 0.01 : 0.0001

float pip = f_pip(syminfo.ticker)
float tol = float(tol_pips) * pip

// Every webhook carries the chart timeframe so the server can ignore alerts that
// were accidentally created on a non-4H chart.
f_hdr(string t) =>
    '{"secret":"' + wh_secret + '","type":"' + t + '","timeframe":"' + timeframe.period + '","instrument":"' + syminfo.ticker
f_num(float x) =>
    na(x) ? "null" : str.tostring(x)

// ── Daily market structure (external / internal / inner internal) ─────────────
// Runs on DAILY candles through request.security, so it reads the same on the
// 4H chart as on the Daily chart. Levels are wick highs/lows; a break is a daily
// body CLOSE beyond a level (no tolerance). Each layer follows the same rules:
//   • first level: close above an A shape (after a later candle traded below the
//     A's bearish candle) → the lowest point since the A is the low; mirror for V
//   • while a side is "still forming" it follows price; it is fixed once price
//     closes beyond the A/V it pulled back from
//   • close beyond the fixed high/low → new pair in that direction;
//     close beyond the opposite level → direction flips
//   • internal lives inside the external range, inner internal inside the
//     internal range; a layer resets whenever the layer above it changes
// The most recent break on ANY layer is the daily breakout the H4 steps use.

f_lowest(int from_bar) =>
    float m = low
    int mb = bar_index
    int n = math.min(bar_index - from_bar, 1500)
    for i = 0 to n
        if low[i] < m
            m := low[i]
            mb := bar_index - i
    [m, mb]

f_highest(int from_bar) =>
    float m = high
    int mb = bar_index
    int n = math.min(bar_index - from_bar, 1500)
    for i = 0 to n
        if high[i] > m
            m := high[i]
            mb := bar_index - i
    [m, mb]

f_bt(int b) =>
    time[bar_index - b]

type Layer
    string dir = "none"
    float  hi = na
    int    hi_bar = na
    int    hi_t = na
    float  lo = na
    int    lo_bar = na
    int    lo_t = na
    bool   hi_fixed = false
    bool   lo_fixed = false
    float  pb_hi = na
    float  pb_lo = na

method set_hi(Layer s, float v, int b) =>
    s.hi := v
    s.hi_bar := b
    s.hi_t := f_bt(b)

method set_lo(Layer s, float v, int b) =>
    s.lo := v
    s.lo_bar := b
    s.lo_t := f_bt(b)

method reset(Layer s) =>
    s.dir := "none"
    s.hi := na
    s.lo := na
    s.hi_fixed := false
    s.lo_fixed := false
    s.pb_hi := na
    s.pb_lo := na

// One daily candle of structure logic inside [blo, bhi].
// Returns [changed, broken level]; changed = a break redefined this layer.
method step(Layer s, float blo, float bhi, float lA, int lAb, bool lAok, float lV, int lVb, bool lVok) =>
    bool  ev   = false
    float blvl = na
    if s.dir == "none"
        if not na(lA) and lAok and close > lA
            [m, mb] = f_lowest(lAb)
            if m > blo and m < bhi
                s.dir := "bull"
                s.set_lo(m, mb)
                s.set_hi(high, bar_index)
                s.hi_fixed := false
                s.pb_lo := lV
                ev := true
                blvl := lA
        else if not na(lV) and lVok and close < lV
            [m, mb] = f_highest(lVb)
            if m > blo and m < bhi
                s.dir := "bear"
                s.set_hi(m, mb)
                s.set_lo(low, bar_index)
                s.lo_fixed := false
                s.pb_hi := lA
                ev := true
                blvl := lV
    else if s.dir == "bull"
        if close < s.lo
            blvl := s.lo
            s.dir := "bear"
            s.set_lo(low, bar_index)
            s.lo_fixed := false
            s.pb_hi := lA
            ev := true
        else if s.hi_fixed and close > s.hi
            blvl := s.hi
            [m, mb] = f_lowest(s.hi_bar)
            s.set_lo(m, mb)
            s.set_hi(high, bar_index)
            s.hi_fixed := false
            s.pb_lo := lV
            ev := true
        else
            if not s.hi_fixed and high > s.hi
                s.set_hi(high, bar_index)
            if not s.hi_fixed and not na(s.pb_lo) and close < s.pb_lo
                s.hi_fixed := true
    else if s.dir == "bear"
        if close > s.hi
            blvl := s.hi
            s.dir := "bull"
            s.set_hi(high, bar_index)
            s.hi_fixed := false
            s.pb_lo := lV
            ev := true
        else if s.lo_fixed and close < s.lo
            blvl := s.lo
            [m, mb] = f_highest(s.lo_bar)
            s.set_hi(m, mb)
            s.set_lo(low, bar_index)
            s.lo_fixed := false
            s.pb_hi := lA
            ev := true
        else
            if not s.lo_fixed and low < s.lo
                s.set_lo(low, bar_index)
            if not s.lo_fixed and not na(s.pb_hi) and close > s.pb_hi
                s.lo_fixed := true
    [ev, blvl]

method on_new_A(Layer s, float a) =>
    if s.dir == "bear" and not s.lo_fixed and na(s.pb_hi)
        s.pb_hi := a

method on_new_V(Layer s, float v) =>
    if s.dir == "bull" and not s.hi_fixed and na(s.pb_lo)
        s.pb_lo := v

f_structure() =>
    // External layer
    var string e_dir = "none"
    var float  e_hi = na
    var int    e_hi_bar = na
    var int    e_hi_t = na
    var float  e_lo = na
    var int    e_lo_bar = na
    var int    e_lo_t = na
    var bool   e_hif = false
    var bool   e_lof = false
    var float  e_pbh = na
    var float  e_pbl = na
    var Layer  intl = Layer.new()
    var Layer  innr = Layer.new()
    // Latest unbroken A / V shapes (wick levels)
    var float  lastA = na
    var int    lastA_bar = na
    var float  lastA_bear_lo = na
    var bool   lastA_ok = false
    var float  lastV = na
    var int    lastV_bar = na
    var float  lastV_bull_hi = na
    var bool   lastV_ok = false
    // D.A / D.V shown on the chart (latest A / V shape, wick)
    var float  da = na
    var int    da_t = na
    var float  dv = na
    var int    dv_t = na
    // Most recent break on any layer
    var int    b_cnt = 0
    var string b_dir = "none"
    var float  b_lvl = na
    var string b_layer = "none"
    var float  b_opp = na

    bool  ext_ev = false
    float e_blvl = na

    // 1. External
    if e_dir == "none"
        if not na(lastA) and close > lastA
            e_blvl := lastA
            [m, mb] = f_lowest(lastA_bar)
            e_lo := m, e_lo_bar := mb, e_lo_t := f_bt(mb)
            e_hi := high, e_hi_bar := bar_index, e_hi_t := time
            e_dir := "bull", e_hif := false
            ext_ev := true
        else if not na(lastV) and close < lastV
            e_blvl := lastV
            [m, mb] = f_highest(lastV_bar)
            e_hi := m, e_hi_bar := mb, e_hi_t := f_bt(mb)
            e_lo := low, e_lo_bar := bar_index, e_lo_t := time
            e_dir := "bear", e_lof := false
            ext_ev := true
    else if e_dir == "bull"
        if close < e_lo
            e_blvl := e_lo
            e_dir := "bear"
            e_lo := low, e_lo_bar := bar_index, e_lo_t := time
            e_lof := false
            ext_ev := true
        else if e_hif and close > e_hi
            e_blvl := e_hi
            [m, mb] = f_lowest(e_hi_bar)
            e_lo := m, e_lo_bar := mb, e_lo_t := f_bt(mb)
            e_hi := high, e_hi_bar := bar_index, e_hi_t := time
            e_hif := false
            ext_ev := true
        else
            if not e_hif and high > e_hi
                e_hi := high, e_hi_bar := bar_index, e_hi_t := time
            if not e_hif and not na(e_pbl) and close < e_pbl
                e_hif := true
    else if e_dir == "bear"
        if close > e_hi
            e_blvl := e_hi
            e_dir := "bull"
            e_hi := high, e_hi_bar := bar_index, e_hi_t := time
            e_hif := false
            ext_ev := true
        else if e_lof and close < e_lo
            e_blvl := e_lo
            [m, mb] = f_highest(e_lo_bar)
            e_hi := m, e_hi_bar := mb, e_hi_t := f_bt(mb)
            e_lo := low, e_lo_bar := bar_index, e_lo_t := time
            e_lof := false
            ext_ev := true
        else
            if not e_lof and low < e_lo
                e_lo := low, e_lo_bar := bar_index, e_lo_t := time
            if not e_lof and not na(e_pbh) and close > e_pbh
                e_lof := true

    if ext_ev
        e_pbh := na, e_pbl := na
        intl.reset()
        innr.reset()
        b_cnt += 1
        b_dir := e_dir == "bull" ? "bullish" : "bearish"
        b_lvl := e_blvl
        b_layer := "external"
        b_opp := e_dir == "bull" ? e_lo : e_hi

    // 2. Internal, then inner internal
    if not na(lastA) and not lastA_ok and low < lastA_bear_lo
        lastA_ok := true
    if not na(lastV) and not lastV_ok and high > lastV_bull_hi
        lastV_ok := true

    if not ext_ev and e_dir != "none"
        [iev, ilvl] = intl.step(e_lo, e_hi, lastA, lastA_bar, lastA_ok, lastV, lastV_bar, lastV_ok)
        if iev
            innr.reset()
            b_cnt += 1
            b_dir := intl.dir == "bull" ? "bullish" : "bearish"
            b_lvl := ilvl
            b_layer := "internal"
            b_opp := intl.dir == "bull" ? intl.lo : intl.hi
        else if intl.dir != "none"
            [nev, nlvl] = innr.step(intl.lo, intl.hi, lastA, lastA_bar, lastA_ok, lastV, lastV_bar, lastV_ok)
            if nev
                b_cnt += 1
                b_dir := innr.dir == "bull" ? "bullish" : "bearish"
                b_lvl := nlvl
                b_layer := "inner_internal"
                b_opp := innr.dir == "bull" ? innr.lo : innr.hi

    // Clear broken shapes / external pullback triggers
    if not na(lastA) and close > lastA
        lastA := na
    if not na(lastV) and close < lastV
        lastV := na
    if not na(e_pbh) and close > e_pbh
        e_pbh := na
    if not na(e_pbl) and close < e_pbl
        e_pbl := na

    // 3. Register new A / V shapes
    bool isA = close[1] > open[1] and close < open
    bool isV = close[1] < open[1] and close > open
    if isA
        lastA := math.max(high, high[1])
        lastA_bar := high >= high[1] ? bar_index : bar_index - 1
        lastA_bear_lo := low
        lastA_ok := false
        da := lastA, da_t := f_bt(lastA_bar)
        if e_dir != "none"
            e_pbh := lastA
        intl.on_new_A(lastA)
        innr.on_new_A(lastA)
    if isV
        lastV := math.min(low, low[1])
        lastV_bar := low <= low[1] ? bar_index : bar_index - 1
        lastV_bull_hi := high
        lastV_ok := false
        dv := lastV, dv_t := f_bt(lastV_bar)
        if e_dir != "none"
            e_pbl := lastV
        intl.on_new_V(lastV)
        innr.on_new_V(lastV)

    // Copy layer fields into series so they can be read one candle back
    string i_dir = intl.dir
    float  i_hi  = intl.hi
    float  i_lo  = intl.lo
    bool   i_hif = intl.hi_fixed
    bool   i_lof = intl.lo_fixed
    int    i_hit = intl.hi_t
    int    i_lot = intl.lo_t
    string n_dir = innr.dir
    float  n_hi  = innr.hi
    float  n_lo  = innr.lo
    bool   n_hif = innr.hi_fixed
    bool   n_lof = innr.lo_fixed
    int    n_hit = innr.hi_t
    int    n_lot = innr.lo_t
    // [1] + lookahead_on = state after the last COMPLETED daily candle (no repaint)
    [e_dir[1], e_hi[1], e_lo[1], e_hif[1], e_lof[1], e_hi_t[1], e_lo_t[1],
     i_dir[1], i_hi[1], i_lo[1], i_hif[1], i_lof[1], i_hit[1], i_lot[1],
     n_dir[1], n_hi[1], n_lo[1], n_hif[1], n_lof[1], n_hit[1], n_lot[1],
     b_cnt[1], b_dir[1], b_lvl[1], b_layer[1], b_opp[1],
     da[1], da_t[1], dv[1], dv_t[1]]

[s_edir, s_ehi, s_elo, s_ehif, s_elof, s_ehit, s_elot,
 s_idir, s_ihi, s_ilo, s_ihif, s_ilof, s_ihit, s_ilot,
 s_ndir, s_nhi, s_nlo, s_nhif, s_nlof, s_nhit, s_nlot,
 s_bcnt, s_bdir, s_blvl, s_blayer, s_bopp,
 s_da, s_da_t, s_dv, s_dv_t] = request.security(syminfo.tickerid, "D", f_structure(), lookahead=barmerge.lookahead_on)

// ── Daily OHLC (for post-breakout OCs) ────────────────────────────────────────
// lookahead_on + [1] = the just-completed daily candle on every H4 bar of the
// next day, on history and live (non-repainting).
float d_open  = request.security(syminfo.tickerid, "D", open[1],  lookahead=barmerge.lookahead_on)
float d_close = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)

f_layer_name(string l) =>
    l == "external" ? "External" : l == "internal" ? "Internal" : l == "inner_internal" ? "Inner internal" : ""

// ── Persistent state ──────────────────────────────────────────────────────────
var string bo_dir     = na
var float  bo_level   = na
var string bo_layer   = na   // which level broke: external | internal | inner_internal
var float  bo_opp     = na   // other side of the range that was just broken
var int    last_bcnt  = 0
var bool   est_above  = false
var bool   est_below  = false
var bool   retest_on  = false
var string retest_src = na
var float  h4_a_lvl   = na
var float  h4_v_lvl   = na
var int    pb_consec  = 0
var float  pb_close1  = na
var float  pb_oc_lvl  = na   // most recent post-breakout OC (for the label)
var array<float> pb_ocs = array.new<float>()   // every completed post-breakout OC
var float  retest_lvl = na   // level of the zone price is currently reacting from
var int    retest_bar = na   // bar the current reaction started on (External vs Internal)
var bool   just_broke = false

// ── H4 continuation state ─────────────────────────────────────────────────────
var bool   h4_bo_fired           = false
var bool   h4_breaker_orig_fired = false
var float  h4_breaker_lvl        = na
var float  h4_invalid_lvl        = na
var bool   h4_aligned            = false
var int    h4c_consec            = 0
var float  h4c_oc_close1         = na
var float  h4c_oc_lvl            = na
var bool   h4c_oc_ready          = false

// Continuation dedup: each level fires at most once per "visit". It re-arms
// when a new level is set (level-change) OR when price leaves the zone, so a
// second identical alert cannot fire on the next H4 candle while price just
// sits at the level.
var bool   bk_armed              = true
var float  bk_armed_lvl          = na
var bool   oc_armed              = true
var float  oc_armed_lvl          = na

// ── Level origin bar tracking (for extend-right lines) ───────────────────────
var int    poc_origin = na
var int    h4a_origin = na
var int    h4v_origin = na
var int    bk_origin  = na
var int    h4c_origin = na

// ── Daily breakout: the most recent break on any structure layer ─────────────
bool new_daily = timeframe.change("D")
if new_daily
    just_broke := false

if not na(s_bcnt) and s_bcnt > 0 and s_bcnt != last_bcnt
    last_bcnt := s_bcnt
    bo_dir    := s_bdir
    bo_level  := s_blvl
    bo_layer  := s_blayer
    bo_opp    := s_bopp
    est_above := false
    est_below := false
    retest_on := false
    retest_src:= na
    h4_a_lvl  := na
    h4_v_lvl  := na
    pb_consec := 0
    pb_close1 := na
    pb_oc_lvl := na
    array.clear(pb_ocs)
    retest_lvl := na
    just_broke:= true
    h4_bo_fired           := false
    h4_breaker_orig_fired := false
    h4_breaker_lvl        := na
    h4_invalid_lvl        := na
    h4_aligned            := false
    h4c_consec            := 0
    h4c_oc_close1         := na
    h4c_oc_lvl            := na
    h4c_oc_ready          := false
    if barstate.isrealtime
        alert(f_hdr("BREAKOUT")
              + '","direction":"' + bo_dir + '","level_type":"' + bo_layer
              + '","level":' + str.tostring(bo_level)
              + ',"range_level":' + f_num(bo_opp) + '}',
              alert.freq_once_per_bar)

// ── Post-breakout OC tracking ─────────────────────────────────────────────────
if new_daily and not na(bo_dir) and not just_broke
    bool d_bull = d_close >= d_open
    bool d_bear = d_close <  d_open
    bool pb_match = false
    if bo_dir == "bullish"
        pb_match := d_bull and d_close > bo_level
    else
        pb_match := d_bear and d_close < bo_level
    if pb_match
        pb_consec := pb_consec + 1
        if pb_consec == 1
            pb_close1 := d_close
        else if pb_consec >= 2
            pb_oc_lvl  := pb_close1
            array.push(pb_ocs, pb_close1)
            if array.size(pb_ocs) > 30
                array.shift(pb_ocs)
            poc_origin := bar_index
            pb_close1  := d_close
    else
        pb_consec := 0

// D.A / D.V (wick levels): only the one in line with the last breakout is
// monitored — D.V in a bullish bias, D.A in a bearish bias.
float a_lvl = bo_dir == "bullish" ? na : s_da
float v_lvl = bo_dir == "bearish" ? na : s_dv

// ── H4 block ──────────────────────────────────────────────────────────────────
if barstate.isconfirmed and not na(bo_dir) and not na(bo_level)
    float band_hi = bo_level + tol
    float band_lo = bo_level - tol

    // ── H4 formation detection ────────────────────────────────────────────
    bool h4_bull1 = close[1] >= open[1]
    bool h4_bear1 = close[1] <  open[1]
    bool h4_bull0 = close    >= open
    bool h4_bear0 = close    <  open

    bool new_a = h4_bull1 and h4_bear0
    if new_a
        h4_a_lvl   := math.max(open[1], close[1])
        h4a_origin := bar_index

    bool new_v = h4_bear1 and h4_bull0
    if new_v
        h4_v_lvl   := math.min(open[1], close[1])
        h4v_origin := bar_index

    // ── Establishment tracking ────────────────────────────────────────────
    // Read BEFORE this bar updates it: "an EARLIER H4 bar closed beyond the band".
    // (est_above[1] leaked the previous breakout's flag onto the bar of a new
    // same-direction breakout, letting it count as a retest without moving away.)
    bool was_est = (bo_dir == "bullish") ? est_above : est_below
    if bo_dir == "bullish" and close > band_hi
        est_above := true
    if bo_dir == "bearish" and close < band_lo
        est_below := true

    // ── Zone 1: Post-Breakout OCs ─────────────────────────────────────────
    // Every completed post-breakout OC stays eligible until an opposing daily
    // breakout. Use the deepest one this H4 bar reacts from (lowest for a buy,
    // highest for a sell) whose close hasn't gone through it.
    float pb_hit = na
    if array.size(pb_ocs) > 0
        for i = 0 to array.size(pb_ocs) - 1
            float oc = array.get(pb_ocs, i)
            bool beyond  = (bo_dir == "bullish" and oc > band_hi) or (bo_dir == "bearish" and oc < band_lo)
            bool touched = low <= oc + tol and high >= oc - tol
            bool held    = bo_dir == "bullish" ? close >= oc - tol : close <= oc + tol
            if beyond and touched and held
                if na(pb_hit) or (bo_dir == "bullish" ? oc < pb_hit : oc > pb_hit)
                    pb_hit := oc
    bool pb_oc_zone = not na(pb_hit)

    // ── Zone 2: Daily Breaker ─────────────────────────────────────────────
    bool db_zone = low <= band_hi and high >= band_lo and (bo_dir == "bullish" ? close >= band_lo : close <= band_hi)

    // ── Zone 3: Inside Range ──────────────────────────────────────────────
    bool ir_zone = false
    // Back inside the range that was just broken (between the breaker and the
    // other side of that range) without closing through the other side.
    if bo_dir == "bullish" and not na(bo_opp)
        ir_zone := close < band_lo and close > bo_opp + tol
    if bo_dir == "bearish" and not na(bo_opp)
        ir_zone := close > band_hi and close < bo_opp - tol

    // ── RETEST_CANCELLED — only when the reaction FAILS ───────────────────
    // A reaction stays valid on later candles: any later H4 close beyond the
    // H4 A/V level still confirms it. It fails only when an H4 candle closes
    // back through the zone on the wrong side; then the next zone price
    // reaches (checked just below, on this same bar) takes over.
    if retest_on
        bool failed = false
        if retest_src == "post_breakout_oc"
            failed := bo_dir == "bullish" ? close < retest_lvl - tol : close > retest_lvl + tol
        else if retest_src == "daily_breaker"
            failed := bo_dir == "bullish" ? close < band_lo : close > band_hi
        else if retest_src == "inside_range"
            failed := not na(bo_opp) and (bo_dir == "bullish" ? close < bo_opp - tol : close > bo_opp + tol)

        if failed
            retest_on  := false
            retest_src := na
            retest_lvl := na
            if barstate.isrealtime
                alert(f_hdr("RETEST_CANCELLED") + '"}',
                      alert.freq_once_per_bar)

    // ── RETEST detection ──────────────────────────────────────────────────
    if not retest_on and not h4_bo_fired
        if pb_oc_zone and was_est
            retest_on  := true
            retest_bar := bar_index
            retest_src := "post_breakout_oc"
            retest_lvl := pb_hit
            if barstate.isrealtime
                alert(f_hdr("RETEST")
                      + '","direction":"' + bo_dir + '","source":"post_breakout_oc"'
                      + ',"level_type":"' + bo_layer + '","breakout_level":' + str.tostring(bo_level)
                      + ',"source_level":' + str.tostring(pb_hit) + '}',
                      alert.freq_once_per_bar)
        else if db_zone and was_est
            retest_on  := true
            retest_bar := bar_index
            retest_src := "daily_breaker"
            retest_lvl := bo_level
            if barstate.isrealtime
                alert(f_hdr("RETEST")
                      + '","direction":"' + bo_dir + '","source":"daily_breaker"'
                      + ',"level_type":"' + bo_layer + '","breakout_level":' + str.tostring(bo_level)
                      + ',"source_level":' + str.tostring(bo_level) + '}',
                      alert.freq_once_per_bar)
        else if ir_zone and was_est
            retest_on  := true
            retest_bar := bar_index
            retest_src := "inside_range"
            retest_lvl := bo_level
            if barstate.isrealtime
                alert(f_hdr("RETEST")
                      + '","direction":"' + bo_dir + '","source":"inside_range"'
                      + ',"level_type":"' + bo_layer + '","breakout_level":' + str.tostring(bo_level)
                      + ',"source_level":' + str.tostring(bo_level) + '}',
                      alert.freq_once_per_bar)

    // ── H4 CONFIRMED ──────────────────────────────────────────────────────
    bool confirmed_this_bar = false

    if retest_on
        float src_lvl = na(retest_lvl) ? bo_level : retest_lvl

        if bo_dir == "bullish" and not na(h4_a_lvl) and not new_a and close > h4_a_lvl
            string h4_cls = h4a_origin <= retest_bar ? "external" : "internal"
            if not h4_bo_fired
                h4_bo_fired           := true
                h4_aligned            := true
                h4_breaker_lvl        := h4_a_lvl
                bk_origin             := bar_index
                h4_invalid_lvl        := h4_v_lvl
                h4c_consec            := 0
                h4c_oc_close1         := na
                h4c_oc_lvl            := na
                h4c_oc_ready          := false
                h4_breaker_orig_fired := false
                confirmed_this_bar    := true
                if barstate.isrealtime
                    alert(f_hdr("CONFIRMED")
                          + '","direction":"bullish","source":"' + retest_src
                          + '","h4_class":"' + h4_cls
                          + '","breakout_level":' + str.tostring(bo_level)
                          + ',"source_level":' + str.tostring(src_lvl)
                          + ',"h4_level":' + str.tostring(h4_a_lvl) + '}',
                          alert.freq_once_per_bar)
            else
                h4_aligned            := true
                h4_breaker_lvl        := h4_a_lvl
                bk_origin             := bar_index
                h4_invalid_lvl        := h4_v_lvl
                h4c_consec            := 0
                h4c_oc_close1         := na
                h4c_oc_lvl            := na
                h4c_oc_ready          := false
                confirmed_this_bar    := true
                if barstate.isrealtime
                    alert(f_hdr("H4_CONTINUATION")
                          + '","direction":"bullish","cont_type":"breakout_cont"'
                          + ',"level_type":"' + bo_layer + '","breakout_level":' + str.tostring(bo_level)
                          + ',"h4_level":' + str.tostring(h4_a_lvl) + '}',
                          alert.freq_once_per_bar)
            retest_on  := false
            retest_src := na
            retest_lvl := na

        if bo_dir == "bearish" and not na(h4_v_lvl) and not new_v and close < h4_v_lvl
            string h4_cls = h4v_origin <= retest_bar ? "external" : "internal"
            if not h4_bo_fired
                h4_bo_fired           := true
                h4_aligned            := true
                h4_breaker_lvl        := h4_v_lvl
                bk_origin             := bar_index
                h4_invalid_lvl        := h4_a_lvl
                h4c_consec            := 0
                h4c_oc_close1         := na
                h4c_oc_lvl            := na
                h4c_oc_ready          := false
                h4_breaker_orig_fired := false
                confirmed_this_bar    := true
                if barstate.isrealtime
                    alert(f_hdr("CONFIRMED")
                          + '","direction":"bearish","source":"' + retest_src
                          + '","h4_class":"' + h4_cls
                          + '","breakout_level":' + str.tostring(bo_level)
                          + ',"source_level":' + str.tostring(src_lvl)
                          + ',"h4_level":' + str.tostring(h4_v_lvl) + '}',
                          alert.freq_once_per_bar)
            else
                h4_aligned            := true
                h4_breaker_lvl        := h4_v_lvl
                bk_origin             := bar_index
                h4_invalid_lvl        := h4_a_lvl
                h4c_consec            := 0
                h4c_oc_close1         := na
                h4c_oc_lvl            := na
                h4c_oc_ready          := false
                confirmed_this_bar    := true
                if barstate.isrealtime
                    alert(f_hdr("H4_CONTINUATION")
                          + '","direction":"bearish","cont_type":"breakout_cont"'
                          + ',"level_type":"' + bo_layer + '","breakout_level":' + str.tostring(bo_level)
                          + ',"h4_level":' + str.tostring(h4_v_lvl) + '}',
                          alert.freq_once_per_bar)
            retest_on  := false
            retest_src := na
            retest_lvl := na

    // ── H4 Continuation block ─────────────────────────────────────────────
    if h4_bo_fired
        if h4_aligned and not na(h4_invalid_lvl)
            if bo_dir == "bullish" and close < h4_invalid_lvl - tol
                h4_aligned := false
                h4c_consec := 0
            if bo_dir == "bearish" and close > h4_invalid_lvl + tol
                h4_aligned := false
                h4c_consec := 0

        bool cont_acted = false
        if not h4_aligned and not retest_on
            if bo_dir == "bullish" and not na(h4_a_lvl) and not new_a and close > h4_a_lvl
                h4_aligned            := true
                h4_breaker_lvl        := h4_a_lvl
                bk_origin             := bar_index
                h4_invalid_lvl        := h4_v_lvl
                h4c_consec            := 0
                h4c_oc_close1         := na
                h4c_oc_lvl            := na
                h4c_oc_ready          := false
                cont_acted            := true
                if barstate.isrealtime
                    alert(f_hdr("H4_CONTINUATION")
                          + '","direction":"bullish","cont_type":"breakout_cont"'
                          + ',"level_type":"' + bo_layer + '","breakout_level":' + str.tostring(bo_level)
                          + ',"h4_level":' + str.tostring(h4_a_lvl) + '}',
                          alert.freq_once_per_bar)
            if bo_dir == "bearish" and not na(h4_v_lvl) and not new_v and close < h4_v_lvl
                h4_aligned            := true
                h4_breaker_lvl        := h4_v_lvl
                bk_origin             := bar_index
                h4_invalid_lvl        := h4_a_lvl
                h4c_consec            := 0
                h4c_oc_close1         := na
                h4c_oc_lvl            := na
                h4c_oc_ready          := false
                cont_acted            := true
                if barstate.isrealtime
                    alert(f_hdr("H4_CONTINUATION")
                          + '","direction":"bearish","cont_type":"breakout_cont"'
                          + ',"level_type":"' + bo_layer + '","breakout_level":' + str.tostring(bo_level)
                          + ',"h4_level":' + str.tostring(h4_v_lvl) + '}',
                          alert.freq_once_per_bar)

        if h4_aligned and not cont_acted and not confirmed_this_bar
            bool h4c_match = (bo_dir == "bullish") ? h4_bull0 : h4_bear0
            if h4c_match
                h4c_consec := h4c_consec + 1
                if h4c_consec == 1
                    h4c_oc_close1 := close
                else if h4c_consec >= 2
                    h4c_oc_lvl    := h4c_oc_close1
                    h4c_origin    := bar_index
                    h4c_oc_close1 := close
                    h4c_oc_ready  := true
            else
                h4c_consec := 0

            if not na(h4_breaker_lvl)
                // Re-arm when a NEW breaker level is established
                if na(bk_armed_lvl) or bk_armed_lvl != h4_breaker_lvl
                    bk_armed     := true
                    bk_armed_lvl := h4_breaker_lvl
                bool bk_touched = low <= h4_breaker_lvl + tol and high >= h4_breaker_lvl - tol
                // Re-arm when price is clear of the zone (so each fresh visit fires once)
                if not bk_touched
                    bk_armed := true
                bool bk_react = bk_armed and bk_touched and ((bo_dir == "bullish" and close > h4_breaker_lvl) or (bo_dir == "bearish" and close < h4_breaker_lvl))
                if bk_react
                    string bk_type = h4_breaker_orig_fired ? "breaker_cont" : "breaker_origin"
                    if not h4_breaker_orig_fired
                        h4_breaker_orig_fired := true
                    bk_armed := false
                    if barstate.isrealtime
                        alert(f_hdr("H4_CONTINUATION")
                              + '","direction":"' + bo_dir + '","cont_type":"' + bk_type + '"'
                              + ',"level_type":"' + bo_layer + '","breakout_level":' + str.tostring(bo_level)
                              + ',"h4_level":' + str.tostring(h4_breaker_lvl) + '}',
                              alert.freq_once_per_bar)

            // OC continuation: only fires on H4 bars AFTER the OC was established
            // (bar_index > h4c_origin). The formation bar itself always "closes
            // beyond" the OC level by construction — that's not a reaction,
            // it's just the second candle of the OC itself. We need price to
            // leave and return, then close beyond on a later H4 candle.
            if h4c_oc_ready and not na(h4c_oc_lvl) and bar_index > h4c_origin
                // Re-arm when a NEW OC level is established
                if na(oc_armed_lvl) or oc_armed_lvl != h4c_oc_lvl
                    oc_armed     := true
                    oc_armed_lvl := h4c_oc_lvl
                bool oc_touched = low <= h4c_oc_lvl + tol and high >= h4c_oc_lvl - tol
                // Re-arm when price is clear of the zone (so each fresh visit fires once)
                if not oc_touched
                    oc_armed := true
                bool oc_react = oc_armed and oc_touched and ((bo_dir == "bullish" and close > h4c_oc_lvl) or (bo_dir == "bearish" and close < h4c_oc_lvl))
                if oc_react
                    oc_armed := false
                    if barstate.isrealtime
                        alert(f_hdr("H4_CONTINUATION")
                              + '","direction":"' + bo_dir + '","cont_type":"oc_cont"'
                              + ',"level_type":"' + bo_layer + '","breakout_level":' + str.tostring(bo_level)
                              + ',"h4_level":' + str.tostring(h4c_oc_lvl) + '}',
                              alert.freq_once_per_bar)

// ── Visual overlays ───────────────────────────────────────────────────────────

// ── Right-edge level labels ────────────────────────────────────────────────────
var label _a_lbl   = na
var label _v_lbl   = na
var label _h4a_lbl = na
var label _h4v_lbl = na
var label _poc_lbl = na
var label _bk_lbl  = na
var label _h4c_lbl = na

var line _a_line   = na
var line _v_line   = na
var line _h4a_line = na
var line _h4v_line = na
var line _poc_line = na
var line _bk_line  = na
var line _h4c_line = na

label.delete(_a_lbl)
label.delete(_v_lbl)
label.delete(_h4a_lbl)
label.delete(_h4v_lbl)
label.delete(_poc_lbl)
label.delete(_bk_lbl)
label.delete(_h4c_lbl)

line.delete(_a_line)
line.delete(_v_line)
line.delete(_h4a_line)
line.delete(_h4v_line)
line.delete(_poc_line)
line.delete(_bk_line)
line.delete(_h4c_line)

if barstate.islast
    int lbl_x = bar_index + 20
    if show_daily_lbls and show_daily_on_tf
        if not na(a_lvl)
            _a_lbl   := label.new(lbl_x, a_lvl,     "D.A  " + str.tostring(a_lvl,     "#.#####"), style=label.style_label_left, color=color.new(color.red,    55), textcolor=color.white, size=size.small)
        if not na(v_lvl)
            _v_lbl   := label.new(lbl_x, v_lvl,     "D.V  " + str.tostring(v_lvl,     "#.#####"), style=label.style_label_left, color=color.new(color.lime,   45), textcolor=color.black, size=size.small)
        if not na(pb_oc_lvl)
            _poc_lbl := label.new(lbl_x, pb_oc_lvl, "D.OC " + str.tostring(pb_oc_lvl, "#.#####") + (array.size(pb_ocs) > 1 ? "  (" + str.tostring(array.size(pb_ocs)) + " watched)" : ""), style=label.style_label_left, color=color.new(color.purple, 45), textcolor=color.white, size=size.small)
    if show_h4_lbls and show_h4_on_tf
        if not na(h4_a_lvl)
            _h4a_lbl := label.new(lbl_x, h4_a_lvl,       "H4.A  " + str.tostring(h4_a_lvl,       "#.#####"), style=label.style_label_left, color=color.new(color.red,    72), textcolor=color.white, size=size.small)
        if not na(h4_v_lvl)
            _h4v_lbl := label.new(lbl_x, h4_v_lvl,       "H4.V  " + str.tostring(h4_v_lvl,       "#.#####"), style=label.style_label_left, color=color.new(color.lime,   65), textcolor=color.black, size=size.small)
        if not na(h4_breaker_lvl)
            _bk_lbl  := label.new(lbl_x, h4_breaker_lvl, "H4.BK " + str.tostring(h4_breaker_lvl, "#.#####"), style=label.style_label_left, color=color.new(color.orange, 25), textcolor=color.white, size=size.small)
        if not na(h4c_oc_lvl)
            _h4c_lbl := label.new(lbl_x, h4c_oc_lvl,     "H4.OC " + str.tostring(h4c_oc_lvl,     "#.#####"), style=label.style_label_left, color=color.new(color.teal,   45), textcolor=color.white, size=size.small)
    if show_lvl_lines
        if not na(a_lvl)          and not na(s_da_t)
            _a_line   := line.new(s_da_t,     a_lvl,          time,      a_lvl,          xloc=xloc.bar_time, extend=extend.right, color=daily_line_col, width=1)
        if not na(v_lvl)          and not na(s_dv_t)
            _v_line   := line.new(s_dv_t,     v_lvl,          time,      v_lvl,          xloc=xloc.bar_time, extend=extend.right, color=daily_line_col, width=1)
        if not na(pb_oc_lvl)      and not na(poc_origin)
            _poc_line := line.new(poc_origin, pb_oc_lvl,      bar_index, pb_oc_lvl,      extend=extend.right, color=daily_line_col, width=1)
        if not na(h4_a_lvl)       and not na(h4a_origin)
            _h4a_line := line.new(h4a_origin, h4_a_lvl,       bar_index, h4_a_lvl,       extend=extend.right, color=h4_line_col,    width=1)
        if not na(h4_v_lvl)       and not na(h4v_origin)
            _h4v_line := line.new(h4v_origin, h4_v_lvl,       bar_index, h4_v_lvl,       extend=extend.right, color=h4_line_col,    width=1)
        if not na(h4_breaker_lvl) and not na(bk_origin)
            _bk_line  := line.new(bk_origin,  h4_breaker_lvl, bar_index, h4_breaker_lvl, extend=extend.right, color=h4_line_col,    width=1)
        if not na(h4c_oc_lvl)     and not na(h4c_origin)
            _h4c_line := line.new(h4c_origin, h4c_oc_lvl,     bar_index, h4c_oc_lvl,     extend=extend.right, color=h4_line_col,    width=1)

// ── Daily structure levels on the chart ──────────────────────────────────────
var array<line>  _st_lines  = array.new<line>()
var array<label> _st_labels = array.new<label>()

f_draw_lvl(bool show, int t1, float y, string txt, color c, string st, int w) =>
    if show and not na(y) and not na(t1)
        int t2 = time + 5 * timeframe.in_seconds() * 1000
        array.push(_st_lines, line.new(t1, y, t2, y, xloc = xloc.bar_time, color = c, style = f_style(st), width = w))
        array.push(_st_labels, label.new(bar_index + 6, y, txt + "  " + str.tostring(y, format.mintick),
          style = label.style_label_left, color = color.new(color.black, 100), textcolor = c, size = size.small))

f_dirw(string d) =>
    d == "bull" ? "Bullish " : "Bearish "

if barstate.islast
    for ln in _st_lines
        line.delete(ln)
    for lb in _st_labels
        label.delete(lb)
    array.clear(_st_lines)
    array.clear(_st_labels)
    if show_daily_on_tf and s_edir != "none" and not na(s_edir)
        string forming = " (still forming)"
        f_draw_lvl(show_ext, s_ehit, s_ehi, f_dirw(s_edir) + "External high" + (s_edir == "bull" and not s_ehif ? forming : ""), c_eh, s_eh, w_ext)
        f_draw_lvl(show_ext, s_elot, s_elo, f_dirw(s_edir) + "External low" + (s_edir == "bear" and not s_elof ? forming : ""), c_el, s_el, w_ext)
        if s_idir != "none"
            f_draw_lvl(show_int, s_ihit, s_ihi, f_dirw(s_idir) + "Internal high" + (s_idir == "bull" and not s_ihif ? forming : ""), c_ih, s_ih, w_int)
            f_draw_lvl(show_int, s_ilot, s_ilo, f_dirw(s_idir) + "Internal low" + (s_idir == "bear" and not s_ilof ? forming : ""), c_il, s_il, w_int)
        if s_ndir != "none"
            f_draw_lvl(show_inn, s_nhit, s_nhi, f_dirw(s_ndir) + "Inner internal high" + (s_ndir == "bull" and not s_nhif ? forming : ""), c_nh, s_nh, w_inn)
            f_draw_lvl(show_inn, s_nlot, s_nlo, f_dirw(s_ndir) + "Inner internal low" + (s_ndir == "bear" and not s_nlof ? forming : ""), c_nl, s_nl, w_inn)

// ── Per-bar state markers ─────────────────────────────────────────────────────
plotchar(retest_on and barstate.isconfirmed,
     "Retest Active", "◆", location.abovebar, color.orange, size=size.tiny)
plotchar(h4_bo_fired and h4_aligned and barstate.isconfirmed,
     "H4 Aligned", "▲", location.belowbar, color.new(color.blue, 40), size=size.tiny)


// ── State label — shows script's current understanding at the latest bar ──────
string _state_txt = "IDLE - no breakout detected"
if not na(bo_dir) and not h4_bo_fired and retest_on
    _state_txt := (bo_dir == "bullish" ? "Bullish" : "Bearish") + " Retest | " + retest_src
else if not na(bo_dir) and not h4_bo_fired
    _state_txt := "BREAKOUT | " + bo_dir + " (" + f_layer_name(bo_layer) + ") | awaiting retest"
else if h4_bo_fired and h4_aligned
    _state_txt := "CONFIRMED | " + bo_dir + " | H4 aligned"
else if h4_bo_fired
    _state_txt := "CONFIRMED | " + bo_dir + " | realigning"
// Off the 4H chart, show only what the DAILY candles decided (direction and the
// broken level) — the H4 steps would run on the wrong candles there.
bool _is_4h = timeframe.period == "240"
if not _is_4h
    _state_txt := na(bo_dir) ? "DAILY | no breakout" : "DAILY | BREAKOUT | " + bo_dir + " (" + f_layer_name(bo_layer) + ") @ " + str.tostring(bo_level, "#.#####") + " | check 4H"

// ── Price feed + chart snapshot — fires at every realtime H4 close ───────────
// Powers dashboard price-level alerts and the server's copy of this chart's
// state and levels (so the dashboard matches the chart even for setups that
// formed before the script was pasted).
string _stage = na(bo_dir) ? "idle" : retest_on ? "retest" : not h4_bo_fired ? "breakout" : h4_aligned ? "confirmed_aligned" : "confirmed_realigning"
if barstate.isconfirmed and barstate.isrealtime
    alert(f_hdr("PRICE_UPDATE")
          + '","price":' + str.tostring(close)
          + ',"snapshot":{"stage":"' + _stage + '"'
          + ',"bias":' + (na(bo_dir) ? "null" : '"' + bo_dir + '"')
          + ',"retest_source":' + (na(retest_src) ? "null" : '"' + retest_src + '"')
          + ',"breakout_level":' + f_num(bo_level)
          + ',"level_type":' + (na(bo_layer) ? "null" : '"' + bo_layer + '"')
          + ',"ext_hi":' + f_num(s_ehi) + ',"ext_lo":' + f_num(s_elo)
          + ',"int_hi":' + f_num(s_idir == "none" ? na : s_ihi) + ',"int_lo":' + f_num(s_idir == "none" ? na : s_ilo)
          + ',"inn_hi":' + f_num(s_ndir == "none" ? na : s_nhi) + ',"inn_lo":' + f_num(s_ndir == "none" ? na : s_nlo)
          + ',"d_a":' + f_num(a_lvl) + ',"d_v":' + f_num(v_lvl)
          + ',"d_oc":' + f_num(pb_oc_lvl) + ',"d_oc_count":' + str.tostring(array.size(pb_ocs))
          + ',"h4_a":' + f_num(h4_a_lvl) + ',"h4_v":' + f_num(h4_v_lvl)
          + ',"h4_bk":' + f_num(h4_breaker_lvl) + ',"h4_oc":' + f_num(h4c_oc_lvl) + '}}',
          alert.freq_once_per_bar)


color _lbl_col = color.new(color.gray, 20)
if retest_on
    _lbl_col := color.orange
else if h4_bo_fired and h4_aligned
    _lbl_col := color.teal
else if h4_bo_fired
    _lbl_col := color.blue
else if bo_dir == "bullish"
    _lbl_col := bull_lbl_col
else if bo_dir == "bearish"
    _lbl_col := bear_lbl_col
if not _is_4h
    _lbl_col := na(bo_dir) ? color.new(color.gray, 20) : bo_dir == "bullish" ? bull_lbl_col : bear_lbl_col

var label _state_lbl = na
label.delete(_state_lbl)
string _tip = "bo=" + str.tostring(bo_level, "#.#####") + " (" + f_layer_name(bo_layer) + ") range=" + str.tostring(bo_opp, "#.#####") + " D.A=" + str.tostring(a_lvl, "#.#####") + " D.V=" + str.tostring(v_lvl, "#.#####") + " D.OC=" + str.tostring(pb_oc_lvl, "#.#####") + " H4.A=" + str.tostring(h4_a_lvl, "#.#####") + " H4.V=" + str.tostring(h4_v_lvl, "#.#####") + " H4.BK=" + str.tostring(h4_breaker_lvl, "#.#####") + " H4.OC=" + str.tostring(h4c_oc_lvl, "#.#####")
_state_lbl := label.new(bar_index, high, _state_txt, style=label.style_label_down, color=_lbl_col, textcolor=color.white, size=size.small, tooltip=_tip)
