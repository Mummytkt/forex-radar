//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// MummyTKT's Bias Pointer v6 — TradingView Edition
//
// Apply to a 4H chart for each instrument.
// Create ONE alert per instrument: condition = "Any alert() function call"
//                                   webhook  = https://forex-radar.fly.dev/api/tv-webhook
//
// Event types:
//   BREAKOUT         — Daily candle closed beyond most-recent A/V formation body
//   RETEST           — H4 entered a reaction source zone
//   RETEST_CANCELLED — H4 moved away from zone without H4 confirmation
//   CONFIRMED        — H4 closed beyond an H4 A/V level during a daily retest (Origin)
//   INVALIDATED      — Daily close moved beyond the OPPOSITE range boundary
//   H4_CONTINUATION  — H4 continuation event after Origin has fired
//                      cont_type: breakout_cont | breaker_origin | breaker_cont | oc_cont
//   PRICE_UPDATE     — Current H4 close price, powers dashboard price-level alerts
//
// v5 change: added PRICE_UPDATE event — fires at every realtime H4 close.
//            Backend uses it to check subscriber price-level alerts.
// ─────────────────────────────────────────────────────────────────────────────

indicator("MummyTKT Bias Pointer", overlay=true, max_bars_back=500)

// ── Inputs ────────────────────────────────────────────────────────────────────
string wh_secret = input.string("", "Webhook Secret",
     tooltip="Paste your TV_WEBHOOK_SECRET value here")
int    tol_pips  = input.int(5, "Tolerance Pips", minval=1, maxval=20,
     tooltip="Half-width of the reaction zone band in pips")

float pip = syminfo.mintick * 10.0
float tol = float(tol_pips) * pip

// ── Daily OHLCV ───────────────────────────────────────────────────────────────
var float d_time_prev = na
float d_time  = request.security(syminfo.tickerid, "D", time,    lookahead=barmerge.lookahead_off)
float d_open  = request.security(syminfo.tickerid, "D", open,    lookahead=barmerge.lookahead_off)
float d_close = request.security(syminfo.tickerid, "D", close,   lookahead=barmerge.lookahead_off)
float d_open1 = request.security(syminfo.tickerid, "D", open[1], lookahead=barmerge.lookahead_off)
float d_close1= request.security(syminfo.tickerid, "D", close[1],lookahead=barmerge.lookahead_off)

// ── Persistent state ──────────────────────────────────────────────────────────
var float  a_lvl      = na
var float  v_lvl      = na
var string bo_dir     = na
var float  bo_level   = na
var bool   est_above  = false
var bool   est_below  = false
var bool   retest_on  = false
var string retest_src = na
var float  h4_a_lvl   = na
var float  h4_v_lvl   = na
var bool   h4_a_pre   = false
var bool   h4_v_pre   = false
var int    pb_consec  = 0
var float  pb_close1  = na
var float  pb_oc_lvl  = na
var bool   just_broke = false

// ── H4 continuation state ─────────────────────────────────────────────────────
var bool   h4_bo_fired           = false
var bool   h4_breaker_orig_fired = false
var float  h4_breaker_lvl        = na
var float  h4_invalid_lvl        = na
var bool   h4_aligned            = false
var int    h4c_consec            = 0
var float  h4c_oc_close1         = na
var float  h4c_oc_lvl            = na
var bool   h4c_oc_ready          = false

// ── Daily block ───────────────────────────────────────────────────────────────
bool new_daily = not na(d_time) and d_time != d_time_prev
if new_daily
    d_time_prev := d_time
    just_broke  := false

    bool d_bull = d_close  >= d_open
    bool d_bear = d_close  <  d_open
    bool p_bull = d_close1 >= d_open1
    bool p_bear = d_close1 <  d_open1

    // ── Daily formation detection ─────────────────────────────────────────
    if p_bull and d_bear
        a_lvl := math.max(d_open1, d_close1)
    if p_bear and d_bull
        v_lvl := math.min(d_open1, d_close1)

    // ── INVALIDATED ───────────────────────────────────────────────────────
    if not na(bo_dir) and not na(bo_level)
        if bo_dir == "bullish" and not na(v_lvl) and d_close < v_lvl - tol
            bo_dir    := na
            bo_level  := na
            est_above := false
            est_below := false
            retest_on := false
            retest_src:= na
            h4_a_lvl  := na
            h4_v_lvl  := na
            pb_consec := 0
            pb_close1 := na
            pb_oc_lvl := na
            h4_bo_fired           := false
            h4_breaker_orig_fired := false
            h4_breaker_lvl        := na
            h4_invalid_lvl        := na
            h4_aligned            := false
            h4c_consec            := 0
            h4c_oc_close1         := na
            h4c_oc_lvl            := na
            h4c_oc_ready          := false
            if barstate.isrealtime
                alert('{"secret":"' + wh_secret + '","type":"INVALIDATED","instrument":"' + syminfo.ticker + '"}',
                      alert.freq_once_per_bar)

        if bo_dir == "bearish" and not na(a_lvl) and d_close > a_lvl + tol
            bo_dir    := na
            bo_level  := na
            est_above := false
            est_below := false
            retest_on := false
            retest_src:= na
            h4_a_lvl  := na
            h4_v_lvl  := na
            pb_consec := 0
            pb_close1 := na
            pb_oc_lvl := na
            h4_bo_fired           := false
            h4_breaker_orig_fired := false
            h4_breaker_lvl        := na
            h4_invalid_lvl        := na
            h4_aligned            := false
            h4c_consec            := 0
            h4c_oc_close1         := na
            h4c_oc_lvl            := na
            h4c_oc_ready          := false
            if barstate.isrealtime
                alert('{"secret":"' + wh_secret + '","type":"INVALIDATED","instrument":"' + syminfo.ticker + '"}',
                      alert.freq_once_per_bar)

    // ── Bullish breakout ──────────────────────────────────────────────────
    if not na(a_lvl) and d_close > a_lvl + tol
        bool is_new_bo = na(bo_dir) or bo_dir != "bullish" or math.abs(bo_level - a_lvl) > tol
        if is_new_bo
            bo_dir    := "bullish"
            bo_level  := a_lvl
            est_above := false
            est_below := false
            retest_on := false
            retest_src:= na
            h4_a_lvl  := na
            h4_v_lvl  := na
            pb_consec := 0
            pb_close1 := na
            pb_oc_lvl := na
            just_broke:= true
            h4_bo_fired           := false
            h4_breaker_orig_fired := false
            h4_breaker_lvl        := na
            h4_invalid_lvl        := na
            h4_aligned            := false
            h4c_consec            := 0
            h4c_oc_close1         := na
            h4c_oc_lvl            := na
            h4c_oc_ready          := false
            if barstate.isrealtime
                alert('{"secret":"' + wh_secret + '","type":"BREAKOUT","instrument":"' + syminfo.ticker
                      + '","direction":"bullish","level":' + str.tostring(bo_level) + '}',
                      alert.freq_once_per_bar)

    // ── Bearish breakout ──────────────────────────────────────────────────
    if not na(v_lvl) and d_close < v_lvl - tol
        bool is_new_bo = na(bo_dir) or bo_dir != "bearish" or math.abs(bo_level - v_lvl) > tol
        if is_new_bo
            bo_dir    := "bearish"
            bo_level  := v_lvl
            est_above := false
            est_below := false
            retest_on := false
            retest_src:= na
            h4_a_lvl  := na
            h4_v_lvl  := na
            pb_consec := 0
            pb_close1 := na
            pb_oc_lvl := na
            just_broke:= true
            h4_bo_fired           := false
            h4_breaker_orig_fired := false
            h4_breaker_lvl        := na
            h4_invalid_lvl        := na
            h4_aligned            := false
            h4c_consec            := 0
            h4c_oc_close1         := na
            h4c_oc_lvl            := na
            h4c_oc_ready          := false
            if barstate.isrealtime
                alert('{"secret":"' + wh_secret + '","type":"BREAKOUT","instrument":"' + syminfo.ticker
                      + '","direction":"bearish","level":' + str.tostring(bo_level) + '}',
                      alert.freq_once_per_bar)

    // ── Post-breakout OC tracking ─────────────────────────────────────────
    if not na(bo_dir) and not just_broke
        bool pb_match = false
        if bo_dir == "bullish"
            pb_match := d_bull and d_close > bo_level
        else
            pb_match := d_bear and d_close < bo_level
        if pb_match
            pb_consec := pb_consec + 1
            if pb_consec == 1
                pb_close1 := d_close
            else if pb_consec >= 2
                pb_oc_lvl := (pb_close1 + d_close) / 2.0
                pb_close1 := d_close
        else
            pb_consec := 0

// ── H4 block ──────────────────────────────────────────────────────────────────
if barstate.isconfirmed and not na(bo_dir) and not na(bo_level)
    float band_hi = bo_level + tol
    float band_lo = bo_level - tol

    // ── H4 formation detection ────────────────────────────────────────────
    bool h4_bull1 = close[1] >= open[1]
    bool h4_bear1 = close[1] <  open[1]
    bool h4_bull0 = close    >= open
    bool h4_bear0 = close    <  open

    bool new_a = h4_bull1 and h4_bear0
    if new_a
        h4_a_lvl := math.max(open[1], close[1])
        h4_a_pre := not retest_on

    bool new_v = h4_bear1 and h4_bull0
    if new_v
        h4_v_lvl := math.min(open[1], close[1])
        h4_v_pre := not retest_on

    // ── Establishment tracking ────────────────────────────────────────────
    if bo_dir == "bullish" and close > band_hi
        est_above := true
    if bo_dir == "bearish" and close < band_lo
        est_below := true

    bool was_est = (bo_dir == "bullish") ? est_above[1] : est_below[1]

    // ── Zone 1: Post-Breakout OC ──────────────────────────────────────────
    bool pb_oc_valid = not na(pb_oc_lvl) and ((bo_dir == "bullish" and pb_oc_lvl > band_hi) or (bo_dir == "bearish" and pb_oc_lvl < band_lo))
    bool pb_oc_zone  = pb_oc_valid and low <= pb_oc_lvl + tol and high >= pb_oc_lvl - tol

    // ── Zone 2: Daily Breaker ─────────────────────────────────────────────
    bool db_zone = low <= band_hi and high >= band_lo

    // ── Zone 3: Inside Range ──────────────────────────────────────────────
    bool ir_zone = false
    if bo_dir == "bullish" and not na(v_lvl)
        ir_zone := close < band_lo and close > v_lvl + tol
    if bo_dir == "bearish" and not na(a_lvl)
        ir_zone := close > band_hi and close < a_lvl - tol

    // ── RETEST detection ──────────────────────────────────────────────────
    if not retest_on and not h4_bo_fired
        if pb_oc_zone and was_est
            retest_on  := true
            retest_src := "post_breakout_oc"
            if barstate.isrealtime
                alert('{"secret":"' + wh_secret + '","type":"RETEST","instrument":"' + syminfo.ticker
                      + '","direction":"' + bo_dir + '","source":"post_breakout_oc"'
                      + ',"breakout_level":' + str.tostring(bo_level)
                      + ',"source_level":' + str.tostring(pb_oc_lvl) + '}',
                      alert.freq_once_per_bar)
        else if db_zone and was_est
            retest_on  := true
            retest_src := "daily_breaker"
            if barstate.isrealtime
                alert('{"secret":"' + wh_secret + '","type":"RETEST","instrument":"' + syminfo.ticker
                      + '","direction":"' + bo_dir + '","source":"daily_breaker"'
                      + ',"breakout_level":' + str.tostring(bo_level)
                      + ',"source_level":' + str.tostring(bo_level) + '}',
                      alert.freq_once_per_bar)
        else if ir_zone and was_est
            retest_on  := true
            retest_src := "inside_range"
            if barstate.isrealtime
                alert('{"secret":"' + wh_secret + '","type":"RETEST","instrument":"' + syminfo.ticker
                      + '","direction":"' + bo_dir + '","source":"inside_range"'
                      + ',"breakout_level":' + str.tostring(bo_level)
                      + ',"source_level":' + str.tostring(bo_level) + '}',
                      alert.freq_once_per_bar)

    // ── RETEST_CANCELLED ──────────────────────────────────────────────────
    if retest_on
        bool still_in_zone = false
        if retest_src == "post_breakout_oc"
            still_in_zone := pb_oc_zone
        else if retest_src == "daily_breaker"
            still_in_zone := db_zone
        else if retest_src == "inside_range"
            still_in_zone := ir_zone

        if not still_in_zone
            retest_on  := false
            retest_src := na
            if barstate.isrealtime
                alert('{"secret":"' + wh_secret + '","type":"RETEST_CANCELLED","instrument":"' + syminfo.ticker + '"}',
                      alert.freq_once_per_bar)

    // ── H4 CONFIRMED ──────────────────────────────────────────────────────
    bool confirmed_this_bar = false

    if retest_on
        float src_lvl = retest_src == "post_breakout_oc" ? pb_oc_lvl : bo_level

        if bo_dir == "bullish" and not na(h4_a_lvl) and not new_a and close > h4_a_lvl
            string h4_cls = h4_a_pre ? "external" : "internal"
            if not h4_bo_fired
                h4_bo_fired           := true
                h4_aligned            := true
                h4_breaker_lvl        := h4_a_lvl
                h4_invalid_lvl        := h4_v_lvl
                h4c_consec            := 0
                h4c_oc_close1         := na
                h4c_oc_lvl            := na
                h4c_oc_ready          := false
                h4_breaker_orig_fired := false
                confirmed_this_bar    := true
                if barstate.isrealtime
                    alert('{"secret":"' + wh_secret + '","type":"CONFIRMED","instrument":"' + syminfo.ticker
                          + '","direction":"bullish","source":"' + retest_src
                          + '","h4_class":"' + h4_cls
                          + '","breakout_level":' + str.tostring(bo_level)
                          + ',"source_level":' + str.tostring(src_lvl)
                          + ',"h4_level":' + str.tostring(h4_a_lvl) + '}',
                          alert.freq_once_per_bar)
            else
                h4_aligned            := true
                h4_breaker_lvl        := h4_a_lvl
                h4_invalid_lvl        := h4_v_lvl
                h4c_consec            := 0
                h4c_oc_close1         := na
                h4c_oc_lvl            := na
                h4c_oc_ready          := false
                confirmed_this_bar    := true
                if barstate.isrealtime
                    alert('{"secret":"' + wh_secret + '","type":"H4_CONTINUATION","instrument":"' + syminfo.ticker
                          + '","direction":"bullish","cont_type":"breakout_cont"'
                          + ',"breakout_level":' + str.tostring(bo_level)
                          + ',"h4_level":' + str.tostring(h4_a_lvl) + '}',
                          alert.freq_once_per_bar)
            retest_on  := false
            retest_src := na

        if bo_dir == "bearish" and not na(h4_v_lvl) and not new_v and close < h4_v_lvl
            string h4_cls = h4_v_pre ? "external" : "internal"
            if not h4_bo_fired
                h4_bo_fired           := true
                h4_aligned            := true
                h4_breaker_lvl        := h4_v_lvl
                h4_invalid_lvl        := h4_a_lvl
                h4c_consec            := 0
                h4c_oc_close1         := na
                h4c_oc_lvl            := na
                h4c_oc_ready          := false
                h4_breaker_orig_fired := false
                confirmed_this_bar    := true
                if barstate.isrealtime
                    alert('{"secret":"' + wh_secret + '","type":"CONFIRMED","instrument":"' + syminfo.ticker
                          + '","direction":"bearish","source":"' + retest_src
                          + '","h4_class":"' + h4_cls
                          + '","breakout_level":' + str.tostring(bo_level)
                          + ',"source_level":' + str.tostring(src_lvl)
                          + ',"h4_level":' + str.tostring(h4_v_lvl) + '}',
                          alert.freq_once_per_bar)
            else
                h4_aligned            := true
                h4_breaker_lvl        := h4_v_lvl
                h4_invalid_lvl        := h4_a_lvl
                h4c_consec            := 0
                h4c_oc_close1         := na
                h4c_oc_lvl            := na
                h4c_oc_ready          := false
                confirmed_this_bar    := true
                if barstate.isrealtime
                    alert('{"secret":"' + wh_secret + '","type":"H4_CONTINUATION","instrument":"' + syminfo.ticker
                          + '","direction":"bearish","cont_type":"breakout_cont"'
                          + ',"breakout_level":' + str.tostring(bo_level)
                          + ',"h4_level":' + str.tostring(h4_v_lvl) + '}',
                          alert.freq_once_per_bar)
            retest_on  := false
            retest_src := na

    // ── H4 Continuation block ─────────────────────────────────────────────
    if h4_bo_fired
        if h4_aligned and not na(h4_invalid_lvl)
            if bo_dir == "bullish" and close < h4_invalid_lvl - tol
                h4_aligned := false
                h4c_consec := 0
            if bo_dir == "bearish" and close > h4_invalid_lvl + tol
                h4_aligned := false
                h4c_consec := 0

        bool cont_acted = false
        if not h4_aligned and not retest_on
            if bo_dir == "bullish" and not na(h4_a_lvl) and not new_a and close > h4_a_lvl
                h4_aligned            := true
                h4_breaker_lvl        := h4_a_lvl
                h4_invalid_lvl        := h4_v_lvl
                h4c_consec            := 0
                h4c_oc_close1         := na
                h4c_oc_lvl            := na
                h4c_oc_ready          := false
                cont_acted            := true
                if barstate.isrealtime
                    alert('{"secret":"' + wh_secret + '","type":"H4_CONTINUATION","instrument":"' + syminfo.ticker
                          + '","direction":"bullish","cont_type":"breakout_cont"'
                          + ',"breakout_level":' + str.tostring(bo_level)
                          + ',"h4_level":' + str.tostring(h4_a_lvl) + '}',
                          alert.freq_once_per_bar)
            if bo_dir == "bearish" and not na(h4_v_lvl) and not new_v and close < h4_v_lvl
                h4_aligned            := true
                h4_breaker_lvl        := h4_v_lvl
                h4_invalid_lvl        := h4_a_lvl
                h4c_consec            := 0
                h4c_oc_close1         := na
                h4c_oc_lvl            := na
                h4c_oc_ready          := false
                cont_acted            := true
                if barstate.isrealtime
                    alert('{"secret":"' + wh_secret + '","type":"H4_CONTINUATION","instrument":"' + syminfo.ticker
                          + '","direction":"bearish","cont_type":"breakout_cont"'
                          + ',"breakout_level":' + str.tostring(bo_level)
                          + ',"h4_level":' + str.tostring(h4_v_lvl) + '}',
                          alert.freq_once_per_bar)

        if h4_aligned and not cont_acted and not confirmed_this_bar
            bool h4c_match = (bo_dir == "bullish") ? h4_bull0 : h4_bear0
            if h4c_match
                h4c_consec := h4c_consec + 1
                if h4c_consec == 1
                    h4c_oc_close1 := close
                else if h4c_consec >= 2
                    h4c_oc_lvl   := (h4c_oc_close1 + close) / 2.0
                    h4c_oc_close1 := close
                    h4c_oc_ready := true
            else
                h4c_consec := 0

            if not na(h4_breaker_lvl)
                bool bk_touched = low <= h4_breaker_lvl + tol and high >= h4_breaker_lvl - tol
                if bo_dir == "bullish" and bk_touched and close > h4_breaker_lvl
                    string bk_type = h4_breaker_orig_fired ? "breaker_cont" : "breaker_origin"
                    if not h4_breaker_orig_fired
                        h4_breaker_orig_fired := true
                    if barstate.isrealtime
                        alert('{"secret":"' + wh_secret + '","type":"H4_CONTINUATION","instrument":"' + syminfo.ticker
                              + '","direction":"bullish","cont_type":"' + bk_type + '"'
                              + ',"breakout_level":' + str.tostring(bo_level)
                              + ',"h4_level":' + str.tostring(h4_breaker_lvl) + '}',
                              alert.freq_once_per_bar)
                if bo_dir == "bearish" and bk_touched and close < h4_breaker_lvl
                    string bk_type = h4_breaker_orig_fired ? "breaker_cont" : "breaker_origin"
                    if not h4_breaker_orig_fired
                        h4_breaker_orig_fired := true
                    if barstate.isrealtime
                        alert('{"secret":"' + wh_secret + '","type":"H4_CONTINUATION","instrument":"' + syminfo.ticker
                              + '","direction":"bearish","cont_type":"' + bk_type + '"'
                              + ',"breakout_level":' + str.tostring(bo_level)
                              + ',"h4_level":' + str.tostring(h4_breaker_lvl) + '}',
                              alert.freq_once_per_bar)

            if h4c_oc_ready and not na(h4c_oc_lvl)
                bool oc_touched = low <= h4c_oc_lvl + tol and high >= h4c_oc_lvl - tol
                if bo_dir == "bullish" and oc_touched and close > h4c_oc_lvl
                    if barstate.isrealtime
                        alert('{"secret":"' + wh_secret + '","type":"H4_CONTINUATION","instrument":"' + syminfo.ticker
                              + '","direction":"bullish","cont_type":"oc_cont"'
                              + ',"breakout_level":' + str.tostring(bo_level)
                              + ',"h4_level":' + str.tostring(h4c_oc_lvl) + '}',
                              alert.freq_once_per_bar)
                if bo_dir == "bearish" and oc_touched and close < h4c_oc_lvl
                    if barstate.isrealtime
                        alert('{"secret":"' + wh_secret + '","type":"H4_CONTINUATION","instrument":"' + syminfo.ticker
                              + '","direction":"bearish","cont_type":"oc_cont"'
                              + ',"breakout_level":' + str.tostring(bo_level)
                              + ',"h4_level":' + str.tostring(h4c_oc_lvl) + '}',
                              alert.freq_once_per_bar)

// ── Price feed — powers dashboard price-level alerts ─────────────────────────
if barstate.isconfirmed and barstate.isrealtime
    alert('{"secret":"' + wh_secret + '","type":"PRICE_UPDATE","instrument":"' + syminfo.ticker
          + '","price":' + str.tostring(close) + '}', alert.freq_once_per_bar)

// ── Visual overlays ───────────────────────────────────────────────────────────

// ── Breakout zone band (solid, only when breakout is active) ──────────────────
float _hi  = not na(bo_dir) ? bo_level + tol : na
float _lo  = not na(bo_dir) ? bo_level - tol : na
float _mid = not na(bo_dir) ? bo_level       : na

color _line_col = na(bo_dir) ? na : bo_dir == "bullish" ? color.new(color.green, 0) : color.new(color.red, 0)
color _fill_col = na(bo_dir) ? na : bo_dir == "bullish" ? color.new(color.green, 85) : color.new(color.red, 85)

p_hi  = plot(_hi,  "Breakout Band Hi",  color=_line_col, linewidth=1, style=plot.style_line)
p_lo  = plot(_lo,  "Breakout Band Lo",  color=_line_col, linewidth=1, style=plot.style_line)
p_mid = plot(_mid, "Breakout Level",    color=_line_col, linewidth=2, style=plot.style_line)
fill(p_hi, p_lo, color=_fill_col, title="Breakout Zone")

// ── Formation tracking lines (always visible — verify what script detects) ────
p_a   = plot(a_lvl,          "Daily A-shape Level", color=color.new(color.red,    50), linewidth=1, style=plot.style_linebr)
p_v   = plot(v_lvl,          "Daily V-shape Level", color=color.new(color.lime,   50), linewidth=1, style=plot.style_linebr)
p_poc = plot(pb_oc_lvl,      "Post-BO OC Level",    color=color.new(color.purple, 40), linewidth=1, style=plot.style_linebr)
p_bk  = plot(h4_breaker_lvl, "H4 Breaker Level",    color=color.new(color.orange, 20), linewidth=1, style=plot.style_linebr)

// ── Per-bar state markers ─────────────────────────────────────────────────────
plotchar(retest_on and barstate.isconfirmed,
     "Retest Active", "◆", location.abovebar, color.orange, size=size.tiny)
plotchar(h4_bo_fired and h4_aligned and barstate.isconfirmed,
     "H4 Aligned", "▲", location.belowbar, color.new(color.blue, 40), size=size.tiny)

// ── State label — shows script's current understanding at the latest bar ──────
string _state_txt = "IDLE - no breakout detected"
if not na(bo_dir) and not h4_bo_fired and retest_on
    _state_txt := "RETEST | " + retest_src
else if not na(bo_dir) and not h4_bo_fired
    _state_txt := "BREAKOUT | " + bo_dir + " | awaiting retest"
else if h4_bo_fired and h4_aligned
    _state_txt := "CONFIRMED | " + bo_dir + " | H4 aligned"
else if h4_bo_fired
    _state_txt := "CONFIRMED | " + bo_dir + " | realigning"

color _lbl_col = color.new(color.gray, 20)
if retest_on
    _lbl_col := color.orange
else if h4_bo_fired and h4_aligned
    _lbl_col := color.teal
else if h4_bo_fired
    _lbl_col := color.blue
else if bo_dir == "bullish"
    _lbl_col := color.new(color.green, 10)
else if bo_dir == "bearish"
    _lbl_col := color.new(color.red, 10)

var label _state_lbl = na
label.delete(_state_lbl)
string _tip = "bo=" + str.tostring(bo_level, "#.#####") + " a=" + str.tostring(a_lvl, "#.#####") + " v=" + str.tostring(v_lvl, "#.#####") + " bk=" + str.tostring(h4_breaker_lvl, "#.#####")
_state_lbl := label.new(bar_index, high, _state_txt, style=label.style_label_down, color=_lbl_col, textcolor=color.white, size=size.small, tooltip=_tip)
