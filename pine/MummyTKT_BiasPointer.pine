//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// MummyTKT's Bias Pointer v2 — TradingView Edition
//
// Apply to a 4H chart for each instrument.
// Create ONE alert per instrument: condition = "Any alert() function call"
//                                   webhook  = https://forex-radar.fly.dev/api/tv-webhook
//
// Event types:
//   BREAKOUT         — Daily candle closed beyond most-recent A/V formation body
//   RETEST           — H4 entered a reaction source zone
//   RETEST_CANCELLED — H4 moved away from zone without H4 confirmation
//   CONFIRMED        — H4 closed beyond an H4 A/V level during a retest
//   INVALIDATED      — Daily close moved beyond the OPPOSITE range boundary
//                      (bullish setup: close below V-shape body_low
//                       bearish setup: close above A-shape body_high)
//
// Three reaction sources (detected in priority order):
//   post_breakout_oc — price retests an OC formed by 2 consecutive post-breakout
//                      same-direction daily candles (on the breakout side)
//   daily_breaker    — price wicks back into the broken A/V level band
//   inside_range     — H4 closes inside the old daily range (past the Daily Breaker)
//                      but has not yet reached the opposite boundary
// ─────────────────────────────────────────────────────────────────────────────

indicator("MummyTKT Bias Pointer", overlay=true, max_bars_back=500)

// ── Inputs ────────────────────────────────────────────────────────────────────
string wh_secret = input.string("", "Webhook Secret",
     tooltip="Paste your TV_WEBHOOK_SECRET value here")
int    tol_pips  = input.int(5, "Tolerance Pips", minval=1, maxval=20,
     tooltip="Half-width of the reaction zone band in pips")

float pip = syminfo.mintick * 10.0
float tol = float(tol_pips) * pip

// ── Daily OHLCV ───────────────────────────────────────────────────────────────
var float d_time_prev = na
float d_time  = request.security(syminfo.tickerid, "D", time,    lookahead=barmerge.lookahead_off)
float d_open  = request.security(syminfo.tickerid, "D", open,    lookahead=barmerge.lookahead_off)
float d_close = request.security(syminfo.tickerid, "D", close,   lookahead=barmerge.lookahead_off)
float d_open1 = request.security(syminfo.tickerid, "D", open[1], lookahead=barmerge.lookahead_off)
float d_close1= request.security(syminfo.tickerid, "D", close[1],lookahead=barmerge.lookahead_off)

// ── Persistent state ──────────────────────────────────────────────────────────
var float  a_lvl      = na      // most recent Daily A-shape body_high (resistance)
var float  v_lvl      = na      // most recent Daily V-shape body_low  (support)
var string bo_dir     = na      // "bullish" | "bearish" | na
var float  bo_level   = na      // formation level that was broken
var bool   est_above  = false   // H4 closed above band_hi at least once
var bool   est_below  = false   // H4 closed below band_lo at least once
var bool   retest_on  = false
var string retest_src = na      // "daily_breaker" | "inside_range" | "post_breakout_oc"
var float  h4_a_lvl   = na      // H4 A-shape body_high (tracked post-breakout)
var float  h4_v_lvl   = na      // H4 V-shape body_low  (tracked post-breakout)
var bool   h4_a_pre   = false   // A-shape formed before retest started → external
var bool   h4_v_pre   = false   // V-shape formed before retest started → external
var int    pb_consec  = 0       // consecutive post-breakout same-direction daily count
var float  pb_close1  = na      // first pb candle's close for OC midpoint
var float  pb_oc_lvl  = na      // computed post-breakout OC level
var bool   just_broke = false   // true only on the bar a new breakout fires (daily block)

// ── Daily block ───────────────────────────────────────────────────────────────
bool new_daily = not na(d_time) and d_time != d_time_prev
if new_daily
    d_time_prev := d_time
    just_broke  := false        // reset each daily session

    bool d_bull = d_close  >= d_open
    bool d_bear = d_close  <  d_open
    bool p_bull = d_close1 >= d_open1
    bool p_bear = d_close1 <  d_open1

    // ── Daily formation detection ─────────────────────────────────────────
    if p_bull and d_bear
        a_lvl := math.max(d_open1, d_close1)
    if p_bear and d_bull
        v_lvl := math.min(d_open1, d_close1)

    // ── INVALIDATED — opposite range boundary breach ──────────────────────
    // Breakout stays active while price is anywhere inside the daily range.
    // Only invalidates when daily close crosses the boundary on the OTHER side.
    //   Bullish setup: close below last V-shape body_low (v_lvl) - tol
    //   Bearish setup: close above last A-shape body_high (a_lvl) + tol
    if not na(bo_dir) and not na(bo_level)
        if bo_dir == "bullish" and not na(v_lvl) and d_close < v_lvl - tol
            bo_dir    := na
            bo_level  := na
            est_above := false
            est_below := false
            retest_on := false
            retest_src:= na
            h4_a_lvl  := na
            h4_v_lvl  := na
            pb_consec := 0
            pb_close1 := na
            pb_oc_lvl := na
            alert('{"secret":"' + wh_secret + '","type":"INVALIDATED","instrument":"' + syminfo.ticker + '"}',
                  alert.freq_once_per_bar)
        if bo_dir == "bearish" and not na(a_lvl) and d_close > a_lvl + tol
            bo_dir    := na
            bo_level  := na
            est_above := false
            est_below := false
            retest_on := false
            retest_src:= na
            h4_a_lvl  := na
            h4_v_lvl  := na
            pb_consec := 0
            pb_close1 := na
            pb_oc_lvl := na
            alert('{"secret":"' + wh_secret + '","type":"INVALIDATED","instrument":"' + syminfo.ticker + '"}',
                  alert.freq_once_per_bar)

    // ── Bullish breakout ──────────────────────────────────────────────────
    if not na(a_lvl) and d_close > a_lvl + tol
        bool is_new_bo = na(bo_dir) or bo_dir != "bullish" or math.abs(bo_level - a_lvl) > tol
        if is_new_bo
            bo_dir    := "bullish"
            bo_level  := a_lvl
            est_above := false
            est_below := false
            retest_on := false
            retest_src:= na
            h4_a_lvl  := na
            h4_v_lvl  := na
            pb_consec := 0
            pb_close1 := na
            pb_oc_lvl := na
            just_broke:= true
            alert('{"secret":"' + wh_secret + '","type":"BREAKOUT","instrument":"' + syminfo.ticker
                  + '","direction":"bullish","level":' + str.tostring(bo_level) + '}',
                  alert.freq_once_per_bar)

    // ── Bearish breakout ──────────────────────────────────────────────────
    if not na(v_lvl) and d_close < v_lvl - tol
        bool is_new_bo = na(bo_dir) or bo_dir != "bearish" or math.abs(bo_level - v_lvl) > tol
        if is_new_bo
            bo_dir    := "bearish"
            bo_level  := v_lvl
            est_above := false
            est_below := false
            retest_on := false
            retest_src:= na
            h4_a_lvl  := na
            h4_v_lvl  := na
            pb_consec := 0
            pb_close1 := na
            pb_oc_lvl := na
            just_broke:= true
            alert('{"secret":"' + wh_secret + '","type":"BREAKOUT","instrument":"' + syminfo.ticker
                  + '","direction":"bearish","level":' + str.tostring(bo_level) + '}',
                  alert.freq_once_per_bar)

    // ── Post-breakout OC tracking ─────────────────────────────────────────
    // Counts consecutive post-breakout same-direction daily candles that close
    // on the breakout side. The breakout candle itself is excluded (just_broke).
    // When two consecutive qualifying candles are found, pb_oc_lvl = their midpoint.
    if not na(bo_dir) and not just_broke
        bool pb_match = false
        if bo_dir == "bullish"
            pb_match := d_bull and d_close > bo_level
        else
            pb_match := d_bear and d_close < bo_level
        if pb_match
            pb_consec := pb_consec + 1
            if pb_consec == 1
                pb_close1 := d_close
            else if pb_consec >= 2
                pb_oc_lvl := (pb_close1 + d_close) / 2.0
                pb_close1 := d_close    // slide window for next potential OC
        else
            pb_consec := 0
            // Keep pb_oc_lvl — level stays valid even if daily streak breaks

// ── H4 block ──────────────────────────────────────────────────────────────────
if barstate.isconfirmed and not na(bo_dir) and not na(bo_level)
    float band_hi = bo_level + tol
    float band_lo = bo_level - tol

    // ── H4 formation detection ────────────────────────────────────────────
    bool h4_bull1 = close[1] >= open[1]
    bool h4_bear1 = close[1] <  open[1]
    bool h4_bull0 = close    >= open
    bool h4_bear0 = close    <  open

    bool new_a = h4_bull1 and h4_bear0
    if new_a
        h4_a_lvl := math.max(open[1], close[1])
        h4_a_pre := not retest_on

    bool new_v = h4_bear1 and h4_bull0
    if new_v
        h4_v_lvl := math.min(open[1], close[1])
        h4_v_pre := not retest_on

    // ── Establishment tracking ────────────────────────────────────────────
    // Requires at least one H4 close beyond the band before any retest is valid.
    if bo_dir == "bullish" and close > band_hi
        est_above := true
    if bo_dir == "bearish" and close < band_lo
        est_below := true

    // Use PREVIOUS bar's established flag: prevents same-bar establish + retest.
    bool was_est = (bo_dir == "bullish") ? est_above[1] : est_below[1]

    // ── Zone 1: Post-Breakout OC ──────────────────────────────────────────
    // OC must be clearly beyond the Daily Breaker band (on the breakout side).
    // Retest = wick touching the OC ± tol band.
    bool pb_oc_valid    = not na(pb_oc_lvl) and
                          ((bo_dir == "bullish" and pb_oc_lvl > band_hi) or
                           (bo_dir == "bearish" and pb_oc_lvl < band_lo))
    bool pb_oc_zone     = pb_oc_valid and low <= pb_oc_lvl + tol and high >= pb_oc_lvl - tol

    // ── Zone 2: Daily Breaker ─────────────────────────────────────────────
    // Wick touching the broken A/V level ± tol band.
    bool db_zone = low <= band_hi and high >= band_lo

    // ── Zone 3: Inside Range ──────────────────────────────────────────────
    // H4 CLOSE (not just wick) has moved inside the old daily range.
    // Bullish: close below band_lo but above v_lvl + tol
    // Bearish: close above band_hi but below a_lvl - tol
    bool ir_zone = false
    if bo_dir == "bullish" and not na(v_lvl)
        ir_zone := close < band_lo and close > v_lvl + tol
    if bo_dir == "bearish" and not na(a_lvl)
        ir_zone := close > band_hi and close < a_lvl - tol

    // ── RETEST detection (priority: pb_oc > daily_breaker > inside_range) ─
    if not retest_on
        if pb_oc_zone and was_est
            retest_on  := true
            retest_src := "post_breakout_oc"
            alert('{"secret":"' + wh_secret + '","type":"RETEST","instrument":"' + syminfo.ticker
                  + '","direction":"' + bo_dir + '","source":"post_breakout_oc"'
                  + ',"breakout_level":' + str.tostring(bo_level)
                  + ',"source_level":' + str.tostring(pb_oc_lvl) + '}',
                  alert.freq_once_per_bar)
        else if db_zone and was_est
            retest_on  := true
            retest_src := "daily_breaker"
            alert('{"secret":"' + wh_secret + '","type":"RETEST","instrument":"' + syminfo.ticker
                  + '","direction":"' + bo_dir + '","source":"daily_breaker"'
                  + ',"breakout_level":' + str.tostring(bo_level)
                  + ',"source_level":' + str.tostring(bo_level) + '}',
                  alert.freq_once_per_bar)
        else if ir_zone and was_est
            retest_on  := true
            retest_src := "inside_range"
            alert('{"secret":"' + wh_secret + '","type":"RETEST","instrument":"' + syminfo.ticker
                  + '","direction":"' + bo_dir + '","source":"inside_range"'
                  + ',"breakout_level":' + str.tostring(bo_level)
                  + ',"source_level":' + str.tostring(bo_level) + '}',
                  alert.freq_once_per_bar)

    // ── RETEST_CANCELLED ──────────────────────────────────────────────────
    if retest_on
        bool still_in_zone = false
        if retest_src == "post_breakout_oc"
            still_in_zone := pb_oc_zone
        else if retest_src == "daily_breaker"
            still_in_zone := db_zone
        else if retest_src == "inside_range"
            still_in_zone := ir_zone

        if not still_in_zone
            retest_on  := false
            retest_src := na
            alert('{"secret":"' + wh_secret + '","type":"RETEST_CANCELLED","instrument":"' + syminfo.ticker + '"}',
                  alert.freq_once_per_bar)

    // ── H4 CONFIRMED ──────────────────────────────────────────────────────
    // H4 candle must CLOSE (body) beyond the H4 A/V level — wicks do not count.
    // Guard `not new_a` / `not new_v` prevents confirmation on the same bar
    // the H4 formation is detected (must be a subsequent H4 bar).
    if retest_on
        float src_lvl = retest_src == "post_breakout_oc" ? pb_oc_lvl : bo_level

        if bo_dir == "bullish" and not na(h4_a_lvl) and not new_a and close > h4_a_lvl
            string h4_cls = h4_a_pre ? "external" : "internal"
            alert('{"secret":"' + wh_secret + '","type":"CONFIRMED","instrument":"' + syminfo.ticker
                  + '","direction":"bullish","source":"' + retest_src
                  + '","h4_class":"' + h4_cls
                  + '","breakout_level":' + str.tostring(bo_level)
                  + ',"source_level":' + str.tostring(src_lvl)
                  + ',"h4_level":' + str.tostring(h4_a_lvl) + '}',
                  alert.freq_once_per_bar)
            retest_on  := false
            retest_src := na

        if bo_dir == "bearish" and not na(h4_v_lvl) and not new_v and close < h4_v_lvl
            string h4_cls = h4_v_pre ? "external" : "internal"
            alert('{"secret":"' + wh_secret + '","type":"CONFIRMED","instrument":"' + syminfo.ticker
                  + '","direction":"bearish","source":"' + retest_src
                  + '","h4_class":"' + h4_cls
                  + '","breakout_level":' + str.tostring(bo_level)
                  + ',"source_level":' + str.tostring(src_lvl)
                  + ',"h4_level":' + str.tostring(h4_v_lvl) + '}',
                  alert.freq_once_per_bar)
            retest_on  := false
            retest_src := na

// ── Visual overlays ───────────────────────────────────────────────────────────
float _hi  = not na(bo_dir) ? bo_level + tol : na
float _lo  = not na(bo_dir) ? bo_level - tol : na
float _mid = bo_level

color _line_col = na(bo_dir) ? na : bo_dir == "bullish" ? color.new(color.green, 0) : color.new(color.red, 0)
color _fill_col = na(bo_dir) ? na : bo_dir == "bullish" ? color.new(color.green, 88) : color.new(color.red, 88)

p_hi  = plot(_hi,  "Band Hi",        color=_line_col, linewidth=1, style=plot.style_line)
p_lo  = plot(_lo,  "Band Lo",        color=_line_col, linewidth=1, style=plot.style_line)
p_mid = plot(_mid, "Breakout Level", color=_line_col, linewidth=2, style=plot.style_line)
fill(p_hi, p_lo, color=_fill_col, title="Reaction Zone")

plotchar(retest_on and barstate.isconfirmed, "Retest Active", "◆",
         location.abovebar, color.orange, size=size.tiny)
