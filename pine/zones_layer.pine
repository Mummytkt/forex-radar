
// ═════════════════════════════════════════════════════════════════════════════
// 9 · ZONES BACKTEST (user's method, 2026-11-10; pictures Documents/Zones_Picture_4.png and _6.png)
// Works on the H4 chart (it reads the M5 / M15 / H1 candles inside each H4 candle) or on a lower chart.
// Every Bias Pointer alert (any kind) clears the zones (buys after a bullish alert; bearish = the mirror):
//   · the POI in the leg before the break (a back-in-the-range trade). The key levels of the leg from its
//     swing low up to the breaking candle (V-shape, OC, the Breaker = the A-shape the break closed
//     above, wicks in) are found at the alert, but NO POI is marked until liquidity forms after the
//     break: a single candle liquidity (the low wick of a bullish candle) or a swing low. The POI is
//     then the ONE level of the leg closest below that liquidity. A deeper liquidity before the next
//     alert moves it. Each level is its own box (no merging).
//   · the opposite zone (SELL above): past the closest liquidity above the breaking candle (an untaken
//     swing high; none: a single candle liquidity, the high wick of a bearish candle), the closest
//     fresh key level (A-shape, OC, Breaker = a broken V-shape), wicks in.
// The liquidity of each is drawn (yellow). A zone ends (clears off) when an H4 candle CLOSES through it, or at the next
// alert. Inside a zone a confirmation gives the trade: Instant (at its close) or a Retest of its level
// (CISD line, OC level) that waits until the
// next alert. SL behind the pattern's low (sells: high). TP 1:2 or 1:3. One trade per zone per setup.
// Confirmations tested: M5 CISD, M15 CISD, H1 OCTGD (EG / PCL taken out 2026-11-11: memory limit).
// Every confirmation of the picked pattern inside a zone is marked (a triangle; hover for the details).
// ═════════════════════════════════════════════════════════════════════════════
const string G_ZB = "9 · Zones backtest"
int    zb_fy   = input.int(2020, "Count trades from: year", minval = 1990, maxval = 2100, group = G_ZB, inline = "fr")
int    zb_fm   = input.int(1, "month", minval = 1, maxval = 12, group = G_ZB, inline = "fr",
     tooltip = "Only confirmations from the 1st of this month on are traded and counted. A confirmation can only fire where TradingView has its candles: put the chart on M5 / M15 / H1 (or use Bar Replay there) for the older years.")
int    zb_ty   = input.int(0, "Until: year (0 = today)", minval = 0, maxval = 2100, group = G_ZB, inline = "to")
int    zb_tm   = input.int(12, "month (to its end)", minval = 1, maxval = 12, group = G_ZB, inline = "to")
int    zb_from = timestamp(zb_fy, zb_fm, 1, 0, 0)
int    zb_to   = zb_ty == 0 ? timestamp(2100, 1, 1, 0, 0) : zb_tm == 12 ? timestamp(zb_ty + 1, 1, 1, 0, 0) - 1 : timestamp(zb_ty, zb_tm + 1, 1, 0, 0) - 1
string zb_tpo  = input.string("1:2", "Take profit", options = ["1:2", "1:3"], group = G_ZB)
string zb_side = input.string("Both", "Zones traded", options = ["Both", "The POI in the leg only", "The opposite zone only"], group = G_ZB)
string zb_conf = input.string("H1 OCTGD", "Confirmation", options = ["M5 CISD", "M15 CISD", "H1 OCTGD", "All"], group = G_ZB, inline = "sh")
string zb_ent  = input.string("Instant", "entry", options = ["Instant", "Retest", "Both"], group = G_ZB, inline = "sh",
     tooltip = "Instant: at the confirmation's close. Retest: CISD → the CISD line · OCTGD → the OC level. A retest order waits until the next breakout alert, then it is cancelled. The trades (and their result on the POI) are drawn when one confirmation and one entry are picked.")
int    zb_ow   = input.int(10, "OCTGD: candles allowed from C2 to the close through the level", minval = 1, maxval = 50, group = G_ZB)
int    zb_cw   = input.int(20, "CISD: candles allowed from the low to the close through the line", minval = 1, maxval = 100, group = G_ZB)
int    zb_slb  = input.int(0, "SL buffer (ticks beyond the pattern's low / high)", minval = 0, group = G_ZB)
float  zb_risk = input.float(1.0, "Risk per trade % (for the return figure)", minval = 0.1, step = 0.1, group = G_ZB)
int    zb_atr  = input.int(14, "H4 candle size = the average range of the last N H4 candles (a wick this far past a zone still counts)", minval = 1, maxval = 100, group = G_ZB)
int    zb_scn  = input.int(3, "Single candle liquidity after the break: only in the first N candles after it", minval = 0, maxval = 20, group = G_ZB,
     tooltip = "A single candle (buys: a bullish candle's low wick; sells: a bearish candle's high wick) counts as liquidity in the leg before the break, or just after the break (this many H4 candles). Further right only a swing counts (engineered liquidity).")
int    zb_scan = input.int(300, "H4 candles searched for the opposite zone", minval = 30, maxval = 1000, group = G_ZB)
bool   zb_shz  = input.bool(true, "Show the zones and their liquidity", group = G_ZB)
bool   zb_mk   = input.bool(true, "Triangles: mark each confirmation inside a zone", group = G_ZB, inline = "mk")
int    zb_km   = input.int(150, "kept", minval = 1, maxval = 300, group = G_ZB, inline = "mk")
string zb_mkp  = input.string("Same as the Confirmation above", "Triangles for", options = ["Same as the Confirmation above", "M5 CISD", "M15 CISD", "H1 OCTGD", "All"], group = G_ZB,
     tooltip = "Which confirmation's triangles are drawn. Hover a triangle for its time, wick, close, retest level and SL.")
string zb_mkz  = input.string("Both zones", "Triangles at", options = ["Both zones", "The POI in the leg", "The opposite zone"], group = G_ZB, inline = "mz")
string zb_mks  = input.string("Buys and sells", "", options = ["Buys and sells", "Buys", "Sells"], group = G_ZB, inline = "mz")
bool   zb_sht  = input.bool(true, "Show the trades", group = G_ZB, inline = "ts")
int    zb_kt   = input.int(40, "kept", minval = 1, maxval = 100, group = G_ZB, inline = "ts")
bool   zb_alr  = input.bool(false, "Alert BUY / SELL of the drawn setup in real time (alert: Any alert() function call)", group = G_ZB)
color  zb_bc   = input.color(#26A69A, "Buy", group = G_ZB, inline = "zc")
color  zb_scc  = input.color(#EF5350, "Sell", group = G_ZB, inline = "zc")
color  zb_lqc  = input.color(#F7C948, "Liquidity", group = G_ZB, inline = "zc")
int    zb_op   = input.int(82, "zone opacity %", minval = 0, maxval = 100, group = G_ZB, inline = "zc")

float  zb_rr   = zb_tpo == "1:3" ? 3.0 : 2.0
const int NS   = 6     // setups: confirmation p (0 M5 CISD · 1 M15 CISD · 2 H1 OCTGD) × entry (0 Instant · 1 Retest)
int    ZB_PI   = zb_conf == "M5 CISD" ? 0 : zb_conf == "M15 CISD" ? 1 : zb_conf == "H1 OCTGD" ? 2 : -1
int    ZB_MP   = zb_mkp == "M5 CISD" ? 0 : zb_mkp == "M15 CISD" ? 1 : zb_mkp == "H1 OCTGD" ? 2 : zb_mkp == "All" ? -1 : ZB_PI
int    ZB_EI   = zb_ent == "Instant" ? 0 : zb_ent == "Retest" ? 1 : -1
// the one setup drawn on the chart (-1: several picked, none drawn)
int    SHOWN   = ZB_PI >= 0 and ZB_EI >= 0 ? ZB_PI * 2 + ZB_EI : -1
var array<string> ZP = array.from("M5 CISD", "M15 CISD", "H1 OCTGD")
int    ZCS     = timeframe.in_seconds()
// a confirmation timeframe smaller than the chart is read from the candles inside each chart candle
// (only up to an H4 chart: above it the story can't run and the small candles inside a Daily / Weekly candle are too many)
bool   ZOK     = ZCS <= 14400
bool   ZL0     = ZOK and ZCS > 300
bool   ZL1     = ZOK and ZCS > 900
bool   ZL2     = ZOK and ZCS > 3600

// ── H4 candle j seen from direction d (d < 0: prices flipped, so the buy-side rules read the sell side) ──
f_zh(int j, int d) =>
    d > 0 ? array.get(q2hw, j) : -array.get(q2lw, j)
f_zl(int j, int d) =>
    d > 0 ? array.get(q2lw, j) : -array.get(q2hw, j)
f_zo(int j, int d) =>
    d * array.get(q2o, j)
f_zc(int j, int d) =>
    d * array.get(q2c, j)
// a level's name (kind 0 V-shape / A-shape, 1 OC, 2 Breaker), for a buy zone or a sell zone
f_kn(int k, bool buy) =>
    k == 0 ? (buy ? "V-shape" : "A-shape") : k == 1 ? "OC" : "Breaker"

// The key levels of the leg before the break, each on its own (flipped prices: buy levels below).
// The leg runs back from the breaking candle to its swing low; it stops at a candle whose high is above
// the breaking close.
f_zleg(int d, array<float> lo_, array<float> hi_, array<int> t_, array<int> k_) =>
    int nq = array.size(q2t)
    int k  = nq - 1
    int st0 = na
    if k >= 2
        int   s  = k
        float bc = f_zc(k, d)
        float mn = f_zl(k, d)
        int   j  = k - 1
        int   stop_ = math.max(1, k - 150)
        while j >= stop_
            if f_zh(j, d) > bc
                break
            if f_zl(j, d) < mn
                mn := f_zl(j, d)
                s  := j
            j -= 1
        st0 := array.get(q2t, s)
        for jj = math.max(1, s) to k
            float o1 = f_zo(jj - 1, d)
            float c1 = f_zc(jj - 1, d)
            float h1 = f_zh(jj - 1, d)
            float l1 = f_zl(jj - 1, d)
            float o2 = f_zo(jj, d)
            float c2 = f_zc(jj, d)
            float h2 = f_zh(jj, d)
            float l2 = f_zl(jj, d)
            float zlo = na
            float zhi = na
            int   kd  = -1
            if c1 < o1 and c2 > o2
                // V-shape: the bearish candle's close, down to the lower wick of the two
                zlo := math.min(l1, l2)
                zhi := c1
                kd  := 0
            else if c1 > o1 and c2 > o2
                // OC: the first close / second open, down to the second candle's wick
                zlo := math.min(l2, c1)
                zhi := math.max(c1, o2)
                kd  := 1
            else if c1 > o1 and c2 < o2 and c1 < bc
                // the Breaker: an A-shape the break closed above, up to its wick
                zlo := c1
                zhi := math.max(h1, h2)
                kd  := 2
            if kd >= 0
                // fresh: no close below it since (a Breaker: since it was broken)
                bool dead  = false
                bool armed = kd != 2
                if jj < k
                    for m = jj + 1 to k
                        float cm = f_zc(m, d)
                        if not armed
                            armed := cm > zlo
                        else if cm < zlo
                            dead := true
                            break
                if not dead
                    array.push(lo_, zlo)
                    array.push(hi_, zhi)
                    array.push(t_, array.get(q2t, jj - 1))
                    array.push(k_, kd)
    st0

// The opposite zone (flipped prices: a sell zone above): the closest fresh level past the liquidity above the
// breaking candle. Returns [lo, hi, time, kind, liquidity, its time, its kind (0 swing, 1 single candle, 2 the
// breaking candle's high)].
f_zopp(int d, int scan) =>
    int   nq  = array.size(q2t)
    int   k   = nq - 1
    float liq = na
    int   lqt = na
    int   lqk = 0
    float rlo = na
    float rhi = na
    int   rt  = na
    int   rk  = -1
    if k >= 3
        // liquidity: the closest swing high above the breaking candle's close that no candle has CLOSED above
        // since (a wick through it, the breaking candle's too, does not take it - user, 2026-11-11); none: the
        // closest such high wick of a bearish candle (single candle liquidity); none: the breaking candle's high
        float hmax  = f_zc(k, d)     // the highest close after candle j
        float sc    = na
        int   sct   = na
        int   stop_ = math.max(1, k - scan)
        int   j     = k - 1
        while j >= stop_
            float hj = f_zh(j, d)
            if hj > hmax
                if hj > f_zh(j - 1, d) and hj > f_zh(j + 1, d)
                    if na(liq) or hj < liq
                        liq := hj
                        lqt := array.get(q2t, j)
                        lqk := 0
                else if f_zc(j, d) < f_zo(j, d) and (na(sc) or hj < sc)
                    sc  := hj
                    sct := array.get(q2t, j)
            hmax := math.max(hmax, f_zc(j, d))
            j -= 1
        if na(liq)
            liq := na(sc) ? f_zh(k, d) : sc
            lqt := na(sc) ? array.get(q2t, k) : sct
            lqk := na(sc) ? 2 : 1
        float cmax = f_zc(k, d)     // the highest close after the pair
        // the highest / lowest close from candle m to the breaking candle, once (index m - b0): the Breaker
        // check reads them instead of walking the later candles again for every V-shape
        int b0 = math.max(1, k - scan)
        array<float> sfx = array.new<float>(k - b0 + 2, na)
        array<float> sfn = array.new<float>(k - b0 + 2, na)
        for m = k to b0
            float cm = f_zc(m, d)
            array.set(sfx, m - b0, m < k ? math.max(cm, array.get(sfx, m - b0 + 1)) : cm)
            array.set(sfn, m - b0, m < k ? math.min(cm, array.get(sfn, m - b0 + 1)) : cm)
        for jj = k - 1 to math.max(1, k - scan)
            float o1 = f_zo(jj - 1, d)
            float c1 = f_zc(jj - 1, d)
            float h1 = f_zh(jj - 1, d)
            float l1 = f_zl(jj - 1, d)
            float o2 = f_zo(jj, d)
            float c2 = f_zc(jj, d)
            float h2 = f_zh(jj, d)
            float l2 = f_zl(jj, d)
            float zl_ = na
            float zh_ = na
            int   kd  = -1
            if c1 > o1 and c2 < o2
                // A-shape: the bullish candle's close, up to the higher wick
                if c1 > liq and cmax < math.max(h1, h2)
                    zl_ := c1
                    zh_ := math.max(h1, h2)
                    kd  := 0
            else if c1 < o1 and c2 < o2
                // OC: the first close / second open, up to the second candle's wick
                if math.min(c1, o2) > liq and cmax < math.max(h2, c1)
                    zl_ := math.min(c1, o2)
                    zh_ := math.max(h2, c1)
                    kd  := 1
            else if c1 < o1 and c2 > o2
                // the Breaker: a V-shape price later closed below, and has not closed back above since
                float vlo = math.min(l1, l2)
                // (only if it would be closer than the zone found so far, and some later close went below it)
                if vlo > liq and (na(rlo) or vlo < rlo) and array.get(sfn, jj + 1 - b0) < vlo
                    int m = jj + 1
                    while f_zc(m, d) >= vlo
                        m += 1
                    // broken at candle m; alive if no close above it from there on
                    if array.get(sfx, m - b0) <= c1
                        zl_ := math.min(l1, l2)
                        zh_ := c1
                        kd  := 2
            if kd >= 0 and (na(rlo) or zl_ < rlo)
                rlo := zl_
                rhi := zh_
                rt  := array.get(q2t, jj - 1)
                rk  := kd
            cmax := math.max(cmax, c2)
    [rlo, rhi, rt, rk, liq, lqt, lqk]

// ── The two zones: 0 the POI in the leg, 1 the opposite zone (with their liquidity lines) ──
var array<float> zn_lo  = array.new<float>(2, na)
var array<float> zn_hi  = array.new<float>(2, na)
var array<int>   zn_dir = array.new<int>(2, 0)
var array<bool>  zn_ok  = array.new<bool>(2, false)
var array<box>   zn_bx  = array.new<box>(2)
var array<line>  zn_ll  = array.new<line>(2)
var array<label> zn_lb  = array.new<label>(2)
var array<box>   zx_bx  = array.new<box>()       // every box since the alert
var array<string> zn_tx = array.new<string>(2, "")   // each zone's box text (the trade and its result are added)
var array<int>   zn_gen = array.new<int>(2, 0)       // counts the boxes of each zone (which box a trade belongs to)
// the levels of the current leg (real prices) and its liquidity
var array<float> zv_lo  = array.new<float>()
var array<float> zv_hi  = array.new<float>()
var array<int>   zv_t   = array.new<int>()
var array<int>   zv_k   = array.new<int>()
var array<bool>  zv_ok  = array.new<bool>()
var int   zg_d   = 0
var int   zg_bt  = na
var int   zg_st  = na      // the time the leg before the break starts (its swing low; sells: high)
var float zg_lq  = na
var int   zg_lqt = na
var int   zg_pi  = -1
var float zb_sz  = na
var int   zb_na  = 0
var array<int> dg_z = array.new<int>(2, 0)   // POIs marked in the leg, opposite zones
f_zset(int z, float lo, float hi, int t, int dir, string txt) =>
    array.set(zn_lo, z, lo)
    array.set(zn_hi, z, hi)
    array.set(zn_dir, z, dir)
    array.set(zn_ok, z, true)
    array.set(zn_bx, z, box(na))
    array.set(zn_tx, z, txt)
    array.set(zn_gen, z, array.get(zn_gen, z) + 1)
    if zb_shz
        color cc = dir > 0 ? zb_bc : zb_scc
        box b = box.new(t, hi, time_close, lo, xloc = xloc.bar_time, border_color = color.new(cc, 40), bgcolor = color.new(cc, zb_op),
             text = txt, text_color = color.new(cc, 10), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_top)
        array.set(zn_bx, z, b)
        array.push(zx_bx, b)
// add a line to a zone's box text (the trade on it, then its result)
f_zbt(int z, string add) =>
    array.set(zn_tx, z, array.get(zn_tx, z) + add)
    box b = array.get(zn_bx, z)
    if not na(b)
        box.set_text(b, array.get(zn_tx, z))
f_zliq(int z, float y, int t, string txt) =>
    line.delete(array.get(zn_ll, z))
    label.delete(array.get(zn_lb, z))
    array.set(zn_ll, z, line(na))
    array.set(zn_lb, z, label(na))
    if zb_shz and not na(y) and not na(t)
        array.set(zn_ll, z, line.new(t, y, time_close, y, xloc = xloc.bar_time, color = zb_lqc, style = line.style_dotted, width = 2))
        // the label sits at the right end of its line and moves with it
        array.set(zn_lb, z, label.new(time_close, y, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = zb_lqc, size = size.tiny,
             tooltip = txt + " " + str.tostring(y, format.mintick)))

// ── The setups: two slots each (q = setup * 2 + side; side 0 buy, 1 sell) and their results ──
var array<int>   y_st  = array.new<int>(NS * 2, 0)     // 0 none · 1 retest order waiting · 2 open
var array<float> y_en  = array.new<float>(NS * 2, na)
var array<float> y_sl  = array.new<float>(NS * 2, na)
var array<float> y_tp  = array.new<float>(NS * 2, na)
var array<int>   y_src = array.new<int>(NS * 2, 0)
var array<bool>  z_use = array.new<bool>(NS * 2, false)  // zone z used by setup y: z * NS + y
var array<int>   y_n   = array.new<int>(NS, 0)
var array<int>   y_w   = array.new<int>(NS, 0)
var array<int>   y_cx  = array.new<int>(NS, 0)
var array<int>   y_run = array.new<int>(NS, 0)
var array<int>   y_mrn = array.new<int>(NS, 0)
var array<float> y_r   = array.new<float>(NS, 0.0)
var array<float> y_pk  = array.new<float>(NS, 0.0)
var array<float> y_dd  = array.new<float>(NS, 0.0)
var array<int>   sm_f  = array.new<int>(5)              // each confirmation: first / last candle counted
var array<int>   sm_l  = array.new<int>(5)
// the drawn setup: buys / sells, leg POI / opposite, month by month, its lines
var array<int>   sh_n  = array.new<int>(4, 0)
var array<float> sh_r  = array.new<float>(4, 0.0)
var array<int>   mo_k  = array.new<int>()
var array<int>   mo_n  = array.new<int>()
var array<float> mo_r  = array.new<float>()
var array<line>  d_ln  = array.new<line>(6)
var array<label> d_lb  = array.new<label>(2)
var array<int>   d_zz  = array.new<int>(2, -1)       // the drawn trade's zone and that zone's box
var array<int>   d_zg  = array.new<int>(2, -1)
var array<line>  zt_l  = array.new<line>()
var array<label> zt_b  = array.new<label>()
var array<label> zm_b  = array.new<label>()        // the confirmation marks
var array<label> zx_m  = array.new<label>()        // the x where a zone was closed through (the last 30)
f_ddel(int side) =>
    for k = 0 to 2
        line.delete(array.get(d_ln, side * 3 + k))
        array.set(d_ln, side * 3 + k, line(na))
    label.delete(array.get(d_lb, side))
    array.set(d_lb, side, label(na))

// the H4 candle size, and the zones / levels an H4 candle closed through
if x2_new
    int nq_ = array.size(q2t)
    if nq_ > 0
        int   m_ = math.min(zb_atr, nq_)
        float s_ = 0.0
        for i = nq_ - m_ to nq_ - 1
            s_ += array.get(q2hw, i) - array.get(q2lw, i)
        zb_sz := s_ / m_
    for z = 0 to 1
        if array.get(zn_ok, z) and (array.get(zn_dir, z) > 0 ? x2c < array.get(zn_lo, z) : x2c > array.get(zn_hi, z))
            // closed through: the zone clears off the chart (the opposite zone with its liquidity line)
            array.set(zn_ok, z, false)
            box.delete(array.get(zn_bx, z))
            array.set(zn_bx, z, box(na))
            if z == 0
                zg_pi := -1
            else
                f_zliq(1, na, na, "")
            // a small x where the close went through, so a cleared zone can still be checked
            if zb_shz
                bool zbuy = array.get(zn_dir, z) > 0
                array.push(zx_m, label.new(time, x2c, "✕", xloc = xloc.bar_time, style = label.style_none, textcolor = color.new(zbuy ? zb_bc : zb_scc, 20), size = size.small,
                     tooltip = (zbuy ? "BUY " : "SELL ") + (z == 0 ? "POI in the leg" : "opposite zone") + " " + str.tostring(array.get(zn_lo, z), format.mintick) + " – " + str.tostring(array.get(zn_hi, z), format.mintick)
                     + " cleared: an H4 candle closed " + (zbuy ? "below" : "above") + " it at " + str.tostring(x2c, format.mintick)))
                while array.size(zx_m) > 30
                    label.delete(array.shift(zx_m))
    int nv_ = array.size(zv_lo)
    if nv_ > 0
        for i = 0 to nv_ - 1
            if array.get(zv_ok, i) and (zg_d > 0 ? x2c < array.get(zv_lo, i) : x2c > array.get(zv_hi, i))
                array.set(zv_ok, i, false)

// a Bias Pointer alert: the old zones go, waiting retest orders are cancelled, the leg's levels and the
// opposite zone are found (the leg's POI waits for liquidity)
int zb_d = array.get(zb_ev, 0)
array.set(zb_ev, 0, 0)
if zb_d != 0
    zb_na += 1
    for b in zx_bx
        box.delete(b)
    array.clear(zx_bx)
    for z = 0 to 1
        array.set(zn_bx, z, box(na))
        array.set(zn_ok, z, false)
        f_zliq(z, na, na, "")
    array.fill(z_use, false)
    for q = 0 to NS * 2 - 1
        if array.get(y_st, q) == 1
            array.set(y_st, q, 0)
            int y = math.floor(q / 2)
            array.set(y_cx, y, array.get(y_cx, y) + 1)
            if y == SHOWN
                f_ddel(q % 2)
    // the leg's levels (real prices)
    array.clear(zv_lo)
    array.clear(zv_hi)
    array.clear(zv_t)
    array.clear(zv_k)
    array.clear(zv_ok)
    array<float> m_lo = array.new<float>()
    array<float> m_hi = array.new<float>()
    array<int>   m_t  = array.new<int>()
    array<int>   m_k  = array.new<int>()
    zg_st := f_zleg(zb_d, m_lo, m_hi, m_t, m_k)
    int nm_ = array.size(m_lo)
    if nm_ > 0
        for i = 0 to nm_ - 1
            array.push(zv_lo, zb_d > 0 ? array.get(m_lo, i) : -array.get(m_hi, i))
            array.push(zv_hi, zb_d > 0 ? array.get(m_hi, i) : -array.get(m_lo, i))
            array.push(zv_t, array.get(m_t, i))
            array.push(zv_k, array.get(m_k, i))
            array.push(zv_ok, true)
    zg_d   := zb_d
    zg_bt  := array.get(q2t, array.size(q2t) - 1)
    zg_lq  := na
    zg_lqt := na
    zg_pi  := -1
    // the opposite zone and its liquidity
    [o_lo, o_hi, o_t, o_k, o_lq, o_lqt, o_lqk] = f_zopp(zb_d, zb_scan)
    if not na(o_lq)
        f_zliq(1, zb_d * o_lq, o_lqt, (o_lqk == 0 ? (zb_d > 0 ? "swing high" : "swing low") : o_lqk == 1 ? "single candle" : "breakout candle's " + (zb_d > 0 ? "high" : "low")) + " liquidity (opposite)"
             + (na(o_lo) ? ": no fresh level beyond it in the last " + str.tostring(zb_scan) + " H4 candles" : ""))
    if not na(o_lo)
        array.set(dg_z, 1, array.get(dg_z, 1) + 1)
        f_zset(1, zb_d > 0 ? o_lo : -o_hi, zb_d > 0 ? o_hi : -o_lo, o_t, -zb_d, (zb_d > 0 ? "SELL · opposite · " : "BUY · opposite · ") + f_kn(o_k, zb_d < 0))

// The leg's liquidity and its POI (user, 2026-11-11; flipped prices: buys, lows). Liquidity:
//   · on the LEFT (the leg before the break, up to the breaking candle): a single candle (the low wick of a
//     bullish candle) or a swing low;
//   · just after the break (the first zb_scn candles): a single candle too;
//   · further RIGHT: only a swing low = engineered liquidity (a single candle there is not).
// The POI = the alive level of the leg closest to price that has liquidity before it (above it); its
// liquidity = the one closest to it. When a POI is closed through, the next level with liquidity before it
// becomes the POI, by the same rule.
if x2_new and zg_d != 0 and not na(zg_st)
    int nq = array.size(q2t)
    int kb = nq - 1
    while kb > 0 and array.get(q2t, kb) > zg_bt
        kb -= 1
    int js = kb
    while js > 0 and array.get(q2t, js) > zg_st
        js -= 1
    if array.get(q2t, kb) == zg_bt
        array<float> cl = array.new<float>()
        array<int>   ct = array.new<int>()
        array<int>   ck = array.new<int>()     // 0 single candle · 1 swing (left) · 2 engineered (swing on the right)
        for j = math.max(1, js) to nq - 1
            float lj  = f_zl(j, zg_d)
            bool  one = j <= kb + zb_scn and f_zc(j, zg_d) > f_zo(j, zg_d)
            bool  swg = j < nq - 1 and lj < f_zl(j - 1, zg_d) and lj < f_zl(j + 1, zg_d)
            if one or swg
                array.push(cl, lj)
                array.push(ct, array.get(q2t, j))
                array.push(ck, swg ? (j > kb ? 2 : 1) : j > kb ? 3 : 0)
        int   best = -1
        float bh   = na
        float lq   = na
        int   lqt  = na
        int   lqk  = 0
        int   nv   = array.size(zv_lo)
        int   nc   = array.size(cl)
        if nv > 0 and nc > 0
            for i = 0 to nv - 1
                if array.get(zv_ok, i)
                    float mh = zg_d > 0 ? array.get(zv_hi, i) : -array.get(zv_lo, i)
                    if na(bh) or mh > bh
                        // the liquidity closest before this level
                        float cq  = na
                        int   cqi = -1
                        for c_ = 0 to nc - 1
                            float v = array.get(cl, c_)
                            if v > mh and (na(cq) or v < cq)
                                cq  := v
                                cqi := c_
                        if cqi >= 0
                            best := i
                            bh   := mh
                            lq   := cq
                            lqt  := array.get(ct, cqi)
                            lqk  := array.get(ck, cqi)
        if not na(lq)
            float lqr = zg_d * lq
            // (na(...) first: a comparison with na is never true)
            if na(zg_lq) or na(zg_lqt) or lqr != zg_lq or lqt != zg_lqt
                zg_lq  := lqr
                zg_lqt := lqt
                f_zliq(0, lqr, lqt, lqk == 0 ? "single candle liquidity" : lqk == 3 ? "single candle liquidity (just after the break)" : lqk == 1 ? (zg_d > 0 ? "swing low" : "swing high") + " liquidity" : "engineered liquidity (" + (zg_d > 0 ? "swing low" : "swing high") + " after the break)")
        else if not na(zg_lq)
            zg_lq  := na
            zg_lqt := na
            f_zliq(0, na, na, "")
        if best != zg_pi
            // the POI moves: the one it replaces (still alive) goes
            if zg_pi >= 0
                box ob = array.get(zn_bx, 0)
                if not na(ob)
                    box.delete(ob)
                array.set(zn_bx, 0, box(na))
                array.set(zn_ok, 0, false)
            zg_pi := best
            if best >= 0
                array.set(dg_z, 0, array.get(dg_z, 0) + 1)
                for y = 0 to NS - 1
                    array.set(z_use, y, false)
                f_zset(0, array.get(zv_lo, best), array.get(zv_hi, best), array.get(zv_t, best), zg_d, (zg_d > 0 ? "BUY POI · " : "SELL POI · ") + f_kn(array.get(zv_k, best), zg_d > 0))

// the alive zones and the liquidity lines run on through this candle
for z = 0 to 1
    box b = array.get(zn_bx, z)
    if array.get(zn_ok, z) and not na(b)
        box.set_right(b, time_close)
    line ll = array.get(zn_ll, z)
    if not na(ll)
        line.set_x2(ll, time_close)
    label lt = array.get(zn_lb, z)
    if not na(lt)
        label.set_x(lt, time_close)

// ── Confirmations ────────────────────────────────────────────────────────────
// The confirmation on its own timeframe's candles: the last COMPLETED one ([1] + lookahead_on) when the chart
// is that timeframe or lower; every candle inside the chart candle (request.security_lower_tf) when higher. p: 0 CISD · 1 OCTGD · 2 Engulfing · 3 PCL. For each side: signal, retest
// level, the pattern's low (sells: high) for the SL, the wick that reached the zone.
f_zconf(simple int p, simple int ow, simple int cw, simple bool eg_open, simple bool lag) =>
    bool  pbull = close[1] > open[1]
    bool  pbear = close[1] < open[1]
    bool  cbull = close > open
    bool  cbear = close < open
    float bs  = na
    float bl  = na
    float bsl = na
    float btp = na
    float ss  = na
    float sl_ = na
    float ssl = na
    float stp = na
    var float boc_lv = na
    var float boc_tp = na
    var float boc_mn = na
    var int   boc_b  = na
    var float soc_lv = na
    var float soc_tp = na
    var float soc_mx = na
    var int   soc_b  = na
    var float dn_open = na
    var float dn_low  = na
    var float bci_ln  = na
    var float bci_lo  = na
    var int   bci_b   = na
    var float up_open = na
    var float up_high = na
    var float sci_ln  = na
    var float sci_hi  = na
    var int   sci_b   = na
    if p == 3
        // PCL: C1 bearish, C2 bullish; C2's wick goes below C1's low and its body closes back above it
        if pbear and cbull and low < low[1] and close > low[1]
            bs  := 1.0
            bl  := open
            bsl := low
            btp := low
        if pbull and cbear and high > high[1] and close < high[1]
            ss  := 1.0
            sl_ := open
            ssl := high
            stp := high
    else if p == 2
        // Engulfing: C1 bearish, C2 bullish, opens at or below C1's close and closes above C1's open
        if pbear and cbull and open <= close[1] and close > open[1]
            bs  := 1.0
            bl  := eg_open ? open[1] : close[1]
            bsl := math.min(low, low[1])
            btp := bsl
        if pbull and cbear and open >= close[1] and close < open[1]
            ss  := 1.0
            sl_ := eg_open ? open[1] : close[1]
            ssl := math.max(high, high[1])
            stp := ssl
    else if p == 1
        // OCTGD: the latest bearish OC (C1 close = C2 open); a bullish close above its level within ow candles
        if not na(boc_lv)
            boc_mn := math.min(boc_mn, low)
            if bar_index - boc_b > ow
                boc_lv := na
            else if cbull and close > boc_lv
                bs  := 1.0
                bl  := boc_lv
                bsl := boc_mn
                btp := boc_tp
                boc_lv := na
        if not na(soc_lv)
            soc_mx := math.max(soc_mx, high)
            if bar_index - soc_b > ow
                soc_lv := na
            else if cbear and close < soc_lv
                ss  := 1.0
                sl_ := soc_lv
                ssl := soc_mx
                stp := soc_tp
                soc_lv := na
        if pbear and cbear
            boc_lv := close[1]
            boc_tp := math.min(low, low[1])
            boc_mn := boc_tp
            boc_b  := bar_index
        if pbull and cbull
            soc_lv := close[1]
            soc_tp := math.max(high, high[1])
            soc_mx := soc_tp
            soc_b  := bar_index
    else
        // CISD: the open of the first candle of the bearish run that made the lowest low; a bullish body close above it
        if not na(bci_ln)
            if low < bci_lo
                bci_lo := low
                bci_b  := bar_index
            if bar_index - bci_b > cw
                bci_ln := na
            else if cbull and close > bci_ln
                bs  := 1.0
                bl  := bci_ln
                bsl := bci_lo
                btp := bci_lo
                bci_ln := na
        if not na(sci_ln)
            if high > sci_hi
                sci_hi := high
                sci_b  := bar_index
            if bar_index - sci_b > cw
                sci_ln := na
            else if cbear and close < sci_ln
                ss  := 1.0
                sl_ := sci_ln
                ssl := sci_hi
                stp := sci_hi
                sci_ln := na
        if cbear
            if not pbear or na(dn_low)
                dn_open := open
                dn_low  := low
            else
                dn_low  := math.min(dn_low, low)
            if na(bs) and (na(bci_ln) or dn_low <= bci_lo)
                bci_ln := dn_open
                bci_lo := dn_low
                bci_b  := bar_index
        if cbull
            if not pbull or na(up_high)
                up_open := open
                up_high := high
            else
                up_high := math.max(up_high, high)
            if na(ss) and (na(sci_ln) or up_high >= sci_hi)
                sci_ln := up_open
                sci_hi := up_high
                sci_b  := bar_index
    int   o_t   = lag ? time[1] : time
    float o_c   = lag ? close[1] : close
    float o_h   = lag ? high[1] : high
    float o_l   = lag ? low[1] : low
    float o_bl  = lag ? bl[1] : bl
    float o_bsl = lag ? bsl[1] : bsl
    float o_btp = lag ? btp[1] : btp
    float o_sl  = lag ? sl_[1] : sl_
    float o_ssl = lag ? ssl[1] : ssl
    float o_stp = lag ? stp[1] : stp
    [o_t, o_c, o_h, o_l, o_bl, o_bsl, o_btp, o_sl, o_ssl, o_stp]
f_x(array<float> x, float bl, float bsl, float btp, float sl_, float ssl, float stp) =>
    array.set(x, 0, na(bl) ? na : 1.0)
    array.set(x, 1, bl)
    array.set(x, 2, bsl)
    array.set(x, 3, btp)
    array.set(x, 4, na(sl_) ? na : 1.0)
    array.set(x, 5, sl_)
    array.set(x, 6, ssl)
    array.set(x, 7, stp)

// a confirmation of pattern p closed (candle time t, close c): its wick inside an alive zone of its side
// (up to one H4 candle size past the far edge) opens a trade on both entries of that pattern
// counts per pattern: confirmations seen, with a zone of their side alive, inside it
var array<int> dg_sig  = array.new<int>(5, 0)
var array<int> dg_live = array.new<int>(5, 0)
var array<int> dg_in   = array.new<int>(5, 0)
f_try(int p, int t, float c, array<float> x) =>
    if t >= zb_from and t <= zb_to
        for side = 0 to 1
            if not na(array.get(x, side * 4))
                int   dir = side == 0 ? 1 : -1
                float lvl = array.get(x, side * 4 + 1)
                float ext = array.get(x, side * 4 + 2)
                float tch = array.get(x, side * 4 + 3)
                int   z   = -1
                bool  lv_ = false
                array.set(dg_sig, p, array.get(dg_sig, p) + 1)
                for zz = 0 to 1
                    bool sok = zz == 0 ? zb_side != "The opposite zone only" : zb_side != "The POI in the leg only"
                    if sok and array.get(zn_ok, zz) and array.get(zn_dir, zz) == dir
                        lv_ := true
                    if z < 0 and sok and array.get(zn_ok, zz) and array.get(zn_dir, zz) == dir and not na(tch)
                        float zl = array.get(zn_lo, zz)
                        float zh = array.get(zn_hi, zz)
                        if dir > 0 ? (tch <= zh and tch >= zl - nz(zb_sz)) : (tch >= zl and tch <= zh + nz(zb_sz))
                            z := zz
                if lv_
                    array.set(dg_live, p, array.get(dg_live, p) + 1)
                if z >= 0
                    array.set(dg_in, p, array.get(dg_in, p) + 1)
                    bool mz_ok = zb_mkz == "Both zones" or (z == 0) == (zb_mkz == "The POI in the leg")
                    bool ms_ok = zb_mks == "Buys and sells" or (dir > 0) == (zb_mks == "Buys")
                    if zb_mk and (ZB_MP < 0 or p == ZB_MP) and mz_ok and ms_ok
                        array.push(zm_b, label.new(t, tch, "", xloc = xloc.bar_time, style = dir > 0 ? label.style_triangleup : label.style_triangledown,
                             color = color.new(dir > 0 ? zb_bc : zb_scc, 0), size = size.tiny,
                             tooltip = array.get(ZP, p) + (dir > 0 ? " BUY" : " SELL") + " at the " + (z == 0 ? "POI in the leg" : "opposite zone")
                             + "\n" + str.format_time(t, "dd MMM yyyy HH:mm", syminfo.timezone)
                             + "\nwick " + str.tostring(tch, format.mintick) + " · close " + str.tostring(c, format.mintick)
                             + "\nretest level " + str.tostring(lvl, format.mintick) + " · SL " + str.tostring(ext, format.mintick)))
                        while array.size(zm_b) > zb_km
                            label.delete(array.shift(zm_b))
                if z >= 0 and not na(ext)
                    for e = 0 to 1
                        int y = p * 2 + e
                        int q = y * 2 + side
                        if array.get(y_st, q) == 0 and not array.get(z_use, z * NS + y)
                            float en = e == 0 ? c : lvl
                            float sl = ext - dir * zb_slb * syminfo.mintick
                            float rk = na(en) ? na : dir * (en - sl)
                            if not na(rk) and rk > 0
                                float tp = en + dir * zb_rr * rk
                                array.set(z_use, z * NS + y, true)
                                array.set(y_st, q, e == 0 ? 2 : 1)
                                array.set(y_en, q, en)
                                array.set(y_sl, q, sl)
                                array.set(y_tp, q, tp)
                                array.set(y_src, q, z)
                                if y == SHOWN
                                    string nm = (dir > 0 ? "BUY" : "SELL") + " · " + array.get(ZP, p) + (e == 0 ? "" : " retest") + (z == 0 ? " · leg POI" : " · opposite zone")
                                    if zb_sht
                                        color cc = dir > 0 ? zb_bc : zb_scc
                                        array.set(d_ln, side * 3, line.new(t, en, t, en, xloc = xloc.bar_time, color = cc, width = 2, style = e == 0 ? line.style_solid : line.style_dashed))
                                        array.set(d_ln, side * 3 + 1, line.new(t, sl, t, sl, xloc = xloc.bar_time, color = color.new(zb_scc, 30), width = 1))
                                        array.set(d_ln, side * 3 + 2, line.new(t, tp, t, tp, xloc = xloc.bar_time, color = color.new(zb_bc, 30), width = 1))
                                        array.set(d_lb, side, label.new(t, ext, nm + (e == 0 ? "" : " · waiting"), xloc = xloc.bar_time, style = dir > 0 ? label.style_label_up : label.style_label_down,
                                             color = color.new(cc, 20), textcolor = color.white, size = size.tiny))
                                    // the on-chart alert: written on the POI it came from
                                    array.set(d_zz, side, z)
                                    array.set(d_zg, side, array.get(zn_gen, z))
                                    f_zbt(z, "\n▶ " + (dir > 0 ? "BUY " : "SELL ") + array.get(ZP, p) + (e == 0 ? " · entry " : " · retest order ") + str.tostring(en, format.mintick)
                                         + " · SL " + str.tostring(sl, format.mintick) + " · TP " + str.tostring(tp, format.mintick) + " (1:" + str.tostring(zb_rr, "#") + ")"
                                         + " · " + str.format_time(t, "dd MMM HH:mm", syminfo.timezone))
                                    if zb_alr and barstate.isrealtime
                                        alert(nm + " " + syminfo.ticker + " · entry " + str.tostring(en, format.mintick) + " · SL " + str.tostring(sl, format.mintick) + " · TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar)

// manage setups y0..y1 on one candle (time t): a waiting retest fills when price comes back to it; SL first
// when both are touched in one candle; TP is not taken on the candle that filled the retest
f_mng(int y0, int y1, int t, float h, float l) =>
    for y = y0 to y1
        for side = 0 to 1
            int q  = y * 2 + side
            int st = array.get(y_st, q)
            if st > 0
                int   dir = side == 0 ? 1 : -1
                float en  = array.get(y_en, q)
                float sl  = array.get(y_sl, q)
                float tp  = array.get(y_tp, q)
                bool  fill_now = false
                if st == 1 and (dir > 0 ? l <= en : h >= en)
                    st := 2
                    array.set(y_st, q, 2)
                    fill_now := true
                    if y == SHOWN
                        label lb = array.get(d_lb, side)
                        if not na(lb)
                            label.set_text(lb, str.replace_all(label.get_text(lb), " · waiting", " · filled"))
                        int zz = array.get(d_zz, side)
                        if zz >= 0 and array.get(zn_gen, zz) == array.get(d_zg, side)
                            f_zbt(zz, " · filled")
                bool done = false
                if st == 2
                    bool h_sl = dir > 0 ? l <= sl : h >= sl
                    bool h_tp = not fill_now and (dir > 0 ? h >= tp : l <= tp)
                    if h_sl or h_tp
                        done := true
                        float r = h_sl ? -1.0 : zb_rr
                        array.set(y_st, q, 0)
                        array.set(y_n, y, array.get(y_n, y) + 1)
                        float tot = array.get(y_r, y) + r
                        array.set(y_r, y, tot)
                        if r > 0
                            array.set(y_w, y, array.get(y_w, y) + 1)
                            array.set(y_run, y, 0)
                        else
                            int run = array.get(y_run, y) + 1
                            array.set(y_run, y, run)
                            array.set(y_mrn, y, math.max(array.get(y_mrn, y), run))
                        float pk = math.max(array.get(y_pk, y), tot)
                        array.set(y_pk, y, pk)
                        array.set(y_dd, y, math.max(array.get(y_dd, y), pk - tot))
                        if y == SHOWN
                            int src = array.get(y_src, q)
                            int zz  = array.get(d_zz, side)
                            if zz >= 0 and array.get(zn_gen, zz) == array.get(d_zg, side)
                                f_zbt(zz, r > 0 ? " · WIN +" + str.tostring(r, "#") + "R" : " · LOSS -1R")
                            array.set(d_zz, side, -1)
                            array.set(sh_n, side, array.get(sh_n, side) + 1)
                            array.set(sh_r, side, array.get(sh_r, side) + r)
                            array.set(sh_n, 2 + src, array.get(sh_n, 2 + src) + 1)
                            array.set(sh_r, 2 + src, array.get(sh_r, 2 + src) + r)
                            int mk = year(t) * 12 + month(t) - 1
                            if array.size(mo_k) == 0 or array.last(mo_k) != mk
                                array.push(mo_k, mk)
                                array.push(mo_n, 1)
                                array.push(mo_r, r)
                                if array.size(mo_k) > 120
                                    array.shift(mo_k)
                                    array.shift(mo_n)
                                    array.shift(mo_r)
                            else
                                int lst = array.size(mo_k) - 1
                                array.set(mo_n, lst, array.get(mo_n, lst) + 1)
                                array.set(mo_r, lst, array.get(mo_r, lst) + r)
                            if zb_sht
                                for k = 0 to 2
                                    line ln = array.get(d_ln, side * 3 + k)
                                    if not na(ln)
                                        line.set_x2(ln, t)
                                        array.push(zt_l, ln)
                                    array.set(d_ln, side * 3 + k, line(na))
                                label lb = array.get(d_lb, side)
                                if not na(lb)
                                    label.set_text(lb, str.replace_all(label.get_text(lb), " · filled", "") + (r > 0 ? " · WIN +" + str.tostring(r, "#") + "R" : " · LOSS -1R"))
                                    label.set_color(lb, color.new(r > 0 ? zb_bc : zb_scc, 10))
                                    array.push(zt_b, lb)
                                array.set(d_lb, side, label(na))
                                while array.size(zt_b) > zb_kt
                                    label.delete(array.shift(zt_b))
                                while array.size(zt_l) > zb_kt * 3
                                    line.delete(array.shift(zt_l))
                if not done and y == SHOWN
                    for k = 0 to 2
                        line ln = array.get(d_ln, side * 3 + k)
                        if not na(ln)
                            line.set_x2(ln, t)
f_seen(int k, int t) =>
    if t >= zb_from and t <= zb_to
        if na(array.get(sm_f, k))
            array.set(sm_f, k, t)
        array.set(sm_l, k, t)

// the three confirmations: from the candles inside each chart candle when their timeframe is smaller than the
// chart, else the last closed candle of their timeframe; trades run on those candles / on the chart's
[za0t, za0c, za0h, za0l, za0bl, za0bsl, za0btp, za0sl, za0ssl, za0stp] = request.security(syminfo.tickerid, ZL0 or not ZOK ? timeframe.period : "5", f_zconf(0, zb_ow, zb_cw, true, true), lookahead = barmerge.lookahead_on)
[zi0t, zi0c, zi0h, zi0l, zi0bl, zi0bsl, zi0btp, zi0sl, zi0ssl, zi0stp] = request.security_lower_tf(syminfo.tickerid, ZL0 ? "5" : "12M", f_zconf(0, zb_ow, zb_cw, true, false), ignore_invalid_timeframe = true)
[za1t, za1c, za1h, za1l, za1bl, za1bsl, za1btp, za1sl, za1ssl, za1stp] = request.security(syminfo.tickerid, ZL1 or not ZOK ? timeframe.period : "15", f_zconf(0, zb_ow, zb_cw, true, true), lookahead = barmerge.lookahead_on)
[zi1t, zi1c, zi1h, zi1l, zi1bl, zi1bsl, zi1btp, zi1sl, zi1ssl, zi1stp] = request.security_lower_tf(syminfo.tickerid, ZL1 ? "15" : "12M", f_zconf(0, zb_ow, zb_cw, true, false), ignore_invalid_timeframe = true)
[za2t, za2c, za2h, za2l, za2bl, za2bsl, za2btp, za2sl, za2ssl, za2stp] = request.security(syminfo.tickerid, ZL2 or not ZOK ? timeframe.period : "60", f_zconf(1, zb_ow, zb_cw, true, true), lookahead = barmerge.lookahead_on)
[zi2t, zi2c, zi2h, zi2l, zi2bl, zi2bsl, zi2btp, zi2sl, zi2ssl, zi2stp] = request.security_lower_tf(syminfo.tickerid, ZL2 ? "60" : "12M", f_zconf(1, zb_ow, zb_cw, true, false), ignore_invalid_timeframe = true)
var array<float> xq = array.new<float>(8, na)
f_zn(array<int> a) =>
    int n = array.size(a)
    barstate.isrealtime and not barstate.isconfirmed and n > 0 ? n - 1 : n
if ZL0
    int n = f_zn(zi0t)
    if n > 0
        for j = 0 to n - 1
            int it = array.get(zi0t, j)
            f_seen(0, it)
            f_mng(0, 1, it, array.get(zi0h, j), array.get(zi0l, j))
            f_x(xq, array.get(zi0bl, j), array.get(zi0bsl, j), array.get(zi0btp, j), array.get(zi0sl, j), array.get(zi0ssl, j), array.get(zi0stp, j))
            f_try(0, it, array.get(zi0c, j), xq)
else if ZOK
    f_seen(0, time)
    if not na(za0t) and za0t != nz(za0t[1])
        f_x(xq, za0bl, za0bsl, za0btp, za0sl, za0ssl, za0stp)
        f_try(0, za0t, za0c, xq)
    f_mng(0, 1, time, high, low)
if ZL1
    int n = f_zn(zi1t)
    if n > 0
        for j = 0 to n - 1
            int it = array.get(zi1t, j)
            f_seen(1, it)
            f_mng(2, 3, it, array.get(zi1h, j), array.get(zi1l, j))
            f_x(xq, array.get(zi1bl, j), array.get(zi1bsl, j), array.get(zi1btp, j), array.get(zi1sl, j), array.get(zi1ssl, j), array.get(zi1stp, j))
            f_try(1, it, array.get(zi1c, j), xq)
else if ZOK
    f_seen(1, time)
    if not na(za1t) and za1t != nz(za1t[1])
        f_x(xq, za1bl, za1bsl, za1btp, za1sl, za1ssl, za1stp)
        f_try(1, za1t, za1c, xq)
    f_mng(2, 3, time, high, low)
if ZL2
    int n = f_zn(zi2t)
    if n > 0
        for j = 0 to n - 1
            int it = array.get(zi2t, j)
            f_seen(2, it)
            f_mng(4, 5, it, array.get(zi2h, j), array.get(zi2l, j))
            f_x(xq, array.get(zi2bl, j), array.get(zi2bsl, j), array.get(zi2btp, j), array.get(zi2sl, j), array.get(zi2ssl, j), array.get(zi2stp, j))
            f_try(2, it, array.get(zi2c, j), xq)
else if ZOK
    f_seen(2, time)
    if not na(za2t) and za2t != nz(za2t[1])
        f_x(xq, za2bl, za2bsl, za2btp, za2sl, za2ssl, za2stp)
        f_try(2, za2t, za2c, xq)
    f_mng(4, 5, time, high, low)
