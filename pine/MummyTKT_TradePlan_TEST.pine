H_ibp = H_eq ? C_ibp : Hs_ibp
H_inp = H_eq ? C_inp : Hs_inp
H_inpt = H_eq ? C_inpt : Hs_inpt
H_ipt = H_eq ? C_ipt : Hs_ipt
H_ipo = H_eq ? C_ipo : Hs_ipo
H_ipq = H_eq ? C_ipq : Hs_ipq
H_in_ = H_eq ? C_in_ : Hs_in_
H_sdir = H_eq ? C_sdir : Hs_sdir
H_shi = H_eq ? C_shi : Hs_shi
H_sht = H_eq ? C_sht : Hs_sht
