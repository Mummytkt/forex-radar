H_ll = H_eq ? C_ll : Hs_ll
M_fdir = M_eq ? C_fdir : Ms_fdir
M_fh = M_eq ? C_fh : Ms_fh
M_fht = M_eq ? C_fht : Ms_fht
M_flo = M_eq ? C_flo : Ms_flo
M_flt = M_eq ? C_flt : Ms_flt
M_ch = M_eq ? C_ch : Ms_ch
