//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// MummyTKT — High Level Trade Plan (TEST, display only, no alerts)
//
// HTF objective → MTF POIs → LTF execution. Pick the plan: Swing D → H4 → M15 or
// Day H4 → M15 → M5 (or custom); put the chart on its LTF.
// The MTF pullback is marked as in the picture: a = CHoCH against the swing (may be
// starting), b = i-BOS against it (confirmed; the swing high / low is fixed = weak),
// c = CHoCH back (may be ending), d = i-BOS back (phase A). Phase flow D → C → B → A.
//   HTF (default Daily): the swing direction, its strong / weak high and low, the
//       swing EQ (premium / discount) and the HTF POIs. The weak side is the objective.
//   MTF (default 4H): swing + internal structure → the phase for buys and for sells
//       (A pro swing + pro internal, B pro swing + counter internal, C counter swing
//       + pro internal, D counter both), and the MTF POIs.
//   LTF (this chart): once price reaches (mitigates) an MTF POI, an LTF CH (a wick
//       through the latest LTF fractal point) in the trade direction marks the LTF
//       entry model (▲ / ▼), if the phase and the HTF filter allow it.
// The watchlist table ticks the plan off live. Structure rules: see the Swing ·
// Internal · Fractal test script (same engine): BOS / i-BOS = body close beyond a
// wick level, CH = wick; a high is fixed by the opposite i-BOS (swing) / CH (internal).
// ─────────────────────────────────────────────────────────────────────────────

indicator("MummyTKT — Trade Plan (Test)", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 200, max_bars_back = 5000)

const string G_TF  = "1 · Timeframes (the chart is your LTF)"
const string G_ENT = "2 · LTF entry model (display only)"
const string G_SH  = "3 · What to show"
const string G_COL = "4 · Colours"

string plan = input.string("Swing: D → H4 → M15", "Plan (HTF → MTF → LTF)", options = ["Swing: D → H4 → M15", "Day: H4 → M15 → M5", "Custom (below)"], group = G_TF,
     tooltip = "Only the plan you pick is drawn. Put the chart on its LTF: M15 for Swing, M5 for Day (a lower chart works too).")
string cu_htf = input.timeframe("D",   "Custom: HTF", group = G_TF, inline = "cu")
string cu_mtf = input.timeframe("240", "MTF", group = G_TF, inline = "cu")
string cu_ltf = input.timeframe("15",  "LTF", group = G_TF, inline = "cu")
string htf = plan == "Swing: D → H4 → M15" ? "D" : plan == "Day: H4 → M15 → M5" ? "240" : cu_htf
string mtf = plan == "Swing: D → H4 → M15" ? "240" : plan == "Day: H4 → M15 → M5" ? "15" : cu_mtf
string ltf = plan == "Swing: D → H4 → M15" ? "15" : plan == "Day: H4 → M15 → M5" ? "5" : cu_ltf
int    flen = input.int(2, "Fractal: candles each side", minval = 1, maxval = 10, group = G_TF)

string ph_set  = input.string("A and B", "Mark entries in phases", options = ["A only", "A and B", "A, B and C"], group = G_ENT,
     tooltip = "The MTF phase for that trade direction. D (counter swing + counter internal) is never marked.")
string htf_flt = input.string("With the HTF direction", "HTF filter", options = ["With the HTF direction", "HTF discount for buys / premium for sells", "Off"], group = G_ENT,
     tooltip = "With the HTF direction: buys only while the HTF swing is bullish (sells: bearish). Discount / premium: buys only below the HTF swing EQ, sells only above it.")
int    ent_win = input.int(40, "LTF candles allowed after the MTF POI is reached", minval = 1, maxval = 500, group = G_ENT)
bool   use_int = input.bool(true, "MTF internal POIs count too", group = G_ENT, tooltip = "Off: only MTF swing POIs.")
bool   show_skip = input.bool(false, "Show skipped LTF CHs (grey, with the reason)", group = G_ENT)

bool show_h   = input.bool(true, "HTF swing levels + EQ", group = G_SH, inline = "s1")
bool show_hb  = input.bool(true, "HTF BOS", group = G_SH, inline = "s1")
bool show_m   = input.bool(true, "MTF swing + internal levels", group = G_SH, inline = "s2")
bool show_mb  = input.bool(true, "MTF BOS / i-BOS", group = G_SH, inline = "s2")
bool show_abcd = input.bool(true, "MTF pullback marks: CHoCH lines + a / b / c / d", group = G_SH, inline = "s3")
bool show_ph   = input.bool(true, "MTF phase changes (D / C / B / A)", group = G_SH, inline = "s3")
bool show_st   = input.bool(true, "The story: what formed, the zones to watch, where the reaction may come from", group = G_SH)
int  story_n   = input.int(8, "Story notes kept", minval = 1, maxval = 40, group = G_SH)
bool show_rng  = input.bool(true, "Pullback range (premium / discount of the current leg)", group = G_SH)
bool show_lch = input.bool(false, "LTF CH lines", group = G_SH)
bool show_poi = input.bool(true, "POIs (HTF swing, MTF swing + internal)", group = G_SH)
int  poi_max  = input.int(12, "POIs kept", minval = 1, maxval = 50, group = G_SH)
int  keep_n   = input.int(12, "Past breaks kept (each type)", minval = 1, maxval = 100, group = G_SH)
bool tbl_on   = input.bool(true, "Watchlist table", group = G_SH, inline = "t")
string tbl_pos = input.string("Top right", "", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = G_SH, inline = "t")

color c_bull = input.color(#26A69A, "Bullish", group = G_COL, inline = "c1")
color c_bear = input.color(#EF5350, "Bearish", group = G_COL, inline = "c1")
color c_htf  = input.color(#E0E0E0, "HTF levels", group = G_COL, inline = "c2")
color c_mtf  = input.color(#FFB74D, "MTF levels", group = G_COL, inline = "c2")
color c_eq   = input.color(#9E9E9E, "EQ", group = G_COL, inline = "c2")
color c_dem  = input.color(#26A69A, "Demand POI", group = G_COL, inline = "c3")
color c_sup  = input.color(#EF5350, "Supply POI", group = G_COL, inline = "c3")
color c_mit  = input.color(#787B86, "Mitigated / skipped", group = G_COL, inline = "c3")
color c_ent  = input.color(#7C4DFF, "LTF entry", group = G_COL, inline = "c4")

// ── Engine ────────────────────────────────────────────────────────────────────
type Lvl
    int   dir = 0
    float hi  = na
    int   hb  = na
    bool  hf  = false
    float lo  = na
    int   lb  = na
    bool  lf  = false

// Open time of bar b (na if unknown)
f_tb(int b) =>
    na(b) ? na : time[math.min(bar_index - b, 4990)]

// Highest high / lowest low from bar from_bar up to this bar, and its bar
f_hi_since(int from_bar) =>
    float m  = high
    int   mb = bar_index
    int   n  = math.min(bar_index - nz(from_bar, bar_index), 1500)
    for i = 0 to n
        if high[i] > m
            m  := high[i]
            mb := bar_index - i
    [m, mb]
f_lo_since(int from_bar) =>
    float m  = low
    int   mb = bar_index
    int   n  = math.min(bar_index - nz(from_bar, bar_index), 1500)
    for i = 0 to n
        if low[i] < m
            m  := low[i]
            mb := bar_index - i
    [m, mb]

// POI: the last opposite candle at the new strong point (it, or up to 3 candles
// before it): bearish for demand, bullish for supply. [top, bottom, open time]
f_poi(bool bull, int pb) =>
    int k0 = math.min(bar_index - pb, 4985)
    int kk = k0
    for j = 0 to 3
        int k = k0 + j
        if bull ? close[k] < open[k] : close[k] > open[k]
            kk := k
            break
    [high[kk], low[kk], time[kk]]

// One candle of one structure (internal or swing). fixH / fixL: the structure
// below confirmed a pullback (a bearish / bullish CH for internal, i-BOS for swing).
// Returns [break (+1 / -1 / 0), trend flipped, broken level, its bar, new strong point, its bar]
method step(Lvl s, bool fixH, bool fixL) =>
    int   ev   = 0
    bool  flip = false
    float bl   = na
    int   bp   = na
    float np   = na
    int   npb  = na
    if s.dir == 0
        // start: the first confirmed pullback sets the direction
        if fixL
            [m, mb] = f_lo_since(bar_index - 20)
            s.dir := 1
            s.lo := m
            s.lb := mb
            s.lf := true
            s.hi := high
            s.hb := bar_index
            s.hf := false
        else if fixH
            [m, mb] = f_hi_since(bar_index - 20)
            s.dir := -1
            s.hi := m
            s.hb := mb
            s.hf := true
            s.lo := low
            s.lb := bar_index
            s.lf := false
    else if s.dir == 1
        if not s.hf and high >= s.hi
            s.hi := high
            s.hb := bar_index
        if fixH
            s.hf := true
        if close < s.lo
            // the strong low broke: the high that took it out is the strong high
            ev   := -1
            flip := true
            bl   := s.lo
            bp   := s.lb
            [m, mb] = f_hi_since(s.lb)
            s.dir := -1
            s.hi := m
            s.hb := mb
            s.hf := true
            s.lo := low
            s.lb := bar_index
            s.lf := false
            np  := m
            npb := mb
        else if s.hf and close > s.hi
            // break of the fixed high: the low that caused it is the new strong low
            ev := 1
            bl := s.hi
            bp := s.hb
            [m, mb] = f_lo_since(s.hb)
            s.lo := m
            s.lb := mb
            s.lf := true
            s.hi := high
            s.hb := bar_index
            s.hf := false
            np  := m
            npb := mb
    else
        if not s.lf and low <= s.lo
            s.lo := low
            s.lb := bar_index
        if fixL
            s.lf := true
        if close > s.hi
            ev   := 1
            flip := true
            bl   := s.hi
            bp   := s.hb
            [m, mb] = f_lo_since(s.hb)
            s.dir := 1
            s.lo := m
            s.lb := mb
            s.lf := true
            s.hi := high
            s.hb := bar_index
            s.hf := false
            np  := m
            npb := mb
        else if s.lf and close < s.lo
            ev := -1
            bl := s.lo
            bp := s.lb
            [m, mb] = f_hi_since(s.lb)
            s.hi := m
            s.hb := mb
            s.hf := true
            s.lo := low
            s.lb := bar_index
            s.lf := false
            np  := m
            npb := mb
    [ev, flip, bl, bp, np, npb]

// The whole engine on this timeframe's candles
f_ms(simple int fln) =>
    var Lvl IN = Lvl.new()
    var Lvl SW = Lvl.new()
    var float fh   = na
    var int   fhb  = na
    var bool  fhx  = true
    var float fl   = na
    var int   flb  = na
    var bool  flx  = true
    var int   fdir = 0
    var int   chn  = 0
    var int   inn  = 0
    var int   swn  = 0
    float ph = ta.pivothigh(high, fln, fln)
    float pl = ta.pivotlow(low, fln, fln)
    if not na(ph)
        fh  := ph
        fhb := bar_index - fln
        fhx := false
    if not na(pl)
        fl  := pl
        flb := bar_index - fln
        flx := false
    // Fractal CH: a wick beyond the latest fractal high / low that turns the fractal trend
    int   ch  = 0
    float chl = na
    int   chp = na
    if not fhx and high > fh
        fhx := true
        if fdir != 1
            fdir := 1
            ch   := 1
            chl  := fh
            chp  := fhb
    if not flx and low < fl
        flx := true
        if fdir != -1
            fdir := -1
            ch   := -1
            chl  := fl
            chp  := flb
    if ch != 0
        chn += 1
    [iev, ifl, ibl, ibp, inp, inpb] = IN.step(ch == -1, ch == 1)
    if iev != 0
        inn += 1
    [sev, sfl, sbl, sbp, snp, snpb] = SW.step(iev == -1, iev == 1)
    if sev != 0
        swn += 1
    float ipt = na
    float ipo = na
    int   ipq = na
    if iev != 0 and not na(inpb)
        [a1, a2, a3] = f_poi(iev == 1, inpb)
        ipt := a1
        ipo := a2
        ipq := a3
    float spt = na
    float spo = na
    int   spq = na
    if sev != 0 and not na(snpb)
        [b1, b2, b3] = f_poi(sev == 1, snpb)
        spt := b1
        spo := b2
        spq := b3
    [fdir, fh, f_tb(fhb), fl, f_tb(flb), ch, chl, f_tb(chp), chn, time,
     IN.dir, IN.hi, f_tb(IN.hb), IN.hf, IN.lo, f_tb(IN.lb), IN.lf, iev, ifl, ibl, f_tb(ibp), inp, f_tb(inpb), ipt, ipo, ipq, inn,
     SW.dir, SW.hi, f_tb(SW.hb), SW.hf, SW.lo, f_tb(SW.lb), SW.lf, sev, sfl, sbl, f_tb(sbp), snp, f_tb(snpb), spt, spo, spq, swn, close, high, low]

// Another timeframe: [1] + lookahead_on = its last COMPLETED candle (no repaint)
f_ms1(simple int fln) =>
    [v_fdir, v_fh, v_fht, v_flo, v_flt, v_ch, v_chl, v_chp, v_chn, v_bt, v_idir, v_ihi, v_iht, v_ihf, v_ilo, v_ilt, v_ilf, v_iev, v_ifl, v_ibl, v_ibp, v_inp, v_inpt, v_ipt, v_ipo, v_ipq, v_in_, v_sdir, v_shi, v_sht, v_shf, v_slo, v_slt, v_slf, v_sev, v_sfl, v_sbl, v_sbp, v_snp, v_snpt, v_spt, v_spo, v_spq, v_sn, v_cl, v_hh, v_ll] = f_ms(fln)
    [v_fdir[1], v_fh[1], v_fht[1], v_flo[1], v_flt[1], v_ch[1], v_chl[1], v_chp[1], v_chn[1], v_bt[1], v_idir[1], v_ihi[1], v_iht[1], v_ihf[1], v_ilo[1], v_ilt[1], v_ilf[1], v_iev[1], v_ifl[1], v_ibl[1], v_ibp[1], v_inp[1], v_inpt[1], v_ipt[1], v_ipo[1], v_ipq[1], v_in_[1], v_sdir[1], v_shi[1], v_sht[1], v_shf[1], v_slo[1], v_slt[1], v_slf[1], v_sev[1], v_sfl[1], v_sbl[1], v_sbp[1], v_snp[1], v_snpt[1], v_spt[1], v_spo[1], v_spq[1], v_sn[1], v_cl[1], v_hh[1], v_ll[1]]

[C_fdir, C_fh, C_fht, C_flo, C_flt, C_ch, C_chl, C_chp, C_chn, C_bt, C_idir, C_ihi, C_iht, C_ihf, C_ilo, C_ilt, C_ilf, C_iev, C_ifl, C_ibl, C_ibp, C_inp, C_inpt, C_ipt, C_ipo, C_ipq, C_in_, C_sdir, C_shi, C_sht, C_shf, C_slo, C_slt, C_slf, C_sev, C_sfl, C_sbl, C_sbp, C_snp, C_snpt, C_spt, C_spo, C_spq, C_sn, C_cl, C_hh, C_ll] = f_ms(flen)
[Hs_fdir, Hs_fh, Hs_fht, Hs_flo, Hs_flt, Hs_ch, Hs_chl, Hs_chp, Hs_chn, Hs_bt, Hs_idir, Hs_ihi, Hs_iht, Hs_ihf, Hs_ilo, Hs_ilt, Hs_ilf, Hs_iev, Hs_ifl, Hs_ibl, Hs_ibp, Hs_inp, Hs_inpt, Hs_ipt, Hs_ipo, Hs_ipq, Hs_in_, Hs_sdir, Hs_shi, Hs_sht, Hs_shf, Hs_slo, Hs_slt, Hs_slf, Hs_sev, Hs_sfl, Hs_sbl, Hs_sbp, Hs_snp, Hs_snpt, Hs_spt, Hs_spo, Hs_spq, Hs_sn, Hs_cl, Hs_hh, Hs_ll] = request.security(syminfo.tickerid, htf, f_ms1(flen), lookahead = barmerge.lookahead_on)
[Ms_fdir, Ms_fh, Ms_fht, Ms_flo, Ms_flt, Ms_ch, Ms_chl, Ms_chp, Ms_chn, Ms_bt, Ms_idir, Ms_ihi, Ms_iht, Ms_ihf, Ms_ilo, Ms_ilt, Ms_ilf, Ms_iev, Ms_ifl, Ms_ibl, Ms_ibp, Ms_inp, Ms_inpt, Ms_ipt, Ms_ipo, Ms_ipq, Ms_in_, Ms_sdir, Ms_shi, Ms_sht, Ms_shf, Ms_slo, Ms_slt, Ms_slf, Ms_sev, Ms_sfl, Ms_sbl, Ms_sbp, Ms_snp, Ms_snpt, Ms_spt, Ms_spo, Ms_spq, Ms_sn, Ms_cl, Ms_hh, Ms_ll] = request.security(syminfo.tickerid, mtf, f_ms1(flen), lookahead = barmerge.lookahead_on)
// When the chart IS the HTF / MTF, use its own candles (no one-candle delay)
bool H_eq = timeframe.in_seconds(htf) == timeframe.in_seconds()
bool M_eq = timeframe.in_seconds(mtf) == timeframe.in_seconds()
H_fdir = H_eq ? C_fdir : Hs_fdir
H_fh = H_eq ? C_fh : Hs_fh
H_fht = H_eq ? C_fht : Hs_fht
H_flo = H_eq ? C_flo : Hs_flo
H_flt = H_eq ? C_flt : Hs_flt
H_ch = H_eq ? C_ch : Hs_ch
H_chl = H_eq ? C_chl : Hs_chl
H_chp = H_eq ? C_chp : Hs_chp
H_chn = H_eq ? C_chn : Hs_chn
H_bt = H_eq ? C_bt : Hs_bt
H_idir = H_eq ? C_idir : Hs_idir
H_ihi = H_eq ? C_ihi : Hs_ihi
H_iht = H_eq ? C_iht : Hs_iht
