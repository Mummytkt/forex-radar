     group="Labels")
color  bull_lbl_col     = input.color(color.new(color.green, 60), "Bullish state label color",
     tooltip="Background color of the state label when direction is bullish (BREAKOUT / awaiting retest)",
     group="Labels")
color  bear_lbl_col     = input.color(color.new(color.red,   60), "Bearish state label color",
     tooltip="Background color of the state label when direction is bearish (BREAKOUT / awaiting retest)",
     group="Labels")
// Label colours — each picker has an opacity slider
const string GLC = "Label colors (use the opacity slider to fade them)"
color  retest_lbl_col   = input.color(color.orange, "State label: Retest", group = GLC)
color  conf_lbl_col     = input.color(color.teal,   "State label: Confirmed · H4 aligned", group = GLC)
