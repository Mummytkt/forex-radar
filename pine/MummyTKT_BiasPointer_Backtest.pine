color  h4oc_lbl_col     = input.color(color.new(color.teal,   45), "H4.OC", group = GLC, inline = "hl")

// ── Daily structure lines (most recent external high / low) ─────────────────
const string GS1 = "External levels"
bool   show_ext = input.bool(true, "Show external high / low", group = GS1)
color  c_eh  = input.color(#E0E0E0, "External high", group = GS1, inline = "eh")
