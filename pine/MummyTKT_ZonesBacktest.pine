color  al_cwc   = input.color(color.new(#00C853, 15), "With", group = G_AL, inline = "ac")
color  al_cac   = input.color(color.new(#E53935, 15), "Against", group = G_AL, inline = "ac")
color  al_tx    = input.color(color.white, "Text", group = G_AL, inline = "ac")
bool   rz_on    = input.bool(true, "Show the reaction zones of the current breakout leg", group = G_RZ)
bool   rz_fvg   = input.bool(true, "FVG", group = G_RZ, inline = "z1")
color  rz_fvc   = input.color(color.new(#7E57C2, 80), "", group = G_RZ, inline = "z1")
bool   rz_oc    = input.bool(true, "OC", group = G_RZ, inline = "z2")
color  rz_occ   = input.color(#26A69A, "", group = G_RZ, inline = "z2")
bool   rz_av    = input.bool(true, "V-shape (sells: A-shape)", group = G_RZ, inline = "z3")
color  rz_avc   = input.color(#FFB300, "", group = G_RZ, inline = "z3")
string rz_sty   = input.string("Dotted", "Line style", options = ["Solid", "Dashed", "Dotted"], group = G_RZ, inline = "z4")
int    rz_w     = input.int(1, "width", minval = 1, maxval = 4, group = G_RZ, inline = "z4")
int    rz_n     = input.int(12, "Zones shown (newest first)", minval = 1, maxval = 30, group = G_RZ)
int    rz_op    = input.int(25, "Zone box opacity %", minval = 0, maxval = 100, group = G_RZ)

string T1 = plan == "W → D → H4" ? "W" : plan == "D → H4 → M15" ? "D" : plan == "H4 → M15 → M5" ? "240" : cu_t1
string T2 = plan == "W → D → H4" ? "D" : plan == "D → H4 → M15" ? "240" : plan == "H4 → M15 → M5" ? "15" : cu_t2
string T3 = plan == "W → D → H4" ? "240" : plan == "D → H4 → M15" ? "15" : plan == "H4 → M15 → M5" ? "5" : cu_t3
f_tfn(string tf) =>
    int s = timeframe.in_seconds(tf)
    s >= 2419200 ? "Monthly" : s == 604800 ? "Weekly" : s == 86400 ? "Daily" : s % 3600 == 0 ? "H" + str.tostring(math.round(s / 3600)) : "M" + str.tostring(math.round(s / 60))
string N1 = f_tfn(T1)
string N2 = f_tfn(T2)
string A1 = N1 == "Daily" ? "D" : N1 == "Weekly" ? "W" : N1 == "Monthly" ? "M" : N1
f_ab(string full, string ab) =>
    ab_on ? ab : full
string PLAN = N1 + " → " + N2 + " → " + f_tfn(T3)

f_sz(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : size.small
f_sty(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

// A break: a wick beyond the level (default) or a body close
f_cu(bool w) =>
    w ? high : close
f_cd(bool w) =>
    w ? low : close

// High / low of the daily candle i bars back: body top / bottom, or wick.
f_bh(int i, bool bd) =>
    bd ? math.max(open[i], close[i]) : high[i]
f_bl(int i, bool bd) =>
    bd ? math.min(open[i], close[i]) : low[i]

f_lowest(int from_bar, bool bd) =>
    float m = f_bl(0, bd)
    int mb = bar_index
    int n = math.min(bar_index - from_bar, 1500)
    for i = 0 to n
        if f_bl(i, bd) < m
            m := f_bl(i, bd)
            mb := bar_index - i
    [m, mb]

f_highest(int from_bar, bool bd) =>
    float m = f_bh(0, bd)
    int mb = bar_index
    int n = math.min(bar_index - from_bar, 1500)
    for i = 0 to n
        if f_bh(i, bd) > m
            m := f_bh(i, bd)
            mb := bar_index - i
    [m, mb]

f_bt(int b) =>
    time[bar_index - b]
// keep enough history of time for f_bt (a structure point can be far back on Daily replays)
max_bars_back(time, 2000)

type Layer
    string dir = "none"
    float  hi = na
    int    hi_bar = na
    int    hi_t = na
    float  lo = na
    int    lo_bar = na
    int    lo_t = na
    bool   hi_fixed = false
    bool   lo_fixed = false
    float  pb_hi = na
    float  pb_lo = na

method set_hi(Layer s, float v, int b) =>
    s.hi := v
    s.hi_bar := b
    s.hi_t := f_bt(b)

method set_lo(Layer s, float v, int b) =>
    s.lo := v
    s.lo_bar := b
    s.lo_t := f_bt(b)

method reset(Layer s) =>
    s.dir := "none"
    s.hi := na
    s.lo := na
    s.hi_fixed := false
    s.lo_fixed := false
    s.pb_hi := na
    s.pb_lo := na

// One daily candle of structure logic inside [blo, bhi].
// Returns [changed, broken level, time that level formed]; changed = a break
// redefined this layer.
method step(Layer s, float blo, float bhi, float lA, int lAb, bool lAok, float lV, int lVb, bool lVok, bool bd, bool bw) =>
    bool  ev   = false
    float blvl = na
    int   bt   = na
    if s.dir == "none"
        if not na(lA) and lAok and f_cu(bw) > lA
            [m, mb] = f_lowest(lAb, bd)
            if m > blo and m < bhi
                s.dir := "bull"
                s.set_lo(m, mb)
                s.set_hi(f_bh(0, bd), bar_index)
                s.hi_fixed := false
                s.pb_lo := lV
                ev := true
                blvl := lA
                bt := f_bt(lAb)
        else if not na(lV) and lVok and f_cd(bw) < lV
            [m, mb] = f_highest(lVb, bd)
            if m > blo and m < bhi
                s.dir := "bear"
                s.set_hi(m, mb)
                s.set_lo(f_bl(0, bd), bar_index)
                s.lo_fixed := false
                s.pb_hi := lA
                ev := true
                blvl := lV
                bt := f_bt(lVb)
    else if s.dir == "bull"
        if f_cd(bw) < s.lo
            blvl := s.lo
            bt := s.lo_t
            s.dir := "bear"
            s.set_lo(f_bl(0, bd), bar_index)
            s.lo_fixed := false
            s.pb_hi := lA
            ev := true
        else if s.hi_fixed and f_cu(bw) > s.hi
            blvl := s.hi
            bt := s.hi_t
            [m, mb] = f_lowest(s.hi_bar, bd)
            s.set_lo(m, mb)
            s.set_hi(f_bh(0, bd), bar_index)
            s.hi_fixed := false
            s.pb_lo := lV
            ev := true
        else
            if not s.hi_fixed and f_bh(0, bd) > s.hi
                s.set_hi(f_bh(0, bd), bar_index)
            if not s.hi_fixed and not na(s.pb_lo) and f_cd(bw) < s.pb_lo
                s.hi_fixed := true
    else if s.dir == "bear"
        if f_cu(bw) > s.hi
            blvl := s.hi
            bt := s.hi_t
            s.dir := "bull"
            s.set_hi(f_bh(0, bd), bar_index)
            s.hi_fixed := false
            s.pb_lo := lV
            ev := true
        else if s.lo_fixed and f_cd(bw) < s.lo
            blvl := s.lo
            bt := s.lo_t
            [m, mb] = f_highest(s.lo_bar, bd)
            s.set_hi(m, mb)
            s.set_lo(f_bl(0, bd), bar_index)
            s.lo_fixed := false
            s.pb_hi := lA
            ev := true
        else
            if not s.lo_fixed and f_bl(0, bd) < s.lo
                s.set_lo(f_bl(0, bd), bar_index)
            if not s.lo_fixed and not na(s.pb_hi) and f_cu(bw) > s.pb_hi
                s.lo_fixed := true
    [ev, blvl, bt]

method on_new_A(Layer s, float a) =>
    if s.dir == "bear" and not s.lo_fixed and na(s.pb_hi)
        s.pb_hi := a

method on_new_V(Layer s, float v) =>
    if s.dir == "bull" and not s.hi_fixed and na(s.pb_lo)
        s.pb_lo := v

f_structure(bool bd, bool bw) =>
    // reserve 2000 candles of time history in the requested (Daily / Weekly) context for f_bt
    int t_keep = time[2000]
    // Outer structure
    var string e_dir = "none"
    var float  e_hi = na
    var int    e_hi_bar = na
    var int    e_hi_t = na
    var float  e_lo = na
    var int    e_lo_bar = na
    var int    e_lo_t = na
    var bool   e_hif = false
    var bool   e_lof = false
    var float  e_pbh = na
    var float  e_pbl = na
    // Structures inside it, outermost first; the last one is the most recent
    var array<Layer> stack = array.new<Layer>()
    // Latest unbroken A / V shapes (body or wick levels)
    var float  lastA = na
    var int    lastA_bar = na
    var float  lastA_bear_lo = na
    var bool   lastA_ok = false
    var float  lastV = na
    var int    lastV_bar = na
    var float  lastV_bull_hi = na
    var bool   lastV_ok = false
    // D.A / D.V shown on the chart (latest A / V shape)
    var float  da = na
    var int    da_t = na
    var float  dv = na
    var int    dv_t = na
    // Most recent break on any structure
    var int    b_cnt = 0
    var string b_dir = "none"
    var float  b_lvl = na
    var float  b_opp = na
    var int    b_t = na    // when the broken level formed

    bool  ext_ev = false
    float e_blvl = na
    int   e_bt = na

    // 1. Outer structure
    if e_dir == "none"
        if not na(lastA) and f_cu(bw) > lastA
            e_blvl := lastA
            e_bt := f_bt(lastA_bar)
            [m, mb] = f_lowest(lastA_bar, bd)
            e_lo := m, e_lo_bar := mb, e_lo_t := f_bt(mb)
            e_hi := f_bh(0, bd), e_hi_bar := bar_index, e_hi_t := time
            e_dir := "bull", e_hif := false
            ext_ev := true
        else if not na(lastV) and f_cd(bw) < lastV
            e_blvl := lastV
            e_bt := f_bt(lastV_bar)
            [m, mb] = f_highest(lastV_bar, bd)
            e_hi := m, e_hi_bar := mb, e_hi_t := f_bt(mb)
            e_lo := f_bl(0, bd), e_lo_bar := bar_index, e_lo_t := time
            e_dir := "bear", e_lof := false
            ext_ev := true
    else if e_dir == "bull"
        if f_cd(bw) < e_lo
            e_blvl := e_lo
            e_bt := e_lo_t
            e_dir := "bear"
            e_lo := f_bl(0, bd), e_lo_bar := bar_index, e_lo_t := time
            e_lof := false
            ext_ev := true
        else if e_hif and f_cu(bw) > e_hi
            e_blvl := e_hi
            e_bt := e_hi_t
            [m, mb] = f_lowest(e_hi_bar, bd)
            e_lo := m, e_lo_bar := mb, e_lo_t := f_bt(mb)
            e_hi := f_bh(0, bd), e_hi_bar := bar_index, e_hi_t := time
            e_hif := false
            ext_ev := true
        else
            if not e_hif and f_bh(0, bd) > e_hi
                e_hi := f_bh(0, bd), e_hi_bar := bar_index, e_hi_t := time
            if not e_hif and not na(e_pbl) and f_cd(bw) < e_pbl
                e_hif := true
    else if e_dir == "bear"
        if f_cu(bw) > e_hi
            e_blvl := e_hi
            e_bt := e_hi_t
            e_dir := "bull"
            e_hi := f_bh(0, bd), e_hi_bar := bar_index, e_hi_t := time
            e_hif := false
            ext_ev := true
        else if e_lof and f_cd(bw) < e_lo
            e_blvl := e_lo
            e_bt := e_lo_t
            [m, mb] = f_highest(e_lo_bar, bd)
            e_hi := m, e_hi_bar := mb, e_hi_t := f_bt(mb)
            e_lo := f_bl(0, bd), e_lo_bar := bar_index, e_lo_t := time
            e_lof := false
            ext_ev := true
        else
            if not e_lof and f_bl(0, bd) < e_lo
                e_lo := f_bl(0, bd), e_lo_bar := bar_index, e_lo_t := time
            if not e_lof and not na(e_pbh) and f_cu(bw) > e_pbh
                e_lof := true

    if ext_ev
        e_pbh := na, e_pbl := na
        array.clear(stack)
        b_cnt += 1
        b_dir := e_dir == "bull" ? "bullish" : "bearish"
        b_lvl := e_blvl
        b_t   := e_bt
        b_opp := e_dir == "bull" ? e_lo : e_hi

    // 2. Structures inside it, from the outside in. A break drops everything
    //    inside the structure that broke; if nothing broke, look for a new
    //    structure inside the most recent range.
    if not na(lastA) and not lastA_ok and f_bl(0, bd) < lastA_bear_lo
        lastA_ok := true
    if not na(lastV) and not lastV_ok and f_bh(0, bd) > lastV_bull_hi
        lastV_ok := true

    if not ext_ev and e_dir != "none"
        float blo = e_lo
        float bhi = e_hi
        bool broke = false
        int n = array.size(stack)
        if n > 0
            for k = 0 to n - 1
                Layer L = array.get(stack, k)
                [ev, lvl, lt] = L.step(blo, bhi, lastA, lastA_bar, lastA_ok, lastV, lastV_bar, lastV_ok, bd, bw)
                if ev
                    while array.size(stack) > k + 1
                        array.pop(stack)
                    broke := true
                    b_cnt += 1
                    b_dir := L.dir == "bull" ? "bullish" : "bearish"
                    b_lvl := lvl
                    b_t   := lt
                    b_opp := L.dir == "bull" ? L.lo : L.hi
                    break
                blo := L.lo
                bhi := L.hi
        if not broke and array.size(stack) < 30
            Layer nl = Layer.new()
            [nev, nlvl, nlt] = nl.step(blo, bhi, lastA, lastA_bar, lastA_ok, lastV, lastV_bar, lastV_ok, bd, bw)
            if nev
                array.push(stack, nl)
                b_cnt += 1
                b_dir := nl.dir == "bull" ? "bullish" : "bearish"
                b_lvl := nlvl
                b_t   := nlt
                b_opp := nl.dir == "bull" ? nl.lo : nl.hi

    // Clear broken shapes / outer pullback triggers
    if not na(lastA) and f_cu(bw) > lastA
        lastA := na
    if not na(lastV) and f_cd(bw) < lastV
        lastV := na
    if not na(e_pbh) and f_cu(bw) > e_pbh
        e_pbh := na
    if not na(e_pbl) and f_cd(bw) < e_pbl
        e_pbl := na

    // 3. Register new A / V shapes
    bool isA = close[1] > open[1] and close < open
    bool isV = close[1] < open[1] and close > open
    if isA
        lastA := math.max(f_bh(0, bd), f_bh(1, bd))
        lastA_bar := f_bh(0, bd) >= f_bh(1, bd) ? bar_index : bar_index - 1
        lastA_bear_lo := f_bl(0, bd)
        lastA_ok := false
        da := lastA, da_t := f_bt(lastA_bar)
        if e_dir != "none"
            e_pbh := lastA
        for L in stack
            L.on_new_A(lastA)
    if isV
        lastV := math.min(f_bl(0, bd), f_bl(1, bd))
        lastV_bar := f_bl(0, bd) <= f_bl(1, bd) ? bar_index : bar_index - 1
        lastV_bull_hi := f_bh(0, bd)
        lastV_ok := false
        dv := lastV, dv_t := f_bt(lastV_bar)
        if e_dir != "none"
            e_pbl := lastV
        for L in stack
            L.on_new_V(lastV)

    // 4. The most recent structure (what the chart shows as External high / low)
    string c_dir = e_dir
    float  c_hi  = e_hi
    float  c_lo  = e_lo
    bool   c_hif = e_hif
    bool   c_lof = e_lof
    int    c_hit = e_hi_t
    int    c_lot = e_lo_t
    if array.size(stack) > 0
        Layer cur = array.last(stack)
        c_dir := cur.dir
        c_hi  := cur.hi
        c_lo  := cur.lo
        c_hif := cur.hi_fixed
        c_lof := cur.lo_fixed
        c_hit := cur.hi_t
        c_lot := cur.lo_t
    // [1] + lookahead_on = state after the last COMPLETED daily candle (no repaint)
    [c_dir[1], c_hi[1], c_lo[1], c_hif[1], c_lof[1], c_hit[1], c_lot[1],
     b_cnt[1], b_dir[1], b_lvl[1], b_opp[1],
     da[1], da_t[1], dv[1], dv_t[1], b_t[1] + 0 * nz(t_keep)]

// ── Candles of each timeframe (the last closed one) ──────────────────────────
f_cnd() =>
    [open[1], high[1], low[1], close[1], time[1]]
[a_cdir, a_chi, a_clo, a_chif, a_clof, a_chit, a_clot, a_bcnt, a_bdir, a_blvl, a_bopp, a_da, a_dat, a_dv, a_dvt, a_bt] = request.security(syminfo.tickerid, T1, f_structure(d_body, t1_wick), lookahead = barmerge.lookahead_on)
[x1o, x1h, x1l, x1c, x1t] = request.security(syminfo.tickerid, T1, f_cnd(), lookahead = barmerge.lookahead_on)
[x2o, x2h, x2l, x2c, x2t] = request.security(syminfo.tickerid, T2, f_cnd(), lookahead = barmerge.lookahead_on)
// the story-timeframe candle's high / low for the story lines (body or wick, per "Story-timeframe levels from")
float x2H = h2_body ? math.max(x2o, x2c) : x2h
float x2L = h2_body ? math.min(x2o, x2c) : x2l
bool x1_new  = not na(x1t) and x1t != nz(x1t[1])
bool x2_new  = not na(x2t) and x2t != nz(x2t[1])
bool chart_ok = timeframe.in_seconds() <= timeframe.in_seconds(T2)
int  AD = a_bdir == "bullish" ? 1 : a_bdir == "bearish" ? -1 : 0

// a beyond b in direction d (d > 0: above, d < 0: below)
f_gt(float a, float b, int d) =>
    d > 0 ? a > b : a < b

// candle history of both timeframes (high, low, time)
var array<float> q1h = array.new<float>()
var array<float> q1l = array.new<float>()
var array<int>   q1t = array.new<int>()
var array<float> q2h = array.new<float>()
var array<float> q2l = array.new<float>()
var array<int>   q2t = array.new<int>()
var array<float> q2c = array.new<float>()
var array<float> q2o = array.new<float>()
var array<float> q2hw = array.new<float>()   // wick high / low (where the pullback line is drawn)
var array<float> q2lw = array.new<float>()
if x1_new
    array.push(q1h, x1h)
    array.push(q1l, x1l)
    array.push(q1t, x1t)
    if array.size(q1t) > 600
        array.shift(q1h)
        array.shift(q1l)
        array.shift(q1t)
if x2_new
    array.push(q2h, x2H)
    array.push(q2l, x2L)
    array.push(q2t, x2t)
    array.push(q2c, x2c)
    array.push(q2o, x2o)
    array.push(q2hw, x2h)
    array.push(q2lw, x2l)
    if array.size(q2t) > 1500
        array.shift(q2c)
        array.shift(q2o)
        array.shift(q2hw)
        array.shift(q2lw)
        array.shift(q2h)
        array.shift(q2l)
        array.shift(q2t)
// the highest high (hiSide) / lowest low of the story-timeframe candles from time t0 on
f_ext2(int t0, bool hiSide) =>
    float v  = na
    int   vt = na
    int   n  = array.size(q2t)
    if n > 0 and not na(t0)
        int k = n - 1
        while k >= 0 and array.get(q2t, k) >= t0
            float x = hiSide ? array.get(q2h, k) : array.get(q2l, k)
            if na(v) or (hiSide ? x > v : x < v)
                v  := x
                vt := array.get(q2t, k)
            k -= 1
    [v, vt]
// the wick high (hiSide) / low of the story-timeframe candle that opened at time t
f_wk(int t, bool hiSide) =>
    float v = na
    int   n = array.size(q2t)
    if n > 0 and not na(t)
        int k = n - 1
        while k >= 0 and array.get(q2t, k) > t
            k -= 1
        if k >= 0 and array.get(q2t, k) == t
            v := hiSide ? array.get(q2hw, k) : array.get(q2lw, k)
    v
// where the pullback line is drawn: on the wick, unless it sits on a broken high / low (it is that level itself)
f_lw(int t, float ln, bool bk, bool hiSide) =>
    bk ? ln : nz(f_wk(t, hiSide), ln)
// the tracker replayed over the story-timeframe candles from time t0, in direction w: the running
// extreme, the opposite extreme since it, and the last opposite extreme that made a new extreme
f_replay(int t0, int w_) =>
    float ex = na
    int   ext = na
    float dp = na
    int   dpt = na
    float ln = na
    int   lnt = na
    int   n = array.size(q2t)
    if n > 0 and not na(t0)
        int k = n - 1
        while k > 0 and array.get(q2t, k - 1) >= t0
            k -= 1
        for j = k to n - 1
            float ce = w_ > 0 ? array.get(q2h, j) : array.get(q2l, j)
            float co = w_ > 0 ? array.get(q2l, j) : array.get(q2h, j)
            float cc = array.get(q2c, j)
            // a new extreme counts (moves the line) only on a body close beyond it; a wick only extends it
            if na(ex) or (w_ > 0 ? cc > ex : cc < ex)
                if not na(dp)
                    ln  := dp
                    lnt := dpt
                ex  := ce
                ext := array.get(q2t, j)
                dp  := na
            else if w_ > 0 ? ce > ex : ce < ex
                ex  := ce
                ext := array.get(q2t, j)
                if na(dp) or (w_ > 0 ? co < dp : co > dp)
                    dp  := co
                    dpt := array.get(q2t, j)
            else if na(dp) or (w_ > 0 ? co < dp : co > dp)
                dp  := co
                dpt := array.get(q2t, j)
    [ex, ext, dp, dpt, ln, lnt]
// the top timeframe: lowSide = a broken LOW -> the highest high since it first formed; else a broken
// HIGH -> the lowest low since it first formed (an equal level up to 15 candles earlier counts)
f_since(bool lowSide, float lvl, int t0, float tol) =>
    int   n  = array.size(q1t)
    float v  = na
    int   vt = na
    if n > 0 and not na(lvl) and not na(t0)
        int s0 = n - 1
        while s0 > 0 and array.get(q1t, s0 - 1) >= t0
            s0 -= 1
        int k = s0 - 1
        int stop_ = math.max(0, s0 - 15)
        while k >= stop_
            float kh = array.get(q1h, k)
            float kl = array.get(q1l, k)
            if lowSide ? kl < lvl - tol : kh > lvl + tol
                break
            if lowSide ? math.abs(kl - lvl) <= tol : math.abs(kh - lvl) <= tol
                s0 := k
            k -= 1
        for j = s0 to n - 1
            float x = lowSide ? array.get(q1h, j) : array.get(q1l, j)
            if na(v) or (lowSide ? x > v : x < v)
                v  := x
                vt := array.get(q1t, j)
    [v, vt]

// ── Story-timeframe External breaks (as the Bias Pointer): a body close above the last A-shape (body
// top) that formed before the leg's pullback low (sells: below the last V-shape before the high).
// After a break only newer A-shapes count. These are the "cont" breaks.
var array<float> xa_l = array.new<float>()
var array<int>   xa_t = array.new<int>()
var array<float> xv_l = array.new<float>()
var array<int>   xv_t = array.new<int>()
var float u_hh  = na
var float u_pl  = na
var int   u_plt = na
var float d_ll  = na
var float d_ph  = na
var int   d_pht = na
var float u_plb = na      // the same pullback low / high read on the story-line side (body or wick)
var float d_phb = na
var float p2o   = na
var float p2c   = na
bool  ub     = false
float ub_lvl = na
int   ub_lt  = na
bool  db     = false
float db_lvl = na
float ub_pl  = na      // at an External break up: the last low that broke the high (sells: db_ph, the last high that broke the low)
int   ub_plt = na
float db_ph  = na
int   db_pht = na
int   db_lt  = na
f_last(array<float> l, array<int> t, int maxt) =>
    float v = na
    int   vt = na
    if array.size(l) > 0
        for i = array.size(l) - 1 to 0
            if array.get(t, i) <= maxt
                v := array.get(l, i)
                vt := array.get(t, i)
                break
    [v, vt]
float c2u = t2_wick ? x2h : x2c
float c2d = t2_wick ? x2l : x2c
if x2_new
    bool  nl  = na(u_pl) or x2l < u_pl
    int   plt = nl ? x2t : u_plt
    [ea, eat] = f_last(xa_l, xa_t, nl ? x2t - 1 : plt)
    if not na(u_hh) and not na(ea) and c2u > ea
        ub     := true
        ub_lvl := ea
        ub_lt  := eat
        ub_pl  := na(u_pl) ? x2L : u_plb
        ub_plt := na(u_pl) ? x2t : u_plt
        array.clear(xa_l)
        array.clear(xa_t)
        u_hh := x2h
        u_pl := na
        u_plb := na
    bool  nh  = na(d_ph) or x2h > d_ph
    int   pht = nh ? x2t : d_pht
    [ev, evt] = f_last(xv_l, xv_t, nh ? x2t - 1 : pht)
    if not na(d_ll) and not na(ev) and c2d < ev
        db     := true
        db_lvl := ev
        db_lt  := evt
        db_ph  := na(d_ph) ? x2H : d_phb
        db_pht := na(d_ph) ? x2t : d_pht
        array.clear(xv_l)
        array.clear(xv_t)
        d_ll := x2l
        d_ph := na
        d_phb := na
    if not na(p2o)
        if p2c > p2o and x2c < x2o
            array.push(xa_l, math.max(p2o, p2c))
            array.push(xa_t, x2t)
        if p2c < p2o and x2c > x2o
            array.push(xv_l, math.min(p2o, p2c))
            array.push(xv_t, x2t)
    if not ub
        if na(u_hh) or x2h > u_hh
            u_hh := x2h
            u_pl := na
            u_plb := na
        else
            if na(u_pl) or x2l < u_pl
                u_pl  := x2l
                u_plt := x2t
            u_plb := na(u_plb) ? x2L : math.min(u_plb, x2L)
    if not db
        if na(d_ll) or x2l < d_ll
            d_ll := x2l
            d_ph := na
            d_phb := na
        else
            if na(d_ph) or x2h > d_ph
                d_ph  := x2h
                d_pht := x2t
            d_phb := na(d_phb) ? x2H : math.max(d_phb, x2H)
    p2o := x2o
    p2c := x2c

// ── Drawing helpers ──────────────────────────────────────────────────────────
f_tcol(color c) =>
    color.new(c, 100 - (100 - color.t(c)) * tg_op / 100)
var array<label> tg_bl = array.new<label>()   // top-timeframe breakouts
var array<label> tg_pl = array.new<label>()   // pullback breaks
var array<label> tg_al_ = array.new<label>()  // story-timeframe pullbacks (back in alignment)
f_tag(array<label> arr, int t, float y, string txt, bool above, color c) =>
    if chart_ok and not na(t) and not na(y)
        array.push(arr, label.new(t, y, txt, xloc = xloc.bar_time, style = above ? label.style_label_down : label.style_label_up,
             color = f_tcol(c), textcolor = tg_tx, size = f_sz(tg_sz)))
        while array.size(arr) > tg_n
            label.delete(array.shift(arr))
var array<line>  br_l = array.new<line>()
var array<label> br_b = array.new<label>()
f_brk(int t1, float y, string txt, bool above, color c) =>
    if chart_ok and not na(t1) and not na(y)
        array.push(br_l, line.new(t1, y, time, y, xloc = xloc.bar_time, color = c, style = f_sty(br_sty), width = br_w))
        array.push(br_b, label.new(t1 + int((time - t1) / 2), y, txt, xloc = xloc.bar_time, style = above ? label.style_label_down : label.style_label_up,
             color = color.new(color.black, 100), textcolor = br_tx, size = f_sz(br_sz)))
        while array.size(br_l) > br_n
            line.delete(array.shift(br_l))
        while array.size(br_b) > br_n
            label.delete(array.shift(br_b))
f_bro(int t1, float y, string txt, bool above, color c) =>
    if br_ot
        f_brk(t1, y, txt, above, c)

var array<label> st_l = array.new<label>()
var st_last = array.from("")
var array<string> st_h  = array.new<string>()   // the notes for the story table, newest last
var array<int>    st_ht = array.new<int>()
f_story(int t, float y, bool above, string txt) =>
    if chart_ok and not na(t) and not na(y)
        array.set(st_last, 0, txt)
        array.push(st_h, txt)
        array.push(st_ht, t)
        while array.size(st_h) > 10
            array.shift(st_h)
            array.shift(st_ht)
        if st_mode == "Dots only (hover)"
            array.push(st_l, label.new(t, y, "●", xloc = xloc.bar_time, style = label.style_none, textcolor = st_dot, size = size.tiny, tooltip = txt))
            while array.size(st_l) > st_n
                label.delete(array.shift(st_l))
        else if st_mode != "Off"
            if array.size(st_l) > 0
                label prev = array.last(st_l)
                if st_mode == "Latest note only"
                    label.delete(array.pop(st_l))
                else if st_mode == "Latest note + dots (hover)"
                    label.set_tooltip(prev, label.get_text(prev))
                    label.set_text(prev, "●")
                    label.set_style(prev, label.style_none)
                    label.set_textcolor(prev, st_dot)
                    label.set_size(prev, size.tiny)
            array.push(st_l, label.new(t, y, txt, xloc = xloc.bar_time, style = above ? label.style_label_down : label.style_label_up,
                 color = color.new(st_bg, 100 - st_op), textcolor = st_tx, size = f_sz(st_sz), textalign = text.align_left))
            while array.size(st_l) > (st_mode == "Latest note only" ? 1 : st_mode == "Latest note + dots (hover)" ? st_n + 1 : st_n)
                label.delete(array.shift(st_l))

// ── The story ────────────────────────────────────────────────────────────────
// phase: 0 none · 1 top-timeframe breakout, story timeframe with it · 2 pullback break (the story
// timeframe against it) · 3 story-timeframe pullback (back in alignment, the story-timeframe range)
var int   sph  = 0
var int   D    = 0
var int   k1   = 0
var float XH   = na      // the top timeframe's external high / low (the Bias Pointer's)
var int   XHt  = na
var float XL   = na
var int   XLt  = na
// ONE pullback line (user rule, 2026-11-03, picture Documents/Pullback_Flow.png). Direction w:
// buys (w > 0): the line = the low that broke the last high. tk_ext = the leg's high, tk_fm = price really
// pulled back from it (a body closed beyond the far side of the body of the candle that made it), tk_dip =
// the lowest point since that high. A close above a REAL high = continuation: the line moves to tk_dip
// (the low that broke the high). A close below the line = the direction flips: the line = the highest
// point since the line (the high that broke the low). Sells mirror. Nothing else moves the line.
var int   w      = 0
var float tk_ln  = na
var int   tk_lt  = na
var float tk_ext = na
var int   tk_et  = na
var float tk_eo  = na      // the far side of the body of the candle that made tk_ext
var bool  tk_fm  = false
var int   tk_cn  = 0
var float tk_pc  = na
var float tk_ph2 = na      // the previous story-timeframe candle's high / low (story-line side)
var float tk_pl2 = na
var float rl_x   = na      // the range low waiting: the extreme low of the leg that broke the last range high
var int   rl_xt  = na
var float tk_dip = na
var int   tk_dt  = na
var float rg_hi  = na      // the story-timeframe range high (buys; sells: its low): the top of the leg
var int   rg_hit = na
var float rg_lo  = na      // the story-timeframe range low (buys; sells: its high)
var int   rg_lot = na
var bool  rg_lf  = false   // the range low is still forming (price closed below the one set at the pullback)
var bool  tk_bk  = false   // the pullback line is a broken high (sells: low): no low inside the move that broke it
var bool  tk_sp  = false   // the replay ended with the old line closed through: the next continuation's line is the dip, as in the replay
var float tk_pv  = na      // the pullback line BEFORE the current one (the range low if the line breaks)
var int   tk_pvt = na
string up = D > 0 ? "up" : "down"
string dn = D > 0 ? "down" : "up"
string HI = D > 0 ? "high" : "low"
string LO = D > 0 ? "low" : "high"
string DW = D > 0 ? "bullish" : "bearish"
string AW = D > 0 ? "bearish" : "bullish"
string HC = D > 0 ? "H" : "L"
string LC = D > 0 ? "L" : "H"
string BW = D > 0 ? "Bull" : "Bear"

// the rule run over the story-timeframe candles from time t0 in direction w_ (continuations only):
// [line, line time, leg extreme, its time, its body's far side, real pullback, dip, dip time]
// inside the move from t0 on: the last low that broke a high (sells: high that broke a low), and its time
// did candle j close against direction w_? (one candle can only pull back and break if the candle before it did)
f_ag(int j, int w_) =>
    j >= 0 and (w_ > 0 ? array.get(q2c, j) < array.get(q2o, j) : array.get(q2c, j) > array.get(q2o, j))
f_inner(int t0, int w_, int jmax) =>
    float ln = na
    int   lt = na
    float ex = na
    float eo = na
    bool  fm = false
    float pc = na
    int   cn = 0
    float dp = na
    int   dt = na
    int   n = array.size(q2t)
    if n > 0 and not na(t0)
        int k = n - 1
        while k > 0 and array.get(q2t, k - 1) >= t0
            k -= 1
        for j = k to jmax
            float ce = w_ > 0 ? array.get(q2h, j) : array.get(q2l, j)
            float co = w_ > 0 ? array.get(q2l, j) : array.get(q2h, j)
            float cc = array.get(q2c, j)
            int   tj = array.get(q2t, j)
            float cw0 = w_ > 0 ? array.get(q2lw, j) : array.get(q2hw, j)
            if na(ex)
                ex := ce
                eo := co
                ln := co
                lt := tj
            else if (fm or (not na(pc) and f_gt(pc, cw0, w_) and f_ag(j - 1, w_))) and f_gt(cc, ex, w_)
                if na(dp) or f_gt(dp, co, w_)
                    dp := co
                    dt := tj
                ln := dp
                lt := dt
                ex := ce
                eo := co
                fm := false
                cn := 0
                dp := na
                dt := na
            else if f_gt(ce, ex, w_)
                ex := ce
                eo := co
                fm := false
                cn := 0
                dp := na
                dt := na
            else
                // a real pullback: a candle took out the previous candle's low (sells: high)
                float cw = w_ > 0 ? array.get(q2lw, j) : array.get(q2hw, j)
                if not na(pc) and f_gt(pc, cw, w_)
                    fm := true
                if na(dp) or f_gt(dp, co, w_)
                    dp := co
                    dt := tj
            pc := w_ > 0 ? array.get(q2lw, j) : array.get(q2hw, j)
    [ln, lt]

// the extreme each breaking leg came from (buys: its low, sells: its high), oldest first
var array<float> lg_v = array.new<float>()
var array<int>   lg_t = array.new<int>()
f_leg(float v, int t) =>
    if not na(v)
        array.push(lg_v, v)
        array.push(lg_t, t)
        if array.size(lg_v) > 60
            array.shift(lg_v)
            array.shift(lg_t)
// the far side of the range just broken: the newest leg extreme beyond the line (w_ = the direction that broke)
f_far(float ln, int w_) =>
    float v = na
    int   t = na
    int   n = array.size(lg_v)
    if n > 0 and not na(ln)
        for i = n - 1 to 0
            if f_gt(ln, array.get(lg_v, i), w_)
                v := array.get(lg_v, i)
                t := array.get(lg_t, i)
                break
    [v, t]
// the closest low (w_ < 0: high) inside the range just broken, walking back from the breaking candle: the last
// candle that took out the previous candle's low; none means the breaking candle itself
f_close(int t0, int w_) =>
    float v = na
    int   t = na
    int   n = array.size(q2t)
    if n > 0 and not na(t0)
        int k = n - 1
        while k > 0 and array.get(q2t, k) >= t0 and na(t)
            float a = w_ > 0 ? array.get(q2lw, k) : array.get(q2hw, k)
            float b = w_ > 0 ? array.get(q2lw, k - 1) : array.get(q2hw, k - 1)
            if f_gt(b, a, w_)
                v := w_ > 0 ? array.get(q2l, k) : array.get(q2h, k)
                t := array.get(q2t, k)
            k -= 1
    [v, t]

f_seed(int t0, int w_) =>
    float ln = na
    int   lt = na
    float ex = na
    int   et = na
    float eo = na
    bool  fm = false
    float pc = na
    int   cn = 0
    float dp = na
    int   dt = na
    float pv = na
    int   pvt = na
    bool  bk = false     // the line sits on a broken high (sells: low)
    bool  sp = false     // price has closed through the line: that pullback is done with, the line can't be used again
    int   n = array.size(q2t)
    if n > 0 and not na(t0)
        int k = n - 1
        while k > 0 and array.get(q2t, k - 1) >= t0
            k -= 1
        for j = k to n - 1
            float ce = w_ > 0 ? array.get(q2h, j) : array.get(q2l, j)
            float co = w_ > 0 ? array.get(q2l, j) : array.get(q2h, j)
            float cc = array.get(q2c, j)
            int   tj = array.get(q2t, j)
            float cw0 = w_ > 0 ? array.get(q2lw, j) : array.get(q2hw, j)
            if na(ex)
                ex := ce
                et := tj
                eo := co
                ln := co
                lt := tj
            else if (fm or (not na(pc) and f_gt(pc, cw0, w_) and f_ag(j - 1, w_))) and f_gt(cc, ex, w_)
                if na(dp) or f_gt(dp, co, w_)
                    dp := co
                    dt := tj
                // the range low waiting = the low the breaking move came from; the pullback line = the last
                // low inside that move that broke a high, or (none) the broken high itself
                f_leg(dp, dt)
                [il, ilt] = f_inner(dt, w_, j)
                bool inner = not na(ilt) and ilt > dt
                bool newlo = sp or (not na(ln) and f_gt(dp, ln, w_))
                pv  := ln
                pvt := lt
                ln := inner ? il : newlo ? dp : ex
                lt := inner ? ilt : newlo ? dt : et
                bk := not inner and not newlo
                sp := false
                ex := ce
                et := tj
                eo := co
                fm := false
                cn := 0
                dp := na
                dt := na
            else if f_gt(ce, ex, w_)
                ex := ce
                et := tj
                eo := co
                fm := false
                cn := 0
                dp := na
                dt := na
            else
                // a real pullback: a candle took out the previous candle's low (sells: high)
                float cw = w_ > 0 ? array.get(q2lw, j) : array.get(q2hw, j)
                if not na(pc) and f_gt(pc, cw, w_)
                    fm := true
                if na(dp) or f_gt(dp, co, w_)
                    dp := co
                    dt := tj
            if not na(ln) and f_gt(ln, cc, w_)
                sp := true
            pc := w_ > 0 ? array.get(q2lw, j) : array.get(q2hw, j)
        // still closed through when the replay ends: the line is the extreme reached since, never the finished one
        if sp and not na(dp)
            ln := dp
            lt := dt
            bk := false
    [ln, lt, ex, et, eo, fm, dp, dt, pv, pvt, bk, sp]

// a new story in direction d
int   ns_d   = 0
float ns_lo  = na
int   ns_lot = na
float ns_hi  = na
int   ns_hit = na
float ns_lvl = na
bool  t1_ev  = false
bool  a_new  = not na(a_bcnt) and a_bcnt != k1
bool  first_ = k1 == 0
if a_new
    k1 := a_bcnt
// alerts: one per event, each also marked on the chart. Only Daily -> H4 on a 4H chart reaches the server.
bool al_ok = false   // the backtest copy never sends the Bias Pointer's webhooks
// a candle already open when the script went live is not news: only candles that open after it can send
varip int rt_first = na
if barstate.isrealtime and na(rt_first)
    rt_first := time
bool al_live = barstate.isrealtime and not na(rt_first) and time > rt_first
f_hdr(string t) =>
    '{"secret":"' + wh_secret + '","type":"' + t + '","timeframe":"' + timeframe.period + '","exchange":"' + syminfo.prefix + '","instrument":"' + syminfo.ticker
f_num(float x) =>
    na(x) ? "null" : str.tostring(x)
var array<label> al_l = array.new<label>()
var bool al_rev = false   // the reversal to the story-timeframe range has happened: no more continuations against until its low breaks
// every alert (any kind) starts the zones backtest: its direction, read at the end of the candle
var array<int> zb_ev = array.from(0)
f_al(bool on, string ev, string txt, int dir, float lvl, bool with_, string ab) =>
    if on
        array.set(zb_ev, 0, dir)
        if al_live and al_ok
            alert(f_hdr("STORY") + '","event":"' + ev + '","direction":"' + (dir > 0 ? "bullish" : "bearish") + '","top":"' + (D > 0 ? "bullish" : "bearish") + '","level":' + f_num(lvl) + ',"breakout_level":' + f_num(a_blvl) + ',"pullback_line":' + f_num(f_lw(tk_lt, tk_ln, tk_bk, w < 0)) + ',"ext_hi":' + f_num(XH) + ',"ext_lo":' + f_num(XL) + ',"range_hi":' + f_num(rg_hi) + ',"range_lo":' + f_num(rg_lo) + ',"price":' + str.tostring(x2c) + '}', alert.freq_once_per_bar)
        if al_mk and chart_ok
            array.push(al_l, label.new(time, dir > 0 ? high : low, ab_on ? "! " + ab : "ALERT · " + txt, xloc = xloc.bar_time, style = dir > 0 ? label.style_label_down : label.style_label_up,
                 color = with_ ? al_cwc : al_cac, textcolor = al_tx, size = size.tiny))
            while array.size(al_l) > al_n
                label.delete(array.shift(al_l))

// 1. the top timeframe's external high / low are ALWAYS the Bias Pointer's (its most recent structure).
//    Every breakout of it starts the story again, in its direction.
if a_new and not first_ and AD != 0
    ns_d   := AD
    ns_lvl := a_blvl
    ns_lo  := a_clo
    ns_lot := a_clot
    ns_hi  := a_chi
    ns_hit := a_chit
if ns_d != 0
    t1_ev := true
    D   := ns_d
    up  := D > 0 ? "up" : "down"
    dn  := D > 0 ? "down" : "up"
    HI  := D > 0 ? "high" : "low"
    LO  := D > 0 ? "low" : "high"
    DW  := D > 0 ? "bullish" : "bearish"
    AW  := D > 0 ? "bearish" : "bullish"
    HC  := D > 0 ? "H" : "L"
    LC  := D > 0 ? "L" : "H"
    BW  := D > 0 ? "Bull" : "Bear"
    sph := 1
    XL  := ns_lo
    XLt := ns_lot
    XH  := ns_hi
    XHt := ns_hit
    rg_hi := na
    rg_lo := na
    // the rule run over this leg (from the external low's time for buys, the high's for sells)
    array.clear(lg_v)
    array.clear(lg_t)
    f_leg(D > 0 ? XL : XH, D > 0 ? XLt : XHt)
    [s_ln, s_lt, s_ex, s_et, s_eo, s_fm, s_dp, s_dt, s_pv, s_pvt, s_bk, s_sp] = f_seed(D > 0 ? XLt : XHt, D)
    tk_pv  := s_pv
    tk_pvt := s_pvt
    rl_x   := D > 0 ? XL : XH
    rl_xt  := D > 0 ? XLt : XHt
    tk_bk  := s_bk
    tk_sp  := s_sp
    rg_lf  := false
    w      := D
    tk_ln  := s_ln
    tk_lt  := s_lt
    tk_ext := s_ex
    tk_et  := s_et
    tk_eo  := s_eo
    tk_fm  := s_fm
    tk_cn  := 0
    tk_dip := s_dp
    tk_dt  := s_dt
    if tg_bo
        f_tag(tg_bl, x1t, D > 0 ? x1h : x1l, f_ab(N1 + " " + DW + " breakout", A1 + ".BO"), D > 0, tg_boc)
    al_rev := false
    f_al(al_bo, "daily_breakout", N1 + " " + DW + " breakout", D, ns_lvl, true, A1 + ".BO")
    f_story(time, D > 0 ? high : low, D > 0, N1 + " " + DW + " breakout (" + (t1_wick ? "wick" : "body close") + " beyond " + str.tostring(ns_lvl, format.mintick) + ").\nPullback line: the " + N2 + " " + LO + " that broke the last " + HI + "; it moves only when that " + HI + " breaks.\nAn " + N2 + " close beyond it = the " + N1 + " pullback.")

// the external high / low follow the Bias Pointer's every candle (a side forms until it is fixed)
if D != 0 and not na(a_chi) and not na(a_clo)
    XH  := a_chi
    XHt := a_chit
    XL  := a_clo
    XLt := a_clot

// 2. the story timeframe, candle by candle
if D != 0 and x2_new and not t1_ev and sph >= 1
    float ce = w > 0 ? x2H : x2L
    float co = w > 0 ? x2L : x2H
    string WW = w > 0 ? "bullish" : "bearish"
    // one candle can do both, after a candle against the move: its wick takes out that candle's low (sells: high), then it closes beyond the high
    if not na(tk_ext) and (tk_fm or (not na(w > 0 ? tk_pl2 : tk_ph2) and f_gt(w > 0 ? tk_pl2 : tk_ph2, w > 0 ? x2l : x2h, w) and f_ag(array.size(q2c) - 2, w))) and f_gt(x2c, tk_ext, w)
        // a REAL high broken: continuation; the line moves to the low that broke it
        if (w == D ? br_with : br_agst)
            f_brk(tk_et, tk_ext, f_ab(N2 + " " + WW + " cont", N2 + ".C"), w > 0, w == D ? br_wcol : br_acol)
        if na(tk_dip) or f_gt(tk_dip, co, w)
            tk_dip := co
            tk_dt  := x2t
        // the range low waiting = the low the breaking move came from; the pullback line = the last low
        // inside that move that broke a high, or (none: a straight run) the broken high itself
        // a NEW low (above the current line) that broke the high = the line; the move from the current line
        // itself (no new low) = the last low inside the move, or the broken high itself
        [i_ln, i_lt] = f_inner(tk_dt, w, array.size(q2t) - 1)
        bool inner_ = not na(i_lt) and i_lt > tk_dt
        bool newlo_ = tk_sp or (not na(tk_ln) and f_gt(tk_dip, tk_ln, w))
        tk_pv  := tk_ln
        tk_pvt := tk_lt
        tk_ln  := inner_ ? i_ln : newlo_ ? tk_dip : tk_ext
        tk_lt  := inner_ ? i_lt : newlo_ ? tk_dt : tk_et
        tk_bk  := not inner_ and not newlo_
        tk_sp  := false
        f_leg(tk_dip, tk_dt)
        if sph == 1
            [rx0, rx0t] = f_far(tk_ln, w)
            if not na(rx0)
                rl_x  := rx0
                rl_xt := rx0t
        if w == D
            f_al(sph == 3 ? al_ci and not (not na(rg_hi) and f_gt(x2c, rg_hi, D)) : al_cw, sph == 3 ? "cont_aligned" : "cont_after_breakout", N2 + " " + WW + " continuation" + (sph == 3 ? " (in alignment with the " + N1 + ")" : " after the " + N1 + " breakout"), w, tk_ext, true, N2 + ".C" + (sph == 3 ? " al" : ""))
        else
            // after the reversal to the range these are inside it; a close beyond its low alerts below instead
            if not (al_rev and not na(rg_lo) and f_gt(rg_lo, x2c, D))
                f_al(al_rev ? al_cr : al_ca, al_rev ? "cont_in_range" : "cont_pullback", N2 + " " + WW + " continuation" + (al_rev ? " (inside the " + N2 + " range)" : " (" + N1 + " pullback still in play)"), w, tk_ext, false, N2 + (al_rev ? ".C in" : ".C pb"))
        tk_ext := ce
        tk_et  := x2t
        tk_eo  := co
        tk_fm  := false
        tk_cn  := 0
        tk_dip := na
        tk_dt  := na
    else if na(tk_ext) or f_gt(ce, tk_ext, w)
        // a new high without a real pullback: the same leg goes on
        tk_ext := ce
        tk_et  := x2t
        tk_eo  := co
        tk_fm  := false
        tk_cn  := 0
        tk_dip := na
        tk_dt  := na
    else
        // a real pullback: a candle took out the previous candle's low (sells: high)
        float pco = w > 0 ? tk_pl2 : tk_ph2
        if not na(pco) and f_gt(pco, w > 0 ? x2l : x2h, w)
            tk_fm := true
        if na(tk_dip) or f_gt(tk_dip, co, w)
            tk_dip := co
            tk_dt  := x2t
    if not na(tk_ln) and f_gt(tk_ln, x2c, w)
        // a close beyond the line: the direction flips; the line = the closest low / high inside the range just broken
        [f0, f0t] = f_ext2(tk_lt, w > 0)
        [cl0, cl0t] = f_close(tk_lt, -w)
        [fa0, fa0t] = f_far(tk_ln, w)
        array.clear(lg_v)
        array.clear(lg_t)
        f_leg(f0, f0t)
        float old_ln = tk_ln
        int   old_lt = tk_lt
        bool  old_bk = tk_bk
        float old_pv = tk_pv
        int   old_pvt = tk_pvt
        int   ph0 = sph
        tk_pv  := na
        tk_pvt := na
        tk_bk  := false
        tk_sp  := false
        w      := -w
        bool cl_ok = not na(cl0) and f_gt(x2c, cl0, w)
        tk_ln  := cl_ok ? cl0 : (w > 0 ? x2L : x2H)
        tk_lt  := cl_ok ? cl0t : x2t
        tk_ext := w > 0 ? x2H : x2L
        tk_et  := x2t
        tk_eo  := w > 0 ? x2L : x2H
        tk_fm  := false
        tk_cn  := 0
        tk_dip := na
        tk_dt  := na
        if w != D
            // the story timeframe turns against the top timeframe
            bool rl_brk = ph0 == 3 and not na(rg_lo) and f_gt(rg_lo, x2c, D)
            sph := 2
            if ph0 == 1 or rl_brk
                al_rev := false
            float pb_lv = rl_brk ? rg_lo : f_lw(old_lt, old_ln, old_bk, w > 0)
            bool  pc_a  = false
            if ph0 == 1
                rg_lo  := na(fa0) ? nz(rl_x, D > 0 ? XL : XH) : fa0
                rg_lot := not na(fa0) ? fa0t : na(rl_x) ? (D > 0 ? XLt : XHt) : rl_xt
                rg_lf  := false
                f_bro(old_lt, old_ln, f_ab("Pullback break", "PB"), D < 0, br_acol)
                if tg_pb
                    f_tag(tg_pl, time, D > 0 ? low : high, f_ab("Pullback break · " + N1 + " pullback confirmed", "PB · " + A1 + ".PC"), D < 0, tg_pbc)
            else if rl_brk
                f_bro(rg_lot, rg_lo, f_ab(N2 + " range " + LO + " broken", N2 + ".R" + LC + "B"), D < 0, br_acol)
                rg_lf  := true
                rg_lo  := tk_ext
                rg_lot := tk_et
            else
                if not na(fa0)
                    rg_lo  := fa0
                    rg_lot := fa0t
                    rg_lf  := false
                // one candle closed through the line and the range low: one event
                pc_a := not na(rg_lo) and f_gt(rg_lo, x2c, D)
                f_bro(old_lt, old_ln, pc_a ? f_ab(N2 + " pullback + continuation", N2 + ".P+C") : f_ab("Pullback break (inside the " + N2 + " range)", "PB.in"), D < 0, br_acol)
            // at every pullback the range resets to the range just broken: its high = the top of the leg
            // (inside the top-timeframe range)
            rg_hi  := f0
            rg_hit := f0t
            if f_gt(rg_hi, D > 0 ? XH : XL, D)
                rg_hi  := D > 0 ? XH : XL
                rg_hit := D > 0 ? XHt : XLt
            if pc_a
                al_rev := false
                f_al(al_lb or al_ca, "pullback_continuation", N2 + " pullback + continuation", -D, pb_lv, false, N2 + ".P+C")
            else
                f_al(ph0 == 1 ? al_pb : rl_brk ? al_ca : al_lb, ph0 == 1 ? "pullback_confirmed" : rl_brk ? "range_low_broken" : "pullback_in_range", ph0 == 1 ? "Pullback confirmed · " + N1 + " pullback" : rl_brk ? N2 + " range " + LO + " broken · " + N2 + " " + AW + " again" : "Pullback break inside the " + N2 + " range", -D, pb_lv, false, ph0 == 1 ? A1 + ".PC" : rl_brk ? N2 + ".R" + LC + "B" : "PB.in")
            f_story(time, D > 0 ? low : high, D < 0, (ph0 == 1 ? "Pullback break: the " + N1 + " pullback is confirmed. " + N1 + " range " + str.tostring(XL, format.mintick) + " – " + str.tostring(XH, format.mintick) : rl_brk ? "The " + N2 + " range " + LO + " " + str.tostring(rg_lo, format.mintick) + " is broken: " + N2 + " is " + AW + " again" : "Pullback break inside the " + N2 + " range: " + N2 + " is " + AW) + ".\n" + N2 + " pullback line: the " + HI + " that broke the " + LO + " " + str.tostring(tk_ln, format.mintick) + "; " + N2 + " range " + HI + " " + str.tostring(rg_hi, format.mintick) + ".")
        else if not na(rg_hi) and f_gt(x2c, rg_hi, D)
            // straight through the range high: the top timeframe continues
            f_al(al_cw, "range_high_broken", N2 + " range " + HI + " broken · " + N1 + " continues", D, rg_hi, true, N2 + ".R" + HC + "B · " + A1 + ".C")
            sph   := 1
            f_bro(rg_hit, rg_hi, f_ab(N2 + " range " + HI + " broken · " + N1 + " continues", N2 + ".R" + HC + "B · " + A1 + ".C"), D > 0, br_wcol)
            [x0_, x0t_] = f_ext2(nz(rg_lot, rg_hit), D < 0)
            rl_x  := x0_
            rl_xt := x0t_
            f_story(time, D > 0 ? high : low, D > 0, "The " + N2 + " range " + HI + " " + str.tostring(rg_hi, format.mintick) + " is broken: the " + N1 + " " + DW + " trend continues.\nPullback line: the " + LO + " that broke the " + HI + " " + str.tostring(tk_ln, format.mintick) + ".")
            rg_hi := na
            rg_lo := na
        else
            // the story-timeframe pullback: back in alignment, the story-timeframe range
            al_rev := true
            sph    := 3
            // the range just broken: its low = the bottom of this leg, its high = the far side beyond the line
            rg_lo  := f0
            rg_lot := f0t
            rg_lf  := false
            if not na(fa0)
                rg_hi  := fa0
                rg_hit := fa0t
                if f_gt(rg_hi, D > 0 ? XH : XL, D)
                    rg_hi  := D > 0 ? XH : XL
                    rg_hit := D > 0 ? XHt : XLt
            bool pc_w = not na(rg_hi) and f_gt(x2c, rg_hi, D)
            if pc_w
                // one candle closed through the line and the new range high: one event, and the top timeframe continues
                f_al(al_rl or al_cw, "pullback_continuation", N2 + " pullback + continuation", D, f_lw(old_lt, old_ln, old_bk, w > 0), true, N2 + ".P+C")
                sph := 1
                f_bro(old_lt, old_ln, f_ab(N2 + " pullback + continuation", N2 + ".P+C"), D > 0, br_wcol)
                if tg_al
                    f_tag(tg_al_, time, D > 0 ? high : low, f_ab(N2 + " pullback + continuation", N2 + ".P+C"), D > 0, tg_alc)
                [x0p, x0pt] = f_ext2(nz(rg_lot, rg_hit), D < 0)
                rl_x  := x0p
                rl_xt := x0pt
                f_story(time, D > 0 ? high : low, D > 0, N2 + " pullback and the range " + HI + " " + str.tostring(rg_hi, format.mintick) + " broken by one candle: the " + N1 + " " + DW + " trend continues.")
                rg_hi := na
                rg_lo := na
            else
                f_al(al_rl, "back_in_alignment", N2 + " pullback · back in alignment with the " + N1, D, f_lw(old_lt, old_ln, old_bk, w > 0), true, N2 + ".P · BIA")
                f_bro(old_lt, old_ln, f_ab(N2 + " pullback", N2 + ".P"), D > 0, br_wcol)
                if tg_al
                    f_tag(tg_al_, time, D > 0 ? high : low, f_ab(N2 + " pullback · back in alignment with " + N1, N2 + ".P · BIA"), D > 0, tg_alc)
                f_story(time, D > 0 ? high : low, D > 0, N2 + " pullback: back in alignment with the " + N1 + ".\n" + N2 + " range: " + LO + " " + str.tostring(rg_lo, format.mintick) + " · " + HI + " " + str.tostring(rg_hi, format.mintick) + ". The pullback line starts at its " + LO + ".")
    else if sph == 3 and not na(rg_hi) and f_gt(x2c, rg_hi, D)
        // the range high broken: the top timeframe continues (the line has already followed the rule)
        f_al(al_cw, "range_high_broken", N2 + " range " + HI + " broken · " + N1 + " continues", D, rg_hi, true, N2 + ".R" + HC + "B · " + A1 + ".C")
        sph := 1
        f_bro(rg_hit, rg_hi, f_ab(N2 + " range " + HI + " broken · " + N1 + " continues", N2 + ".R" + HC + "B · " + A1 + ".C"), D > 0, br_wcol)
        [x0_, x0t_] = f_ext2(nz(rg_lot, rg_hit), D < 0)
        rl_x  := x0_
        rl_xt := x0t_
        f_story(time, D > 0 ? high : low, D > 0, "The " + N2 + " range " + HI + " " + str.tostring(rg_hi, format.mintick) + " is broken: the " + N1 + " " + DW + " trend continues.")
        rg_hi := na
        rg_lo := na

    // while the story timeframe is against the top timeframe: a close beyond the range low makes it form again
    // (it follows the leg's extreme until the story-timeframe pullback fixes it at the bottom)
    if sph == 2 and not na(rg_lo)
        if not rg_lf and f_gt(rg_lo, x2c, D)
            rg_lf := true
            if al_rev
                al_rev := false
                f_al(al_ca, "range_low_broken", N2 + " range " + LO + " broken · " + N2 + " " + AW + " again", -D, rg_lo, false, N2 + ".R" + LC + "B")
        if rg_lf and not na(tk_ext) and f_gt(rg_lo, tk_ext, D)
            rg_lo  := tk_ext
            rg_lot := tk_et

if x2_new
    tk_pc  := x2c
    tk_ph2 := x2h
    tk_pl2 := x2l

// Price feed + chart snapshot + candle history for the server (price-level alerts, Live Chart Board, chart
// pictures). Sent when the story reads a closed H4 candle, so the snapshot agrees with the alerts.
[dr_t, dr_o, dr_h, dr_l, dr_c] = request.security(syminfo.tickerid, "D", [time[1], open[1], high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)
const int HIST_N = 40
var array<int>   dh_t = array.new<int>()
var array<float> dh_o = array.new<float>()
var array<float> dh_h = array.new<float>()
var array<float> dh_l = array.new<float>()
var array<float> dh_c = array.new<float>()
if timeframe.change("D") and not na(dr_t)
    array.push(dh_t, dr_t)
    array.push(dh_o, dr_o)
    array.push(dh_h, dr_h)
    array.push(dh_l, dr_l)
    array.push(dh_c, dr_c)
    if array.size(dh_t) > HIST_N
        array.shift(dh_t)
        array.shift(dh_o)
        array.shift(dh_h)
        array.shift(dh_l)
        array.shift(dh_c)
f_bar(int t, float o, float h, float l, float c) =>
    na(t) or na(c) ? "null" : '[' + str.tostring(t) + ',' + str.tostring(o, format.mintick) + ',' + str.tostring(h, format.mintick) + ',' + str.tostring(l, format.mintick) + ',' + str.tostring(c, format.mintick) + ']'
if x2_new and al_live and al_ok
    string _stage = sph == 1 ? "story_with" : sph == 2 ? "story_against" : sph == 3 ? "story_range" : "idle"
    alert(f_hdr("PRICE_UPDATE") + '","price":' + str.tostring(close[1])
         + ',"snapshot":{"stage":"' + _stage + '","bias":' + (D == 0 ? "null" : D > 0 ? '"bullish"' : '"bearish"') + ',"retest_source":null'
         + ',"breakout_level":' + f_num(a_blvl) + ',"level_type":"external"'
         + ',"ext_hi":' + f_num(XH) + ',"ext_lo":' + f_num(XL) + ',"d_oc":null,"d_oc_count":0'
         + ',"pl":' + f_num(sph >= 1 ? f_lw(tk_lt, tk_ln, tk_bk, w < 0) : na) + ',"rg_hi":' + f_num(sph >= 2 ? rg_hi : na) + ',"rg_lo":' + f_num(sph >= 2 ? rg_lo : na) + '}'
         + ',"bar":' + f_bar(time[1], open[1], high[1], low[1], close[1])
         + ',"dbar":' + f_bar(dr_t, dr_o, dr_h, dr_l, dr_c) + '}', alert.freq_once_per_bar)
// Once per alert: the first H4 close sends the last Daily candles, the second the last H4 candles
var int hist_step = 0
if x2_new and al_live and al_ok and hist_step < 2
    string js = ""
    if hist_step == 0
        int nd = array.size(dh_t)
        if nd > 0
            for i = 0 to nd - 1
                js := js + (i > 0 ? "," : "") + f_bar(array.get(dh_t, i), array.get(dh_o, i), array.get(dh_h, i), array.get(dh_l, i), array.get(dh_c, i))
            alert(f_hdr("HISTORY") + '","tf":"D","bars":[' + js + ']}', alert.freq_once_per_bar)
    else
        int nh = math.min(HIST_N, bar_index)
        for i = nh to 1
            js := js + (i < nh ? "," : "") + f_bar(time[i], open[i], high[i], low[i], close[i])
        alert(f_hdr("HISTORY") + '","tf":"' + timeframe.period + '","bars":[' + js + ']}', alert.freq_once_per_bar)
    hist_step += 1

// ── The lines at the last candle ─────────────────────────────────────────────
var array<line>  cl = array.new<line>()
var array<label> cb = array.new<label>()
var array<box>   cx = array.new<box>()
f_lvl(int t, float y, string txt, color c, string st, int wd) =>
    if not na(t) and not na(y)
        array.push(cl, line.new(t, y, time, y, xloc = xloc.bar_time, extend = extend.right, color = c, style = f_sty(st), width = wd))
        array.push(cb, label.new(bar_index + 3, y, txt + (lv_px ? "  " + str.tostring(y, format.mintick) : ""), style = label.style_label_left,
             color = color.new(color.black, 100), textcolor = lv_tx, size = f_sz(lv_sz)))
f_tpos(string p) =>
    p == "Top right" ? position.top_right : p == "Bottom right" ? position.bottom_right : p == "Top left" ? position.top_left : p == "Middle right" ? position.middle_right : p == "Middle left" ? position.middle_left : position.bottom_left
var table sk = table.new(f_tpos(sk_pos), 2, 11, bgcolor = sk_bg, border_width = 1, border_color = color.new(color.gray, 75))
var table ky = table.new(f_tpos(ky_pos), 2, 16, bgcolor = tb_bg, border_width = 1, border_color = color.new(color.gray, 75))
f_key(int r, string a, string b) =>
    table.cell(ky, 0, r, a, text_color = tb_tx, text_size = size.tiny, text_halign = text.align_left)
    table.cell(ky, 1, r, b, text_color = color.gray, text_size = size.tiny, text_halign = text.align_left)
var table tb = table.new(f_tpos(tb_pos), 2, 20, bgcolor = tb_bg, border_width = 1, border_color = color.new(color.gray, 75))
f_row(int r, string a, string b) =>
    table.cell(tb, 0, r, a, text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, b, text_color = tb_tx, text_size = size.small, text_halign = text.align_left)

if barstate.islast
    for l in cl
        line.delete(l)
    for b in cb
        label.delete(b)
    for x in cx
        box.delete(x)
    array.clear(cl)
    array.clear(cb)
    array.clear(cx)
    if not chart_ok and AD != 0 and x_on and not na(a_chi) and not na(a_clo)
        // on the top timeframe's own chart: its external high / low (the story needs the story timeframe)
        string ew = a_cdir == "bull" ? "bullish" : "bearish"
        f_lvl(a_chit, a_chi, f_ab(N1 + " " + ew + " external high", A1 + (a_cdir == "bull" ? ".Bull" : ".Bear") + " XH"), x_col, x_sty, x_w)
        f_lvl(a_clot, a_clo, f_ab(N1 + " " + ew + " external low", A1 + (a_cdir == "bull" ? ".Bull" : ".Bear") + " XL"), x_col, x_sty, x_w)
    if chart_ok and D != 0 and sph >= 1
        if x_on
            f_lvl(XHt, XH, ab_on ? A1 + "." + BW + " XH" + (D > 0 and not a_chif ? " f" : "") : N1 + " " + DW + " external high" + (D > 0 and not a_chif ? " (still forming)" : "") + (sph >= 2 ? " · " + N1 + " range high" + (D > 0 ? " (target)" : "") : ""), x_col, x_sty, x_w)
            f_lvl(XLt, XL, ab_on ? A1 + "." + BW + " XL" + (D < 0 and not a_clof ? " f" : "") : N1 + " " + DW + " external low" + (D < 0 and not a_clof ? " (still forming)" : "") + (sph >= 2 ? " · " + N1 + " range low" + (D < 0 ? " (target)" : "") : ""), x_col, x_sty, x_w)
        if sph >= 2 and not na(XH) and not na(XL)
            float req = (XH + XL) / 2
            int   r0  = math.min(XHt, XLt)
            if eq_on
                f_lvl(r0, req, f_ab(N1 + " range 0.5 · " + (D > 0 ? "discount below" : "premium above"), A1 + ".EQ"), eq_col, eq_sty, eq_w)
            if sh_on
                array.push(cx, box.new(r0, req, time, XL, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(color.black, 100), bgcolor = color.new(sh_bull, 100 - sh_op)))
                array.push(cx, box.new(r0, XH, time, req, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(color.black, 100), bgcolor = color.new(sh_bear, 100 - sh_op)))
        if pl_on and not na(tk_ln)
            string lw = w > 0 ? "low" : "high"
            string hw = w > 0 ? "high" : "low"
            f_lvl(tk_lt, f_lw(tk_lt, tk_ln, tk_bk, w < 0), ab_on ? (sph == 2 ? N2 + ".PL" : "PL") + (tk_bk ? " b" : "") : (sph == 2 ? N2 + " pullback line" : "pullback line") + ": " + (tk_bk ? "the broken " + N2 + " " + hw + " (no " + lw + " inside the move that broke it)" : "the " + N2 + " " + lw + " that broke the last " + hw) + (sph == 1 ? " (an " + N2 + " close beyond it = the " + N1 + " pullback)" : sph == 2 ? " (an " + N2 + " close beyond it = " + N2 + " pullback)" : " (inside the " + N2 + " range)"), pl_col, pl_sty, pl_w)
        if sph == 2 and rh_on and rx_on and not na(tk_ext)
            f_lvl(tk_et, tk_ext, f_ab(N2 + " " + LO + " (forming)", N2 + "." + LC + " f"), rh_col, rx_sty, rh_w)
        if sph >= 2 and rh_on and not na(rg_hi)
            f_lvl(rg_hit, rg_hi, ab_on ? N2 + ".R" + HC : N2 + " range " + HI + (sph == 3 ? " (a close beyond it: the " + N1 + " continues)" : ""), rh_col, rh_sty, rh_w)
        if sph == 1 and rh_on and rx_on and not na(rl_x)
            f_lvl(rl_xt, rl_x, f_ab(N2 + " range " + LO + " if the pullback line breaks (the extreme " + LO + " of the breakout leg)", N2 + ".R" + LC + "?"), rh_col, rx_sty, rh_w)
        if sph >= 2 and rh_on and (rx_on or not rg_lf) and not na(rg_lo)
            f_lvl(rg_lot, rg_lo, ab_on ? N2 + ".R" + LC + (rg_lf ? " f" : "") : N2 + " range " + LO + (rg_lf ? " (forming)" : sph == 3 ? " (a close beyond it: " + N2 + " " + AW + " again)" : ""), rh_col, rg_lf ? rx_sty : rh_sty, rh_w)
    // reaction zones inside the current breakout leg (from the pullback line to now), in the leg's direction:
    // FVG (3-candle gap), OC (two candles the same way: first close / second open), V-shape (sells: A-shape,
    // body level). A zone is gone once a story-timeframe candle closes through it. Zones that touch or sit
    // within a few pips of each other are merged into one ("H4 FVG + OC + V-shape").
    if chart_ok and rz_on and D != 0 and sph >= 1 and not na(tk_lt)
        // the whole move price is trading in: against the top timeframe from the top of the leg (the range
        // high), in alignment from the range low, else from the pullback line
        int zt0 = sph == 2 and not na(rg_hit) ? rg_hit : sph == 3 and not na(rg_lot) ? rg_lot : tk_lt
        int nq = array.size(q2t)
        int k0 = nq - 1
        while k0 > 0 and array.get(q2t, k0 - 1) >= zt0
            k0 -= 1
        k0 := math.max(k0, nq - 300)
        array<float>  mz_lo = array.new<float>()
        array<float>  mz_hi = array.new<float>()
        array<int>    mz_t  = array.new<int>()
        array<string> mz_k  = array.new<string>()
        float ztol = close * 0.0004
        if nq > 3 and nq - 1 >= math.max(k0 + 1, 2)
            for j = nq - 1 to math.max(k0 + 1, 2)
                if array.size(mz_lo) >= 40
                    break
                float o1 = array.get(q2o, j - 1)
                float c1 = array.get(q2c, j - 1)
                float o2 = array.get(q2o, j)
                float c2 = array.get(q2c, j)
                for kind = 0 to 2
                    float z_lo = na
                    float z_hi = na
                    string zk = ""
                    if kind == 0 and rz_fvg and j >= k0 + 2 and (w > 0 ? array.get(q2lw, j) > array.get(q2hw, j - 2) : array.get(q2hw, j) < array.get(q2lw, j - 2))
                        z_lo := w > 0 ? array.get(q2hw, j - 2) : array.get(q2hw, j)
                        z_hi := w > 0 ? array.get(q2lw, j) : array.get(q2lw, j - 2)
                        zk   := "FVG"
                    else if kind == 1 and rz_oc and (w > 0 ? (c1 > o1 and c2 > o2) : (c1 < o1 and c2 < o2))
                        z_lo := c1
                        z_hi := c1
                        zk   := "OC"
                    else if kind == 2 and rz_av and (w > 0 ? (c1 < o1 and c2 > o2) : (c1 > o1 and c2 < o2))
                        z_lo := c1
                        z_hi := c1
                        zk   := w > 0 ? "V-shape" : "A-shape"
                    if zk != ""
                        bool dead = false
                        float edge = w > 0 ? z_lo : z_hi
                        if j < nq - 1
                            for m = j + 1 to nq - 1
                                if f_gt(edge, array.get(q2c, m), w)
                                    dead := true
                                    break
                        if not dead
                            int zt = array.get(q2t, j - 1)
                            // merge into a zone it touches (within a few pips), else a new zone
                            int hit = -1
                            if array.size(mz_lo) > 0
                                for q = 0 to array.size(mz_lo) - 1
                                    if z_lo <= array.get(mz_hi, q) + ztol and z_hi >= array.get(mz_lo, q) - ztol
                                        hit := q
                                        break
                            if hit < 0
                                array.push(mz_lo, z_lo)
                                array.push(mz_hi, z_hi)
                                array.push(mz_t, zt)
                                array.push(mz_k, zk)
                            else
                                array.set(mz_lo, hit, math.min(array.get(mz_lo, hit), z_lo))
                                array.set(mz_hi, hit, math.max(array.get(mz_hi, hit), z_hi))
                                array.set(mz_t, hit, math.min(array.get(mz_t, hit), zt))
                                string ks = array.get(mz_k, hit)
                                if not str.contains(ks, zk)
                                    array.set(mz_k, hit, ks + " + " + zk)
        if array.size(mz_lo) > 0
            for q = 0 to math.min(array.size(mz_lo), rz_n) - 1
                float zl = array.get(mz_lo, q)
                float zh = array.get(mz_hi, q)
                string kn = array.get(mz_k, q)
                string ks = ab_on ? str.replace_all(str.replace_all(str.replace_all(kn, " + ", "+"), "V-shape", "V"), "A-shape", "A") : kn
                color zc = str.contains(kn, "FVG") ? rz_fvc : str.contains(kn, "OC") ? rz_occ : rz_avc
                if zh - zl > ztol * 0.25
                    array.push(cx, box.new(array.get(mz_t, q), zh, time, zl, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(zc, 100), bgcolor = color.new(zc, 100 - rz_op)))
                    array.push(cb, label.new(bar_index + 3, (zh + zl) / 2, N2 + " " + ks + (lv_px ? "  " + str.tostring(zl, format.mintick) + " – " + str.tostring(zh, format.mintick) : ""), style = label.style_label_left, color = color.new(color.black, 100), textcolor = lv_tx, size = f_sz(lv_sz)))
                else
                    f_lvl(array.get(mz_t, q), zl, N2 + " " + ks, zc, rz_sty, rz_w)
    // the story table and the status table (one table per corner: in the same corner the story goes under the status)
    bool  sk_same = sk_pos == tb_pos
    table st_tb   = sk_same ? tb : sk
    int   so      = sk_same and tb_on ? 8 : 0
    table.clear(sk, 0, 0, 1, 10)
    table.clear(tb, 0, 0, 1, 19)
    table.clear(ky, 0, 0, 1, 15)
    if ky_on and ab_on and chart_ok and D != 0
        f_key(0, "KEY", "")
        f_key(1, A1 + "." + BW + " XH / XL", N1 + " " + DW + " external high / low (f = still forming); after the pullback: the " + N1 + " range")
        f_key(2, A1 + ".EQ", N1 + " range 0.5 (premium above / discount below)")
        f_key(3, A1 + ".BO", N1 + " breakout")
        f_key(4, "PL / " + N2 + ".PL", "pullback line: the " + N2 + " " + LO + " that broke the last " + HI + " (b = the broken " + HI + " itself)")
        f_key(5, N2 + ".C", N2 + " continuation (al = in alignment, pb = in the pullback, in = against the " + N1 + " inside the " + N2 + " range)")
        f_key(6, "PB / PB.in", "pullback break: " + N2 + " close beyond the pullback line (in = inside the " + N2 + " range)")
        f_key(7, A1 + ".PC", N1 + " pullback confirmed")
        f_key(8, N2 + ".P · BIA", N2 + " pullback: back in alignment with the " + N1)
        f_key(9, N2 + ".R" + HC + " / " + N2 + ".R" + LC, N2 + " range " + HI + " / " + LO + " (f = forming, ? = the range " + LO + " if the pullback line breaks)")
        f_key(10, N2 + ".R" + HC + "B · " + A1 + ".C", N2 + " range " + HI + " broken: the " + N1 + " continues")
        f_key(11, N2 + ".R" + LC + "B", N2 + " range " + LO + " broken: " + N2 + " " + AW + " again")
        f_key(12, N2 + "." + LC + " f", N2 + " " + LO + " still forming")
        f_key(13, "FVG / OC / V / A", "reaction zones (FVG, OC, V-shape, A-shape; + = merged)")
        f_key(14, "!", "alert point")
        f_key(15, N2 + ".P+C", N2 + " pullback and continuation closed by one candle: one alert")
    if sk_on and chart_ok
        table.cell(st_tb, 0, so, "STORY", text_color = sk_tx, text_size = size.small, text_halign = text.align_left, bgcolor = sk_bg)
        table.cell(st_tb, 1, so, PLAN, text_color = color.new(sk_tx, 40), text_size = size.small, text_halign = text.align_left, bgcolor = sk_bg)
        int nh = array.size(st_h)
        if nh == 0
            table.cell(st_tb, 1, so + 1, "Waiting for a " + N1 + " breakout", text_color = sk_tx, text_size = size.small, text_halign = text.align_left, bgcolor = sk_bg)
        else
            for j = 0 to math.min(sk_n, nh) - 1
                int ix = nh - 1 - j
                table.cell(st_tb, 0, so + j + 1, str.format_time(array.get(st_ht, ix), "dd MMM HH:mm"), text_color = color.new(sk_tx, 40), text_size = size.tiny, text_halign = text.align_left, bgcolor = sk_bg)
                table.cell(st_tb, 1, so + j + 1, array.get(st_h, ix), text_color = j == 0 ? sk_tx : color.new(sk_tx, 35), text_size = size.small, text_halign = text.align_left, bgcolor = sk_bg)
    if tb_on
        if not chart_ok
            f_row(0, PLAN, "On this chart: the " + N1 + " external high / low. Put the chart on " + N2 + " or lower for the story")
        else
            string phs = sph == 0 ? "waiting for a " + N1 + " breakout" : sph == 1 ? N1 + " " + DW + " breakout: " + N2 + " with it; a close beyond the pullback line = the " + N1 + " pullback" : sph == 2 ? N1 + " pullback: " + N2 + " " + AW + "; a close beyond its last " + HI + " = " + N2 + " pullback" : "inside the " + N2 + " range: beyond its " + HI + " the " + N1 + " " + DW + " story continues; a close beyond its " + LO + " = " + N2 + " " + AW + " cont"
            f_row(0, "Plan", PLAN + " · breaks: " + N1 + " " + (t1_wick ? "wick" : "body close") + ", " + N2 + " " + (t2_wick ? "wick" : "body close"))
            f_row(1, N1, D > 0 ? "bullish" : D < 0 ? "bearish" : "—")
            f_row(2, "Story", phs)
            if sph >= 1 and not na(XH) and not na(XL)
                f_row(3, N1 + " range", str.tostring(XL, format.mintick) + " – " + str.tostring(XH, format.mintick))
            if sph >= 1 and not na(tk_ln)
                f_row(4, sph == 2 ? N2 + " pullback line" : "Pullback line", str.tostring(f_lw(tk_lt, tk_ln, tk_bk, w < 0), format.mintick))
            if sph >= 2 and not na(rg_hi)
                f_row(5, N2 + " range", (not na(rg_lo) ? str.tostring(rg_lo, format.mintick) + (rg_lf ? " (forming)" : "") + " – " : HI + " ") + str.tostring(rg_hi, format.mintick))

// ═════════════════════════════════════════════════════════════════════════════
// 9 · ZONES BACKTEST (user's method, 2026-11-10; pictures Documents/Zones_Picture_4.png and _6.png)
// Works on the H4 chart (it reads the M5 / M15 / H1 candles inside each H4 candle) or on a lower chart.
// Every Bias Pointer alert (any kind) clears the zones (buys after a bullish alert; bearish = the mirror):
//   · the POI in the leg before the break (a back-in-the-range trade). The key levels of the leg from its
//     swing low up to the breaking candle (V-shape, OC, the Breaker = the A-shape the break closed
//     above, wicks in) are found at the alert, but NO POI is marked until liquidity forms after the
//     break: a single candle liquidity (the low wick of a bullish candle) or a swing low. The POI is
//     then the ONE level of the leg closest below that liquidity. A deeper liquidity before the next
//     alert moves it. Each level is its own box (no merging).
//   · the opposite zone (SELL above): past the closest liquidity above the breaking candle (an untaken
//     swing high; none: a single candle liquidity, the high wick of a bearish candle), the closest
//     fresh key level (A-shape, OC, Breaker = a broken V-shape), wicks in.
// The liquidity of each is drawn (yellow). A zone ends when an H4 candle CLOSES through it, or at the next
// alert. Inside a zone a confirmation gives the trade: Instant (at its close) or a Retest of its level
// (CISD line, OC level, the engulfed candle's open / close, the PCL candle's open) that waits until the
// next alert. SL behind the pattern's low (sells: high). TP 1:2 or 1:3. One trade per zone per setup.
// Every confirmation of the picked pattern inside a zone is marked (a triangle; hover for the details).
// ═════════════════════════════════════════════════════════════════════════════
const string G_ZB = "9 · Zones backtest"
int    zb_fy   = input.int(2020, "Count trades from: year", minval = 1990, maxval = 2100, group = G_ZB, inline = "fr")
int    zb_fm   = input.int(1, "month", minval = 1, maxval = 12, group = G_ZB, inline = "fr",
     tooltip = "Only confirmations from the 1st of this month on are traded and counted. Each setup can only start where TradingView has its M5 / M15 / H1 candles: see 'Data from' in the table.")
int    zb_ty   = input.int(0, "Until: year (0 = today)", minval = 0, maxval = 2100, group = G_ZB, inline = "to")
int    zb_tm   = input.int(12, "month (to its end)", minval = 1, maxval = 12, group = G_ZB, inline = "to")
int    zb_from = timestamp(zb_fy, zb_fm, 1, 0, 0)
int    zb_to   = zb_ty == 0 ? timestamp(2100, 1, 1, 0, 0) : zb_tm == 12 ? timestamp(zb_ty + 1, 1, 1, 0, 0) - 1 : timestamp(zb_ty, zb_tm + 1, 1, 0, 0) - 1
string zb_tpo  = input.string("1:2", "Take profit", options = ["1:2", "1:3"], group = G_ZB)
string zb_side = input.string("Both", "Zones traded", options = ["Both", "The POI in the leg only", "The opposite zone only"], group = G_ZB)
string zb_conf = input.string("H1 OCTGD", "Confirmation", options = ["M5 CISD", "M15 CISD", "H1 OCTGD", "H1 EG", "H1 PCL", "All"], group = G_ZB, inline = "sh")
string zb_ent  = input.string("Instant", "entry", options = ["Instant", "Retest", "Both"], group = G_ZB, inline = "sh",
     tooltip = "Instant: at the confirmation's close. Retest: CISD → the CISD line · OCTGD → the OC level · EG → the engulfed candle's open (or close) · PCL → the PCL candle's open. A retest order waits until the next breakout alert, then it is cancelled. The table shows what you pick (All / Both to compare). The trades are drawn on the chart when one confirmation and one entry are picked.")
string zb_egr  = input.string("Open", "EG retest at the engulfed candle's", options = ["Open", "Close"], group = G_ZB)
int    zb_ow   = input.int(10, "OCTGD: candles allowed from C2 to the close through the level", minval = 1, maxval = 50, group = G_ZB)
int    zb_cw   = input.int(20, "CISD: candles allowed from the low to the close through the line", minval = 1, maxval = 100, group = G_ZB)
int    zb_slb  = input.int(0, "SL buffer (ticks beyond the pattern's low / high)", minval = 0, group = G_ZB)
float  zb_risk = input.float(1.0, "Risk per trade % (for the return figure)", minval = 0.1, step = 0.1, group = G_ZB)
int    zb_atr  = input.int(14, "H4 candle size = the average range of the last N H4 candles (a wick this far past a zone still counts)", minval = 1, maxval = 100, group = G_ZB)
int    zb_scan = input.int(300, "H4 candles searched for the opposite zone", minval = 30, maxval = 1000, group = G_ZB)
bool   zb_shz  = input.bool(true, "Show the zones and their liquidity", group = G_ZB)
bool   zb_mk   = input.bool(true, "Triangles: mark each confirmation inside a zone", group = G_ZB, inline = "mk")
int    zb_km   = input.int(150, "kept", minval = 1, maxval = 300, group = G_ZB, inline = "mk")
string zb_mkp  = input.string("Same as the Confirmation above", "Triangles for", options = ["Same as the Confirmation above", "M5 CISD", "M15 CISD", "H1 OCTGD", "H1 EG", "H1 PCL", "All"], group = G_ZB,
     tooltip = "Which confirmation's triangles are drawn. Hover a triangle for its time, wick, close, retest level and SL.")
string zb_mkz  = input.string("Both zones", "Triangles at", options = ["Both zones", "The POI in the leg", "The opposite zone"], group = G_ZB, inline = "mz")
string zb_mks  = input.string("Buys and sells", "", options = ["Buys and sells", "Buys", "Sells"], group = G_ZB, inline = "mz")
bool   zb_sht  = input.bool(true, "Show the trades", group = G_ZB, inline = "ts")
int    zb_kt   = input.int(40, "kept", minval = 1, maxval = 100, group = G_ZB, inline = "ts")
bool   zb_tbo  = input.bool(true, "Results table", group = G_ZB, inline = "rt")
string zb_tbp  = input.string("Bottom left", "", options = ["Top right", "Bottom right", "Top left", "Bottom left", "Middle right", "Middle left"], group = G_ZB, inline = "rt")
bool   zb_mon  = input.bool(true, "Month by month for the drawn setup (last 12 months)", group = G_ZB)
bool   zb_alr  = input.bool(false, "Alert BUY / SELL of the drawn setup in real time (alert: Any alert() function call)", group = G_ZB)
color  zb_bc   = input.color(#26A69A, "Buy", group = G_ZB, inline = "zc")
color  zb_scc  = input.color(#EF5350, "Sell", group = G_ZB, inline = "zc")
color  zb_lqc  = input.color(#F7C948, "Liquidity", group = G_ZB, inline = "zc")
int    zb_op   = input.int(82, "zone opacity %", minval = 0, maxval = 100, group = G_ZB, inline = "zc")

float  zb_rr   = zb_tpo == "1:3" ? 3.0 : 2.0
const int NS   = 10    // setups: confirmation p (0 M5 CISD · 1 M15 CISD · 2 H1 OCTGD · 3 H1 EG · 4 H1 PCL) × entry (0 Instant · 1 Retest)
int    ZB_PI   = zb_conf == "M5 CISD" ? 0 : zb_conf == "M15 CISD" ? 1 : zb_conf == "H1 OCTGD" ? 2 : zb_conf == "H1 EG" ? 3 : zb_conf == "H1 PCL" ? 4 : -1
int    ZB_MP   = zb_mkp == "M5 CISD" ? 0 : zb_mkp == "M15 CISD" ? 1 : zb_mkp == "H1 OCTGD" ? 2 : zb_mkp == "H1 EG" ? 3 : zb_mkp == "H1 PCL" ? 4 : zb_mkp == "All" ? -1 : ZB_PI
int    ZB_EI   = zb_ent == "Instant" ? 0 : zb_ent == "Retest" ? 1 : -1
// the one setup drawn on the chart (-1: several picked, none drawn)
int    SHOWN   = ZB_PI >= 0 and ZB_EI >= 0 ? ZB_PI * 2 + ZB_EI : -1
var array<string> ZP = array.from("M5 CISD", "M15 CISD", "H1 OCTGD", "H1 EG", "H1 PCL")
int    ZCS     = timeframe.in_seconds()
// a confirmation timeframe smaller than the chart is read from the candles inside each chart candle
// (only up to an H4 chart: above it the story can't run and the small candles inside a Daily / Weekly candle are too many)
bool   ZOK     = ZCS <= 14400
bool   ZL0     = ZOK and ZCS > 300
bool   ZL1     = ZOK and ZCS > 900
bool   ZL2     = ZOK and ZCS > 3600

// ── H4 candle j seen from direction d (d < 0: prices flipped, so the buy-side rules read the sell side) ──
f_zh(int j, int d) =>
    d > 0 ? array.get(q2hw, j) : -array.get(q2lw, j)
f_zl(int j, int d) =>
    d > 0 ? array.get(q2lw, j) : -array.get(q2hw, j)
f_zo(int j, int d) =>
    d * array.get(q2o, j)
f_zc(int j, int d) =>
    d * array.get(q2c, j)
// a level's name (kind 0 V-shape / A-shape, 1 OC, 2 Breaker), for a buy zone or a sell zone
f_kn(int k, bool buy) =>
    k == 0 ? (buy ? "V-shape" : "A-shape") : k == 1 ? "OC" : "Breaker"

// The key levels of the leg before the break, each on its own (flipped prices: buy levels below).
// The leg runs back from the breaking candle to its swing low; it stops at a candle whose high is above
// the breaking close.
f_zleg(int d, array<float> lo_, array<float> hi_, array<int> t_, array<int> k_) =>
    int nq = array.size(q2t)
    int k  = nq - 1
    if k >= 2
        int   s  = k
        float bc = f_zc(k, d)
        float mn = f_zl(k, d)
        int   j  = k - 1
        int   stop_ = math.max(1, k - 150)
        while j >= stop_
            if f_zh(j, d) > bc
                break
            if f_zl(j, d) < mn
                mn := f_zl(j, d)
                s  := j
            j -= 1
        for jj = math.max(1, s) to k
            float o1 = f_zo(jj - 1, d)
            float c1 = f_zc(jj - 1, d)
            float h1 = f_zh(jj - 1, d)
            float l1 = f_zl(jj - 1, d)
            float o2 = f_zo(jj, d)
            float c2 = f_zc(jj, d)
            float h2 = f_zh(jj, d)
            float l2 = f_zl(jj, d)
            float zlo = na
            float zhi = na
            int   kd  = -1
            if c1 < o1 and c2 > o2
                // V-shape: the bearish candle's close, down to the lower wick of the two
                zlo := math.min(l1, l2)
                zhi := c1
                kd  := 0
            else if c1 > o1 and c2 > o2
                // OC: the first close / second open, down to the second candle's wick
                zlo := math.min(l2, c1)
                zhi := math.max(c1, o2)
                kd  := 1
            else if c1 > o1 and c2 < o2 and c1 < bc
                // the Breaker: an A-shape the break closed above, up to its wick
                zlo := c1
                zhi := math.max(h1, h2)
                kd  := 2
            if kd >= 0
                // fresh: no close below it since (a Breaker: since it was broken)
                bool dead  = false
                bool armed = kd != 2
                if jj < k
                    for m = jj + 1 to k
                        float cm = f_zc(m, d)
                        if not armed
                            armed := cm > zlo
                        else if cm < zlo
                            dead := true
                            break
                if not dead
                    array.push(lo_, zlo)
                    array.push(hi_, zhi)
                    array.push(t_, array.get(q2t, jj - 1))
                    array.push(k_, kd)
    true

// The opposite zone (flipped prices: a sell zone above): the closest fresh level past the liquidity above the
// breaking candle. Returns [lo, hi, time, kind, liquidity, its time, its kind (0 swing, 1 single candle, 2 the
// breaking candle's high)].
f_zopp(int d, int scan) =>
    int   nq  = array.size(q2t)
    int   k   = nq - 1
    float liq = na
    int   lqt = na
    int   lqk = 0
    float rlo = na
    float rhi = na
    int   rt  = na
    int   rk  = -1
    if k >= 3
        // liquidity: the closest untaken swing high above the breaking candle; none: the closest untaken
        // high wick of a bearish candle (single candle liquidity); none: the breaking candle's high
        float hmax  = f_zh(k, d)
        float sc    = na
        int   sct   = na
        int   stop_ = math.max(1, k - scan)
        int   j     = k - 1
        while j >= stop_ and na(liq)
            float hj = f_zh(j, d)
            if hj > hmax
                if hj > f_zh(j - 1, d) and hj > f_zh(j + 1, d)
                    liq := hj
                    lqt := array.get(q2t, j)
                    lqk := 0
                else if na(sc) and f_zc(j, d) < f_zo(j, d)
                    sc  := hj
                    sct := array.get(q2t, j)
            hmax := math.max(hmax, hj)
            j -= 1
        if na(liq)
            liq := na(sc) ? f_zh(k, d) : sc
            lqt := na(sc) ? array.get(q2t, k) : sct
            lqk := na(sc) ? 2 : 1
        float cmax = f_zc(k, d)     // the highest close after the pair
        for jj = k - 1 to math.max(1, k - scan)
            float o1 = f_zo(jj - 1, d)
            float c1 = f_zc(jj - 1, d)
            float h1 = f_zh(jj - 1, d)
            float l1 = f_zl(jj - 1, d)
            float o2 = f_zo(jj, d)
            float c2 = f_zc(jj, d)
            float h2 = f_zh(jj, d)
            float l2 = f_zl(jj, d)
            float zl_ = na
            float zh_ = na
            int   kd  = -1
            if c1 > o1 and c2 < o2
                // A-shape: the bullish candle's close, up to the higher wick
                if c1 > liq and cmax < math.max(h1, h2)
                    zl_ := c1
                    zh_ := math.max(h1, h2)
                    kd  := 0
            else if c1 < o1 and c2 < o2
                // OC: the first close / second open, up to the second candle's wick
                if math.min(c1, o2) > liq and cmax < math.max(h2, c1)
                    zl_ := math.min(c1, o2)
                    zh_ := math.max(h2, c1)
                    kd  := 1
            else if c1 < o1 and c2 > o2
                // the Breaker: a V-shape price later closed below, and has not closed back above since
                if math.min(l1, l2) > liq
                    bool broke = false
                    bool dead  = false
                    for m = jj + 1 to k
                        float cm = f_zc(m, d)
                        if not broke
                            broke := cm < math.min(l1, l2)
                        else if cm > c1
                            dead := true
                            break
                    if broke and not dead
                        zl_ := math.min(l1, l2)
                        zh_ := c1
                        kd  := 2
            if kd >= 0 and (na(rlo) or zl_ < rlo)
                rlo := zl_
                rhi := zh_
                rt  := array.get(q2t, jj - 1)
                rk  := kd
            cmax := math.max(cmax, c2)
    [rlo, rhi, rt, rk, liq, lqt, lqk]

// ── The two zones: 0 the POI in the leg, 1 the opposite zone (with their liquidity lines) ──
var array<float> zn_lo  = array.new<float>(2, na)
var array<float> zn_hi  = array.new<float>(2, na)
var array<int>   zn_dir = array.new<int>(2, 0)
var array<bool>  zn_ok  = array.new<bool>(2, false)
var array<box>   zn_bx  = array.new<box>(2)
var array<line>  zn_ll  = array.new<line>(2)
var array<label> zn_lb  = array.new<label>(2)
var array<box>   zx_bx  = array.new<box>()       // every box since the alert (a POI closed through stays, dotted)
// the levels of the current leg (real prices) and its liquidity
var array<float> zv_lo  = array.new<float>()
var array<float> zv_hi  = array.new<float>()
var array<int>   zv_t   = array.new<int>()
var array<int>   zv_k   = array.new<int>()
var array<bool>  zv_ok  = array.new<bool>()
var int   zg_d   = 0
var int   zg_bt  = na
var float zg_lq  = na
var int   zg_lqt = na
var int   zg_pi  = -1
var float zb_sz  = na
var int   zb_na  = 0
var array<int> dg_z = array.new<int>(2, 0)   // POIs marked in the leg, opposite zones
f_zset(int z, float lo, float hi, int t, int dir, string txt) =>
    array.set(zn_lo, z, lo)
    array.set(zn_hi, z, hi)
    array.set(zn_dir, z, dir)
    array.set(zn_ok, z, true)
    array.set(zn_bx, z, box(na))
    if zb_shz
        color cc = dir > 0 ? zb_bc : zb_scc
        box b = box.new(t, hi, time_close, lo, xloc = xloc.bar_time, border_color = color.new(cc, 40), bgcolor = color.new(cc, zb_op),
             text = txt, text_color = color.new(cc, 10), text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_top)
        array.set(zn_bx, z, b)
        array.push(zx_bx, b)
f_zliq(int z, float y, int t, string txt) =>
    line.delete(array.get(zn_ll, z))
    label.delete(array.get(zn_lb, z))
    array.set(zn_ll, z, line(na))
    array.set(zn_lb, z, label(na))
    if zb_shz and not na(y) and not na(t)
        array.set(zn_ll, z, line.new(t, y, time_close, y, xloc = xloc.bar_time, color = zb_lqc, style = line.style_dotted, width = 2))
        array.set(zn_lb, z, label.new(t, y, txt, xloc = xloc.bar_time, style = label.style_label_right, color = color.new(color.black, 100), textcolor = zb_lqc, size = size.tiny,
             tooltip = txt + " " + str.tostring(y, format.mintick)))

// ── The setups: two slots each (q = setup * 2 + side; side 0 buy, 1 sell) and their results ──
var array<int>   y_st  = array.new<int>(NS * 2, 0)     // 0 none · 1 retest order waiting · 2 open
var array<float> y_en  = array.new<float>(NS * 2, na)
var array<float> y_sl  = array.new<float>(NS * 2, na)
var array<float> y_tp  = array.new<float>(NS * 2, na)
var array<int>   y_src = array.new<int>(NS * 2, 0)
var array<bool>  z_use = array.new<bool>(NS * 2, false)  // zone z used by setup y: z * NS + y
var array<int>   y_n   = array.new<int>(NS, 0)
var array<int>   y_w   = array.new<int>(NS, 0)
var array<int>   y_cx  = array.new<int>(NS, 0)
var array<int>   y_run = array.new<int>(NS, 0)
var array<int>   y_mrn = array.new<int>(NS, 0)
var array<float> y_r   = array.new<float>(NS, 0.0)
var array<float> y_pk  = array.new<float>(NS, 0.0)
var array<float> y_dd  = array.new<float>(NS, 0.0)
var array<int>   sm_f  = array.new<int>(5)              // each confirmation: first / last candle counted
var array<int>   sm_l  = array.new<int>(5)
// the drawn setup: buys / sells, leg POI / opposite, month by month, its lines
var array<int>   sh_n  = array.new<int>(4, 0)
var array<float> sh_r  = array.new<float>(4, 0.0)
var array<int>   mo_k  = array.new<int>()
var array<int>   mo_n  = array.new<int>()
var array<float> mo_r  = array.new<float>()
var array<line>  d_ln  = array.new<line>(6)
var array<label> d_lb  = array.new<label>(2)
var array<line>  zt_l  = array.new<line>()
var array<label> zt_b  = array.new<label>()
var array<label> zm_b  = array.new<label>()        // the confirmation marks
f_ddel(int side) =>
    for k = 0 to 2
        line.delete(array.get(d_ln, side * 3 + k))
        array.set(d_ln, side * 3 + k, line(na))
    label.delete(array.get(d_lb, side))
    array.set(d_lb, side, label(na))

// the H4 candle size, and the zones / levels an H4 candle closed through
if x2_new
    int nq_ = array.size(q2t)
    if nq_ > 0
        int   m_ = math.min(zb_atr, nq_)
        float s_ = 0.0
        for i = nq_ - m_ to nq_ - 1
            s_ += array.get(q2hw, i) - array.get(q2lw, i)
        zb_sz := s_ / m_
    for z = 0 to 1
        if array.get(zn_ok, z) and (array.get(zn_dir, z) > 0 ? x2c < array.get(zn_lo, z) : x2c > array.get(zn_hi, z))
            array.set(zn_ok, z, false)
            box b = array.get(zn_bx, z)
            if not na(b)
                box.set_right(b, time)
                box.set_border_style(b, line.style_dotted)
            array.set(zn_bx, z, box(na))
            if z == 0
                zg_pi := -1
    int nv_ = array.size(zv_lo)
    if nv_ > 0
        for i = 0 to nv_ - 1
            if array.get(zv_ok, i) and (zg_d > 0 ? x2c < array.get(zv_lo, i) : x2c > array.get(zv_hi, i))
                array.set(zv_ok, i, false)

// a Bias Pointer alert: the old zones go, waiting retest orders are cancelled, the leg's levels and the
// opposite zone are found (the leg's POI waits for liquidity)
int zb_d = array.get(zb_ev, 0)
array.set(zb_ev, 0, 0)
if zb_d != 0
    zb_na += 1
    for b in zx_bx
        box.delete(b)
    array.clear(zx_bx)
    for z = 0 to 1
        array.set(zn_bx, z, box(na))
        array.set(zn_ok, z, false)
        f_zliq(z, na, na, "")
    array.fill(z_use, false)
    for q = 0 to NS * 2 - 1
        if array.get(y_st, q) == 1
            array.set(y_st, q, 0)
            int y = math.floor(q / 2)
            array.set(y_cx, y, array.get(y_cx, y) + 1)
            if y == SHOWN
                f_ddel(q % 2)
    // the leg's levels (real prices)
    array.clear(zv_lo)
    array.clear(zv_hi)
    array.clear(zv_t)
    array.clear(zv_k)
    array.clear(zv_ok)
    array<float> m_lo = array.new<float>()
    array<float> m_hi = array.new<float>()
    array<int>   m_t  = array.new<int>()
    array<int>   m_k  = array.new<int>()
    f_zleg(zb_d, m_lo, m_hi, m_t, m_k)
    int nm_ = array.size(m_lo)
    if nm_ > 0
        for i = 0 to nm_ - 1
            array.push(zv_lo, zb_d > 0 ? array.get(m_lo, i) : -array.get(m_hi, i))
            array.push(zv_hi, zb_d > 0 ? array.get(m_hi, i) : -array.get(m_lo, i))
            array.push(zv_t, array.get(m_t, i))
            array.push(zv_k, array.get(m_k, i))
            array.push(zv_ok, true)
    zg_d   := zb_d
    zg_bt  := array.get(q2t, array.size(q2t) - 1)
    zg_lq  := na
    zg_lqt := na
    zg_pi  := -1
    // the opposite zone and its liquidity
    [o_lo, o_hi, o_t, o_k, o_lq, o_lqt, o_lqk] = f_zopp(zb_d, zb_scan)
    if not na(o_lq)
        f_zliq(1, zb_d * o_lq, o_lqt, (o_lqk == 0 ? (zb_d > 0 ? "swing high" : "swing low") : o_lqk == 1 ? "single candle" : "breakout candle's " + (zb_d > 0 ? "high" : "low")) + " liquidity (opposite)")
    if not na(o_lo)
        array.set(dg_z, 1, array.get(dg_z, 1) + 1)
        f_zset(1, zb_d > 0 ? o_lo : -o_hi, zb_d > 0 ? o_hi : -o_lo, o_t, -zb_d, (zb_d > 0 ? "SELL · opposite · " : "BUY · opposite · ") + f_kn(o_k, zb_d < 0))

// after the break: the liquidity (the deepest single candle liquidity or swing low since the breaking candle),
// and the POI = the alive level of the leg closest below it
if x2_new and zg_d != 0
    int nq = array.size(q2t)
    int kb = nq - 1
    while kb > 0 and array.get(q2t, kb) > zg_bt
        kb -= 1
    if array.get(q2t, kb) == zg_bt and kb < nq - 1
        float lq  = na
        int   lqt = na
        int   lqk = 0
        for j = kb + 1 to nq - 1
            float lj  = f_zl(j, zg_d)
            bool  one = f_zc(j, zg_d) > f_zo(j, zg_d)
            bool  swg = j < nq - 1 and lj < f_zl(j - 1, zg_d) and lj < f_zl(j + 1, zg_d)
            if (one or swg) and (na(lq) or lj < lq)
                lq  := lj
                lqt := array.get(q2t, j)
                lqk := swg ? 0 : 1
        if not na(lq)
            float lqr = zg_d * lq
            if lqr != zg_lq or lqt != zg_lqt
                zg_lq  := lqr
                zg_lqt := lqt
                f_zliq(0, lqr, lqt, (lqk == 0 ? (zg_d > 0 ? "swing low" : "swing high") : "single candle") + " liquidity")
            int   best = -1
            float bh   = na
            int   nv = array.size(zv_lo)
            if nv > 0
                for i = 0 to nv - 1
                    if array.get(zv_ok, i)
                        float mh = zg_d > 0 ? array.get(zv_hi, i) : -array.get(zv_lo, i)
                        if mh < lq and (na(bh) or mh > bh)
                            best := i
                            bh   := mh
            if best != zg_pi
                // the POI moves: the one it replaces (still alive) goes
                if zg_pi >= 0
                    box ob = array.get(zn_bx, 0)
                    if not na(ob)
                        box.delete(ob)
                    array.set(zn_bx, 0, box(na))
                    array.set(zn_ok, 0, false)
                zg_pi := best
                if best >= 0
                    array.set(dg_z, 0, array.get(dg_z, 0) + 1)
                    for y = 0 to NS - 1
                        array.set(z_use, y, false)
                    f_zset(0, array.get(zv_lo, best), array.get(zv_hi, best), array.get(zv_t, best), zg_d, (zg_d > 0 ? "BUY POI · " : "SELL POI · ") + f_kn(array.get(zv_k, best), zg_d > 0))

// the alive zones and the liquidity lines run on through this candle
for z = 0 to 1
    box b = array.get(zn_bx, z)
    if array.get(zn_ok, z) and not na(b)
        box.set_right(b, time_close)
    line ll = array.get(zn_ll, z)
    if not na(ll)
        line.set_x2(ll, time_close)

// ── Confirmations ────────────────────────────────────────────────────────────
// The confirmation on its own timeframe's candles: the last COMPLETED one ([1] + lookahead_on) when the chart
// is that timeframe or lower; every candle inside the chart candle (request.security_lower_tf) when higher. p: 0 CISD · 1 OCTGD · 2 Engulfing · 3 PCL. For each side: signal, retest
// level, the pattern's low (sells: high) for the SL, the wick that reached the zone.
f_zconf(simple int p, simple int ow, simple int cw, simple bool eg_open, simple bool lag) =>
    bool  pbull = close[1] > open[1]
    bool  pbear = close[1] < open[1]
    bool  cbull = close > open
    bool  cbear = close < open
    float bs  = na
    float bl  = na
    float bsl = na
    float btp = na
    float ss  = na
    float sl_ = na
    float ssl = na
    float stp = na
    var float boc_lv = na
    var float boc_tp = na
    var float boc_mn = na
    var int   boc_b  = na
    var float soc_lv = na
    var float soc_tp = na
    var float soc_mx = na
    var int   soc_b  = na
    var float dn_open = na
    var float dn_low  = na
    var float bci_ln  = na
    var float bci_lo  = na
    var int   bci_b   = na
    var float up_open = na
    var float up_high = na
    var float sci_ln  = na
    var float sci_hi  = na
    var int   sci_b   = na
    if p == 3
        // PCL: C1 bearish, C2 bullish; C2's wick goes below C1's low and its body closes back above it
        if pbear and cbull and low < low[1] and close > low[1]
            bs  := 1.0
            bl  := open
            bsl := low
            btp := low
        if pbull and cbear and high > high[1] and close < high[1]
            ss  := 1.0
            sl_ := open
            ssl := high
            stp := high
    else if p == 2
        // Engulfing: C1 bearish, C2 bullish, opens at or below C1's close and closes above C1's open
        if pbear and cbull and open <= close[1] and close > open[1]
            bs  := 1.0
            bl  := eg_open ? open[1] : close[1]
            bsl := math.min(low, low[1])
            btp := bsl
        if pbull and cbear and open >= close[1] and close < open[1]
            ss  := 1.0
            sl_ := eg_open ? open[1] : close[1]
            ssl := math.max(high, high[1])
            stp := ssl
    else if p == 1
        // OCTGD: the latest bearish OC (C1 close = C2 open); a bullish close above its level within ow candles
        if not na(boc_lv)
            boc_mn := math.min(boc_mn, low)
            if bar_index - boc_b > ow
                boc_lv := na
            else if cbull and close > boc_lv
                bs  := 1.0
                bl  := boc_lv
                bsl := boc_mn
                btp := boc_tp
                boc_lv := na
        if not na(soc_lv)
            soc_mx := math.max(soc_mx, high)
            if bar_index - soc_b > ow
                soc_lv := na
            else if cbear and close < soc_lv
                ss  := 1.0
                sl_ := soc_lv
                ssl := soc_mx
                stp := soc_tp
                soc_lv := na
        if pbear and cbear
            boc_lv := close[1]
            boc_tp := math.min(low, low[1])
            boc_mn := boc_tp
            boc_b  := bar_index
        if pbull and cbull
            soc_lv := close[1]
            soc_tp := math.max(high, high[1])
            soc_mx := soc_tp
            soc_b  := bar_index
    else
        // CISD: the open of the first candle of the bearish run that made the lowest low; a bullish body close above it
        if not na(bci_ln)
            if low < bci_lo
                bci_lo := low
                bci_b  := bar_index
            if bar_index - bci_b > cw
                bci_ln := na
            else if cbull and close > bci_ln
                bs  := 1.0
                bl  := bci_ln
                bsl := bci_lo
                btp := bci_lo
                bci_ln := na
        if not na(sci_ln)
            if high > sci_hi
                sci_hi := high
                sci_b  := bar_index
            if bar_index - sci_b > cw
                sci_ln := na
            else if cbear and close < sci_ln
                ss  := 1.0
                sl_ := sci_ln
                ssl := sci_hi
                stp := sci_hi
                sci_ln := na
        if cbear
            if not pbear or na(dn_low)
                dn_open := open
                dn_low  := low
            else
                dn_low  := math.min(dn_low, low)
            if na(bs) and (na(bci_ln) or dn_low <= bci_lo)
                bci_ln := dn_open
                bci_lo := dn_low
                bci_b  := bar_index
        if cbull
            if not pbull or na(up_high)
                up_open := open
                up_high := high
            else
                up_high := math.max(up_high, high)
            if na(ss) and (na(sci_ln) or up_high >= sci_hi)
                sci_ln := up_open
                sci_hi := up_high
                sci_b  := bar_index
    int   o_t   = lag ? time[1] : time
    float o_c   = lag ? close[1] : close
    float o_h   = lag ? high[1] : high
    float o_l   = lag ? low[1] : low
    float o_bs  = lag ? bs[1] : bs
    float o_bl  = lag ? bl[1] : bl
    float o_bsl = lag ? bsl[1] : bsl
    float o_btp = lag ? btp[1] : btp
    float o_ss  = lag ? ss[1] : ss
    float o_sl  = lag ? sl_[1] : sl_
    float o_ssl = lag ? ssl[1] : ssl
    float o_stp = lag ? stp[1] : stp
    [o_t, o_c, o_h, o_l, o_bs, o_bl, o_bsl, o_btp, o_ss, o_sl, o_ssl, o_stp]
f_x(array<float> x, float bs, float bl, float bsl, float btp, float ss, float sl_, float ssl, float stp) =>
    array.set(x, 0, bs)
    array.set(x, 1, bl)
    array.set(x, 2, bsl)
    array.set(x, 3, btp)
    array.set(x, 4, ss)
    array.set(x, 5, sl_)
    array.set(x, 6, ssl)
    array.set(x, 7, stp)

// a confirmation of pattern p closed (candle time t, close c): its wick inside an alive zone of its side
// (up to one H4 candle size past the far edge) opens a trade on both entries of that pattern
// checks for the table: confirmations seen, with a zone of their side alive, inside it (per pattern)
var array<int> dg_sig  = array.new<int>(5, 0)
var array<int> dg_live = array.new<int>(5, 0)
var array<int> dg_in   = array.new<int>(5, 0)
f_try(int p, int t, float c, array<float> x) =>
    if t >= zb_from and t <= zb_to
        for side = 0 to 1
            if not na(array.get(x, side * 4))
                int   dir = side == 0 ? 1 : -1
                float lvl = array.get(x, side * 4 + 1)
                float ext = array.get(x, side * 4 + 2)
                float tch = array.get(x, side * 4 + 3)
                int   z   = -1
                bool  lv_ = false
                array.set(dg_sig, p, array.get(dg_sig, p) + 1)
                for zz = 0 to 1
                    bool sok = zz == 0 ? zb_side != "The opposite zone only" : zb_side != "The POI in the leg only"
                    if sok and array.get(zn_ok, zz) and array.get(zn_dir, zz) == dir
                        lv_ := true
                    if z < 0 and sok and array.get(zn_ok, zz) and array.get(zn_dir, zz) == dir and not na(tch)
                        float zl = array.get(zn_lo, zz)
                        float zh = array.get(zn_hi, zz)
                        if dir > 0 ? (tch <= zh and tch >= zl - nz(zb_sz)) : (tch >= zl and tch <= zh + nz(zb_sz))
                            z := zz
                if lv_
                    array.set(dg_live, p, array.get(dg_live, p) + 1)
                if z >= 0
                    array.set(dg_in, p, array.get(dg_in, p) + 1)
                    bool mz_ok = zb_mkz == "Both zones" or (z == 0) == (zb_mkz == "The POI in the leg")
                    bool ms_ok = zb_mks == "Buys and sells" or (dir > 0) == (zb_mks == "Buys")
                    if zb_mk and (ZB_MP < 0 or p == ZB_MP) and mz_ok and ms_ok
                        array.push(zm_b, label.new(t, tch, "", xloc = xloc.bar_time, style = dir > 0 ? label.style_triangleup : label.style_triangledown,
                             color = color.new(dir > 0 ? zb_bc : zb_scc, 0), size = size.tiny,
                             tooltip = array.get(ZP, p) + (dir > 0 ? " BUY" : " SELL") + " at the " + (z == 0 ? "POI in the leg" : "opposite zone")
                             + "\n" + str.format_time(t, "dd MMM yyyy HH:mm", syminfo.timezone)
                             + "\nwick " + str.tostring(tch, format.mintick) + " · close " + str.tostring(c, format.mintick)
                             + "\nretest level " + str.tostring(lvl, format.mintick) + " · SL " + str.tostring(ext, format.mintick)))
                        while array.size(zm_b) > zb_km
                            label.delete(array.shift(zm_b))
                if z >= 0 and not na(ext)
                    for e = 0 to 1
                        int y = p * 2 + e
                        int q = y * 2 + side
                        if array.get(y_st, q) == 0 and not array.get(z_use, z * NS + y)
                            float en = e == 0 ? c : lvl
                            float sl = ext - dir * zb_slb * syminfo.mintick
                            float rk = na(en) ? na : dir * (en - sl)
                            if not na(rk) and rk > 0
                                float tp = en + dir * zb_rr * rk
                                array.set(z_use, z * NS + y, true)
                                array.set(y_st, q, e == 0 ? 2 : 1)
                                array.set(y_en, q, en)
                                array.set(y_sl, q, sl)
                                array.set(y_tp, q, tp)
                                array.set(y_src, q, z)
                                if y == SHOWN
                                    string nm = (dir > 0 ? "BUY" : "SELL") + " · " + array.get(ZP, p) + (e == 0 ? "" : " retest") + (z == 0 ? " · leg POI" : " · opposite zone")
                                    if zb_sht
                                        color cc = dir > 0 ? zb_bc : zb_scc
                                        array.set(d_ln, side * 3, line.new(t, en, t, en, xloc = xloc.bar_time, color = cc, width = 2, style = e == 0 ? line.style_solid : line.style_dashed))
                                        array.set(d_ln, side * 3 + 1, line.new(t, sl, t, sl, xloc = xloc.bar_time, color = color.new(zb_scc, 30), width = 1))
                                        array.set(d_ln, side * 3 + 2, line.new(t, tp, t, tp, xloc = xloc.bar_time, color = color.new(zb_bc, 30), width = 1))
                                        array.set(d_lb, side, label.new(t, ext, nm + (e == 0 ? "" : " · waiting"), xloc = xloc.bar_time, style = dir > 0 ? label.style_label_up : label.style_label_down,
                                             color = color.new(cc, 20), textcolor = color.white, size = size.tiny))
                                    if zb_alr and barstate.isrealtime
                                        alert(nm + " " + syminfo.ticker + " · entry " + str.tostring(en, format.mintick) + " · SL " + str.tostring(sl, format.mintick) + " · TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar)

// manage setups y0..y1 on one candle (time t): a waiting retest fills when price comes back to it; SL first
// when both are touched in one candle; TP is not taken on the candle that filled the retest
f_mng(int y0, int y1, int t, float h, float l) =>
    for y = y0 to y1
        for side = 0 to 1
            int q  = y * 2 + side
            int st = array.get(y_st, q)
            if st > 0
                int   dir = side == 0 ? 1 : -1
                float en  = array.get(y_en, q)
                float sl  = array.get(y_sl, q)
                float tp  = array.get(y_tp, q)
                bool  fill_now = false
                if st == 1 and (dir > 0 ? l <= en : h >= en)
                    st := 2
                    array.set(y_st, q, 2)
                    fill_now := true
                    if y == SHOWN
                        label lb = array.get(d_lb, side)
                        if not na(lb)
                            label.set_text(lb, str.replace_all(label.get_text(lb), " · waiting", " · filled"))
                bool done = false
                if st == 2
                    bool h_sl = dir > 0 ? l <= sl : h >= sl
                    bool h_tp = not fill_now and (dir > 0 ? h >= tp : l <= tp)
                    if h_sl or h_tp
                        done := true
                        float r = h_sl ? -1.0 : zb_rr
                        array.set(y_st, q, 0)
                        array.set(y_n, y, array.get(y_n, y) + 1)
                        float tot = array.get(y_r, y) + r
                        array.set(y_r, y, tot)
                        if r > 0
                            array.set(y_w, y, array.get(y_w, y) + 1)
                            array.set(y_run, y, 0)
                        else
                            int run = array.get(y_run, y) + 1
                            array.set(y_run, y, run)
                            array.set(y_mrn, y, math.max(array.get(y_mrn, y), run))
                        float pk = math.max(array.get(y_pk, y), tot)
                        array.set(y_pk, y, pk)
                        array.set(y_dd, y, math.max(array.get(y_dd, y), pk - tot))
                        if y == SHOWN
                            int src = array.get(y_src, q)
                            array.set(sh_n, side, array.get(sh_n, side) + 1)
                            array.set(sh_r, side, array.get(sh_r, side) + r)
                            array.set(sh_n, 2 + src, array.get(sh_n, 2 + src) + 1)
                            array.set(sh_r, 2 + src, array.get(sh_r, 2 + src) + r)
                            int mk = year(t) * 12 + month(t) - 1
                            if array.size(mo_k) == 0 or array.last(mo_k) != mk
                                array.push(mo_k, mk)
                                array.push(mo_n, 1)
                                array.push(mo_r, r)
                                if array.size(mo_k) > 120
                                    array.shift(mo_k)
                                    array.shift(mo_n)
                                    array.shift(mo_r)
                            else
                                int lst = array.size(mo_k) - 1
                                array.set(mo_n, lst, array.get(mo_n, lst) + 1)
                                array.set(mo_r, lst, array.get(mo_r, lst) + r)
                            if zb_sht
                                for k = 0 to 2
                                    line ln = array.get(d_ln, side * 3 + k)
                                    if not na(ln)
                                        line.set_x2(ln, t)
                                        array.push(zt_l, ln)
                                    array.set(d_ln, side * 3 + k, line(na))
                                label lb = array.get(d_lb, side)
                                if not na(lb)
                                    label.set_text(lb, str.replace_all(label.get_text(lb), " · filled", "") + (r > 0 ? " · WIN +" + str.tostring(r, "#") + "R" : " · LOSS -1R"))
                                    label.set_color(lb, color.new(r > 0 ? zb_bc : zb_scc, 10))
                                    array.push(zt_b, lb)
                                array.set(d_lb, side, label(na))
                                while array.size(zt_b) > zb_kt
                                    label.delete(array.shift(zt_b))
                                while array.size(zt_l) > zb_kt * 3
                                    line.delete(array.shift(zt_l))
                if not done and y == SHOWN
                    for k = 0 to 2
                        line ln = array.get(d_ln, side * 3 + k)
                        if not na(ln)
                            line.set_x2(ln, t)
f_seen(int k, int t) =>
    if t >= zb_from and t <= zb_to
        if na(array.get(sm_f, k))
            array.set(sm_f, k, t)
        array.set(sm_l, k, t)

// the five confirmations: from the candles inside each chart candle when their timeframe is smaller than the
// chart, else the last closed candle of their timeframe; trades run on those candles / on the chart's
[za0t, za0c, za0h, za0l, za0bs, za0bl, za0bsl, za0btp, za0ss, za0sl, za0ssl, za0stp] = request.security(syminfo.tickerid, ZL0 ? timeframe.period : "5", f_zconf(0, zb_ow, zb_cw, zb_egr == "Open", true), lookahead = barmerge.lookahead_on)
[zi0t, zi0c, zi0h, zi0l, zi0bs, zi0bl, zi0bsl, zi0btp, zi0ss, zi0sl, zi0ssl, zi0stp] = request.security_lower_tf(syminfo.tickerid, ZL0 ? "5" : "12M", f_zconf(0, zb_ow, zb_cw, zb_egr == "Open", false), ignore_invalid_timeframe = true)
[za1t, za1c, za1h, za1l, za1bs, za1bl, za1bsl, za1btp, za1ss, za1sl, za1ssl, za1stp] = request.security(syminfo.tickerid, ZL1 ? timeframe.period : "15", f_zconf(0, zb_ow, zb_cw, zb_egr == "Open", true), lookahead = barmerge.lookahead_on)
[zi1t, zi1c, zi1h, zi1l, zi1bs, zi1bl, zi1bsl, zi1btp, zi1ss, zi1sl, zi1ssl, zi1stp] = request.security_lower_tf(syminfo.tickerid, ZL1 ? "15" : "12M", f_zconf(0, zb_ow, zb_cw, zb_egr == "Open", false), ignore_invalid_timeframe = true)
[za2t, za2c, za2h, za2l, za2bs, za2bl, za2bsl, za2btp, za2ss, za2sl, za2ssl, za2stp] = request.security(syminfo.tickerid, ZL2 ? timeframe.period : "60", f_zconf(1, zb_ow, zb_cw, zb_egr == "Open", true), lookahead = barmerge.lookahead_on)
[zi2t, zi2c, zi2h, zi2l, zi2bs, zi2bl, zi2bsl, zi2btp, zi2ss, zi2sl, zi2ssl, zi2stp] = request.security_lower_tf(syminfo.tickerid, ZL2 ? "60" : "12M", f_zconf(1, zb_ow, zb_cw, zb_egr == "Open", false), ignore_invalid_timeframe = true)
[za3t, za3c, za3h, za3l, za3bs, za3bl, za3bsl, za3btp, za3ss, za3sl, za3ssl, za3stp] = request.security(syminfo.tickerid, ZL2 ? timeframe.period : "60", f_zconf(2, zb_ow, zb_cw, zb_egr == "Open", true), lookahead = barmerge.lookahead_on)
[zi3t, zi3c, zi3h, zi3l, zi3bs, zi3bl, zi3bsl, zi3btp, zi3ss, zi3sl, zi3ssl, zi3stp] = request.security_lower_tf(syminfo.tickerid, ZL2 ? "60" : "12M", f_zconf(2, zb_ow, zb_cw, zb_egr == "Open", false), ignore_invalid_timeframe = true)
[za4t, za4c, za4h, za4l, za4bs, za4bl, za4bsl, za4btp, za4ss, za4sl, za4ssl, za4stp] = request.security(syminfo.tickerid, ZL2 ? timeframe.period : "60", f_zconf(3, zb_ow, zb_cw, zb_egr == "Open", true), lookahead = barmerge.lookahead_on)
[zi4t, zi4c, zi4h, zi4l, zi4bs, zi4bl, zi4bsl, zi4btp, zi4ss, zi4sl, zi4ssl, zi4stp] = request.security_lower_tf(syminfo.tickerid, ZL2 ? "60" : "12M", f_zconf(3, zb_ow, zb_cw, zb_egr == "Open", false), ignore_invalid_timeframe = true)
var array<float> xq = array.new<float>(8, na)
f_zn(array<int> a) =>
    int n = array.size(a)
    barstate.isrealtime and not barstate.isconfirmed and n > 0 ? n - 1 : n
if ZL0
    int n = f_zn(zi0t)
    if n > 0
        for j = 0 to n - 1
            int it = array.get(zi0t, j)
            f_seen(0, it)
            f_mng(0, 1, it, array.get(zi0h, j), array.get(zi0l, j))
            f_x(xq, array.get(zi0bs, j), array.get(zi0bl, j), array.get(zi0bsl, j), array.get(zi0btp, j), array.get(zi0ss, j), array.get(zi0sl, j), array.get(zi0ssl, j), array.get(zi0stp, j))
            f_try(0, it, array.get(zi0c, j), xq)
else
    f_seen(0, time)
    if not na(za0t) and za0t != nz(za0t[1])
        f_x(xq, za0bs, za0bl, za0bsl, za0btp, za0ss, za0sl, za0ssl, za0stp)
        f_try(0, za0t, za0c, xq)
    f_mng(0, 1, time, high, low)
if ZL1
    int n = f_zn(zi1t)
    if n > 0
        for j = 0 to n - 1
            int it = array.get(zi1t, j)
            f_seen(1, it)
            f_mng(2, 3, it, array.get(zi1h, j), array.get(zi1l, j))
            f_x(xq, array.get(zi1bs, j), array.get(zi1bl, j), array.get(zi1bsl, j), array.get(zi1btp, j), array.get(zi1ss, j), array.get(zi1sl, j), array.get(zi1ssl, j), array.get(zi1stp, j))
            f_try(1, it, array.get(zi1c, j), xq)
else
    f_seen(1, time)
    if not na(za1t) and za1t != nz(za1t[1])
        f_x(xq, za1bs, za1bl, za1bsl, za1btp, za1ss, za1sl, za1ssl, za1stp)
        f_try(1, za1t, za1c, xq)
    f_mng(2, 3, time, high, low)
if ZL2
    int n = f_zn(zi2t)
    if n > 0
        for j = 0 to n - 1
            int it = array.get(zi2t, j)
            f_seen(2, it)
            f_mng(4, 5, it, array.get(zi2h, j), array.get(zi2l, j))
            f_x(xq, array.get(zi2bs, j), array.get(zi2bl, j), array.get(zi2bsl, j), array.get(zi2btp, j), array.get(zi2ss, j), array.get(zi2sl, j), array.get(zi2ssl, j), array.get(zi2stp, j))
            f_try(2, it, array.get(zi2c, j), xq)
else
    f_seen(2, time)
    if not na(za2t) and za2t != nz(za2t[1])
        f_x(xq, za2bs, za2bl, za2bsl, za2btp, za2ss, za2sl, za2ssl, za2stp)
        f_try(2, za2t, za2c, xq)
    f_mng(4, 5, time, high, low)
if ZL2
    int n = f_zn(zi3t)
    if n > 0
        for j = 0 to n - 1
            int it = array.get(zi3t, j)
            f_seen(3, it)
            f_mng(6, 7, it, array.get(zi3h, j), array.get(zi3l, j))
            f_x(xq, array.get(zi3bs, j), array.get(zi3bl, j), array.get(zi3bsl, j), array.get(zi3btp, j), array.get(zi3ss, j), array.get(zi3sl, j), array.get(zi3ssl, j), array.get(zi3stp, j))
            f_try(3, it, array.get(zi3c, j), xq)
else
    f_seen(3, time)
    if not na(za3t) and za3t != nz(za3t[1])
        f_x(xq, za3bs, za3bl, za3bsl, za3btp, za3ss, za3sl, za3ssl, za3stp)
        f_try(3, za3t, za3c, xq)
    f_mng(6, 7, time, high, low)
if ZL2
    int n = f_zn(zi4t)
    if n > 0
        for j = 0 to n - 1
            int it = array.get(zi4t, j)
            f_seen(4, it)
            f_mng(8, 9, it, array.get(zi4h, j), array.get(zi4l, j))
            f_x(xq, array.get(zi4bs, j), array.get(zi4bl, j), array.get(zi4bsl, j), array.get(zi4btp, j), array.get(zi4ss, j), array.get(zi4sl, j), array.get(zi4ssl, j), array.get(zi4stp, j))
            f_try(4, it, array.get(zi4c, j), xq)
else
    f_seen(4, time)
    if not na(za4t) and za4t != nz(za4t[1])
        f_x(xq, za4bs, za4bl, za4bsl, za4btp, za4ss, za4sl, za4ssl, za4stp)
        f_try(4, za4t, za4c, xq)
    f_mng(8, 9, time, high, low)

// ── Results ──────────────────────────────────────────────────────────────────
var table zb_tb = table.new(f_tpos(zb_tbp), 9, 32, bgcolor = color.new(#0F1120, 8), border_width = 1, border_color = color.new(color.gray, 75))
f_zr(float x) =>
    (x >= 0 ? "+" : "") + str.tostring(x, "#.#") + "R"
f_zcell(int col, int row, string s, color c, color bg) =>
    table.cell(zb_tb, col, row, s, text_color = c, text_size = size.small, text_halign = text.align_left, bgcolor = bg)
if barstate.islast and zb_tbo
    table.clear(zb_tb, 0, 0, 8, 31)
    color wc = color.white
    color gc = color.gray
    color nb = color.new(color.black, 100)
    color hb = color.new(#FFB300, 75)
    f_zcell(0, 0, "ZONES BACKTEST", wc, nb)
    f_zcell(1, 0, "TP 1:" + str.tostring(zb_rr, "#"), wc, nb)
    f_zcell(2, 0, "from " + str.format_time(zb_from, "dd MMM yyyy", syminfo.timezone), wc, nb)
    f_zcell(3, 0, zb_side, wc, nb)
    f_zcell(4, 0, str.tostring(zb_na) + " alerts", wc, nb)
    f_zcell(5, 0, "POIs: " + str.tostring(array.get(dg_z, 0)) + " leg / " + str.tostring(array.get(dg_z, 1)) + " opposite", wc, nb)
    int r = 1
    if not chart_ok
        f_zcell(0, r, "Put the chart on H4 or lower", zb_scc, nb)
        r += 1
    f_zcell(0, r, "Confirmation", gc, nb)
    f_zcell(1, r, "Entry", gc, nb)
    f_zcell(2, r, "Data from", gc, nb)
    f_zcell(3, r, "Trades  (checks: found / zone alive / in zone)", gc, nb)
    f_zcell(4, r, "Win rate", gc, nb)
    f_zcell(5, r, "Net", gc, nb)
    f_zcell(6, r, "A month", gc, nb)
    f_zcell(7, r, "Worst DD · losses in a row", gc, nb)
    r += 1
    for y = 0 to NS - 1
        int   p   = math.floor(y / 2)
        int   sm  = p
        int   f0  = array.get(sm_f, sm)
        int   l0  = array.get(sm_l, sm)
        float mos = na(f0) or na(l0) ? na : (l0 - f0) / (30.4375 * 86400000.0)
        int   n   = array.get(y_n, y)
        float tot = array.get(y_r, y)
        if (ZB_PI >= 0 and p != ZB_PI) or (ZB_EI >= 0 and y % 2 != ZB_EI)
            continue
        color bg  = y == SHOWN ? hb : nb
        f_zcell(0, r, array.get(ZP, p), wc, bg)
        f_zcell(1, r, y % 2 == 0 ? "Instant" : "Retest", wc, bg)
        f_zcell(2, r, na(f0) ? "no candles" : str.format_time(f0, "MMM yyyy", syminfo.timezone), wc, bg)
        f_zcell(3, r, str.tostring(n) + (y % 2 == 1 and array.get(y_cx, y) > 0 ? " (" + str.tostring(array.get(y_cx, y)) + " not filled)" : "") + "  (" + str.tostring(array.get(dg_sig, p)) + " / " + str.tostring(array.get(dg_live, p)) + " / " + str.tostring(array.get(dg_in, p)) + ")", wc, bg)
        f_zcell(4, r, n > 0 ? str.tostring(100.0 * array.get(y_w, y) / n, "#") + "%" : "–", wc, bg)
        f_zcell(5, r, f_zr(tot) + " · " + (tot >= 0 ? "+" : "") + str.tostring(tot * zb_risk, "#.#") + "%", tot > 0 ? zb_bc : tot < 0 ? zb_scc : wc, bg)
        f_zcell(6, r, na(mos) or mos <= 0 ? "–" : str.tostring(n / mos, "#.#") + " trades · " + f_zr(tot / mos), wc, bg)
        f_zcell(7, r, "-" + str.tostring(array.get(y_dd, y), "#.#") + "R · " + str.tostring(array.get(y_mrn, y)) + "L", wc, bg)
        r += 1
    f_zcell(0, r, "Break-even win rate " + str.tostring(100.0 / (1 + zb_rr), "#") + "%", gc, nb)
    if SHOWN < 0
        f_zcell(1, r, "Drawn: none (pick one confirmation and one entry to see its trades on the chart)", gc, nb)
        r += 1
    else
        f_zcell(1, r, "Drawn:", gc, nb)
        f_zcell(2, r, array.get(ZP, math.floor(SHOWN / 2)) + " " + zb_ent, wc, hb)
        f_zcell(3, r, "buys " + str.tostring(array.get(sh_n, 0)) + " (" + f_zr(array.get(sh_r, 0)) + ")", wc, nb)
        f_zcell(4, r, "sells " + str.tostring(array.get(sh_n, 1)) + " (" + f_zr(array.get(sh_r, 1)) + ")", wc, nb)
        f_zcell(5, r, "leg POI " + str.tostring(array.get(sh_n, 2)) + " (" + f_zr(array.get(sh_r, 2)) + ")", wc, nb)
        f_zcell(6, r, "opposite " + str.tostring(array.get(sh_n, 3)) + " (" + f_zr(array.get(sh_r, 3)) + ")", wc, nb)
        r += 1
    if zb_mon and SHOWN >= 0 and array.size(mo_k) > 0
        int nm = array.size(mo_k)
        for i = nm - 1 to math.max(0, nm - 12)
            int   mk = array.get(mo_k, i)
            int   yy = math.floor(mk / 12)
            int   mm = mk - yy * 12 + 1
            float mr = array.get(mo_r, i)
            f_zcell(0, r, str.format_time(timestamp(yy, mm, 1, 0, 0), "MMM yyyy", syminfo.timezone), gc, nb)
            f_zcell(1, r, str.tostring(array.get(mo_n, i)) + " trades", wc, nb)
            f_zcell(2, r, f_zr(mr), mr > 0 ? zb_bc : mr < 0 ? zb_scc : wc, nb)
            r += 1
