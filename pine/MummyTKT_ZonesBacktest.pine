color  tb_tx    = input.color(color.white, "text", group = G_ST, inline = "tc")

bool   x_on     = input.bool(true, "External high / low", group = G_T1, inline = "x")
color  x_col    = input.color(#E0E0E0, "", group = G_T1, inline = "x")
