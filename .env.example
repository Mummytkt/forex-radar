# Twelve Data API key — get a free key at https://twelvedata.com
TWELVE_DATA_API_KEY=your_key_here

# Telegram bot token — create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram chat ID — use @userinfobot to find it
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Optional settings (defaults shown) ---

# Path to the SQLite database file
DB_PATH=forex_radar.db

# Number of Daily candles to fetch on startup backfill
POLL_LOOKBACK_DAILY=200

# Number of H4 candles to fetch on startup backfill
POLL_LOOKBACK_H4=500

# Pip tolerance for retest zone detection (in pips)
LEVEL_TOLERANCE_PIPS=5.0

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Set to false to suppress Telegram delivery (alerts logged to console instead)
TELEGRAM_ENABLED=true

# Override the default instrument list (comma-separated, e.g. EUR/USD,GBP/USD)
# Leave blank to use the built-in default list of all forex pairs
# INSTRUMENTS=EUR/USD,GBP/USD,XAU/USD
